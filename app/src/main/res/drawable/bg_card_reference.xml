<?xml version="1.0" encoding="utf-8"?>
<!-- Professional Card - White background with subtle shadow, matching reference UI -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow Layer -->
    <item
        android:left="0dp"
        android:top="1dp"
        android:right="0dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/shadow_light" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    
    <!-- Card Surface -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/surface_border" />
        </shape>
    </item>
</layer-list>
