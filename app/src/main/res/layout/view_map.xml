<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_variant">

    <!-- REAL GOOGLE MAPS VIEW CONTAINER -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/map_filter_chip_scroll"
        android:layout_above="@id/map_bottom_sheet" />

    <!-- TOP MAP SEARCH OVERLAY BAR -->
    <LinearLayout
        android:id="@+id/map_top_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_premium"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Search Icon"
            android:src="@drawable/ic_search"
            app:tint="@color/text_secondary" />

        <EditText
            android:id="@+id/input_map_search"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search Blood Bank or City..."
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_map_debug_toggle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_card_premium"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="⚙️ Debug"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_map_layers_toggle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_card_premium"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="🗺️ Layers"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- HORIZONTAL RADIUS & BLOOD GROUP FILTER CHIP BAR -->
    <HorizontalScrollView
        android:id="@+id/map_filter_chip_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/map_top_search_bar"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:clipToPadding="false"
        android:elevation="8dp"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Radius Filter Chips -->
            <TextView
                android:id="@+id/chip_radius_5km"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="📍 5 KM"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_radius_1km"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_premium"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="1 KM"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chip_radius_10km"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_premium"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="10 KM"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chip_radius_15km"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_premium"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="15 KM"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chip_radius_20km"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_premium"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="20 KM"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chip_radius_30km"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_premium"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="30 KM"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chip_radius_50km"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_premium"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="50 KM"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="6dp"
                android:background="@color/text_tertiary" />

            <!-- Blood Group Filter Chips -->
            <TextView
                android:id="@+id/chip_group_all"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="🩸 All Groups"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_group_o_pos"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_premium"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="O+"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chip_group_o_neg"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_premium"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="O-"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chip_group_a_pos"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_premium"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="A+"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chip_group_b_pos"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_premium"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="B+"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chip_group_ab_pos"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_premium"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="AB+"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chip_group_a_neg"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_premium"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="A-"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chip_group_b_neg"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_premium"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="B-"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chip_group_ab_neg"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_premium"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="AB-"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chip_group_bombay"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_premium"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Bombay (Oh)"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- TEMPORARY MOBILE FIRESTORE DEBUG VERIFICATION CARD -->
    <LinearLayout
        android:id="@+id/layout_firestore_debug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/map_filter_chip_scroll"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:background="#ED101824"
        android:elevation="9dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txt_firestore_debug_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Firestore Status: Connecting..."
            android:textColor="#FFC107"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_firestore_debug_loaded_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Blood Banks Loaded: 0"
            android:textColor="#E0E0E0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_firestore_debug_sample_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="Reading Firestore bloodBanks collection..."
            android:textColor="#B0BEC5"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- MAP CONFIGURATION / NOTICE BANNER -->
    <LinearLayout
        android:id="@+id/map_notice_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/map_filter_chip_scroll"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_chip_status_pending"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Info"
            android:src="@drawable/ic_location"
            app:tint="@color/status_pending_text" />

        <TextView
            android:id="@+id/txt_map_notice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="SmartBlood locator active. Displaying nearby blood bank stock."
            android:textColor="@color/status_pending_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_notice_action"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Turn On Location 📍"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- LOCATION PERMISSION PROMPT OVERLAY -->
    <LinearLayout
        android:id="@+id/map_permission_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_card_premium"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Location Pin"
            android:src="@drawable/ic_location"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/txt_permission_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Enable Location Access"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_permission_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Location permission is required to find nearby blood banks and display your real-time position."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_allow_location_access"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:text="Allow Location Access 📍"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_open_app_settings"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_outlined"
            android:gravity="center"
            android:text="Open App Settings ⚙️"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- FLOATING ACTION BUTTONS ON MAP -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/map_bottom_sheet"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_map_emergency"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="🚨 Emergency Request"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/map_bottom_sheet"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_map_find_nearest"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_card_premium"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="📍 Find Nearest"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/btn_map_my_location"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_card_premium"
            android:gravity="center">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="My Location"
                android:src="@drawable/ic_location"
                app:tint="@color/primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- INTERACTIVE BOTTOM SHEET DETAIL PREVIEW OVERLAY -->
    <LinearLayout
        android:id="@+id/map_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_card_premium"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="16dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_chip_status_pending" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txt_selected_bank_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="City Central Blood Bank"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/icon_selected_bank_verified"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="Verified"
                        android:src="@drawable/ic_verified"
                        app:tint="@color/status_verified_text" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txt_selected_bank_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="✓ Verified Supplier  -  2.8 km away (~7 min)  -  Metro City"
                    android:textColor="@color/status_verified_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_selected_bank_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_chip_status_available"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="OPEN 24/7"
                android:textColor="@color/status_available_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:id="@+id/txt_selected_bank_stock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Available Reserve: O+: 12 units  -  B+: 8 units  -  O-: 3 units"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_map_call_bank"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_outlined"
                android:gravity="center"
                android:text="📞 Call"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_map_reserve_stock"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.2"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:text="🩸 Reserve"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_map_navigate"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1.2"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:text="Navigate 🧭"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>
