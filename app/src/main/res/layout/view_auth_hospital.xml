<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1D">

    <!-- Ambient Dual-Color Radial Glow Layer (Hospital Theme: Blue/Cyan Primary) -->
    <View
        android:id="@+id/bg_glow_hospital_blue"
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="-30dp"
        android:background="@drawable/bg_radial_glow_hospital_blue" />

    <View
        android:id="@+id/bg_glow_hospital_crimson"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="-60dp"
        android:layout_marginBottom="-60dp"
        android:background="@drawable/bg_radial_glow_crimson" />

    <!-- Abstract Healthcare Tech Background Overlays -->
    <ImageView
        android:id="@+id/bg_wave_hospital"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.40"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_abstract_waves" />

    <ImageView
        android:id="@+id/bg_arcs_hospital"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.35"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_abstract_arcs" />

    <ImageView
        android:id="@+id/bg_dots_hospital"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.30"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_dot_pattern" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

        <!-- Top Navigation Bar with Back Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btn_hospital_login_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="6dp"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="HEALTHCARE PORTAL"
                android:textColor="@color/accent_teal"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Hospital Hero Section -->
        <LinearLayout
            android:id="@+id/hero_hospital_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp">

                <View
                    android:id="@+id/glow_hospital_pulse"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_chip_status_available" />

                <ImageView
                    android:id="@+id/icon_hospital_hero"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:contentDescription="Hospital Icon"
                    android:src="@drawable/ic_hospital"
                    app:tint="@color/accent_teal" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Hospital Login"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Emergency Care Starts Here"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Hospital Login Form Card -->
        <LinearLayout
            android:id="@+id/card_hospital_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_premium"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Error Display Container -->
            <TextView
                android:id="@+id/hospital_login_error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_emergency"
                android:padding="10dp"
                android:textColor="@color/status_critical_text"
                android:textSize="13sp"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Official Hospital Email"
                app:startIconDrawable="@drawable/ic_hospital">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_hospital_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Password"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/ic_security">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_hospital_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Remember Me & Forgot Password -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <CheckBox
                    android:id="@+id/chk_hospital_remember"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Remember Me"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_hospital_forgot_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="6dp"
                    android:text="Forgot Password?"
                    android:textColor="@color/accent_teal"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Submit Button -->
            <TextView
                android:id="@+id/btn_hospital_login_submit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:text="Sign In to Hospital Dashboard 🏥"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Register Link Footer -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New healthcare center? "
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_hospital_register_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Register Hospital"
                android:textColor="@color/accent_teal"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
</FrameLayout>
