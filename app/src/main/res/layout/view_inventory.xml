<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1222">

    <!-- High-Visibility Radial Glow Layer -->
    <View
        android:id="@+id/bg_glow_bank_dash_purple"
        android:layout_width="420dp"
        android:layout_height="420dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="-50dp"
        android:layout_marginEnd="-50dp"
        android:background="@drawable/bg_radial_glow_bloodbank_purple" />

    <!-- Laboratory Vector Overlay -->
    <ImageView
        android:id="@+id/bg_nodes_bank_dash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.75"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_bloodbank_nodes" />

    <ImageView
        android:id="@+id/bg_dots_bank_dash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.60"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_dot_pattern" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Search Icon"
                android:src="@drawable/ic_search"
                app:tint="@color/text_secondary" />

            <EditText
                android:id="@+id/input_search_inventory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search Blood Bank, City, or Group..."
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btn_inventory_filter"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Filter Options"
                android:src="@drawable/ic_filter"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <!-- Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_filter_all"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_button_primary"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="All Banks"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_filter_available"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_status_available"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="O+ Stock"
                    android:textColor="@color/status_available_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_filter_low"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_status_low"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="O- Emergency"
                    android:textColor="@color/status_low_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_filter_critical"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_status_critical"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="A+ Stock"
                    android:textColor="@color/status_critical_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_filter_expiring"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_status_pending"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="B+ Stock"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_filter_a_neg"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_status_pending"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="A- Stock"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_filter_b_neg"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_status_pending"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="B- Stock"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_filter_ab_pos"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_status_pending"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="AB+ Stock"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_filter_ab_neg"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_status_pending"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="AB- Stock"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_filter_bombay"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chip_status_pending"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Bombay (Oh)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/txt_inventory_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="23 Blood Banks within 50 KM"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/loading_inventory_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <!-- Inventory Cards List -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="96dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Dynamic Container -->
                <LinearLayout
                    android:id="@+id/layout_inventory_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/layout_inventory_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_card_premium"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="28dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No Matching Blood Banks Found"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Try adjusting your search query or selecting another filter."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
