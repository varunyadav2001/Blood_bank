    private void showCreateBloodRequestDialog(String prefillGroup) {
        Dialog dialog = new Dialog(this);
        dialog.setContentView(R.layout.dialog_create_blood_request);
        if (dialog.getWindow() != null) {
            dialog.getWindow().setLayout(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        }

        AutoCompleteTextView actvGroup = dialog.findViewById(R.id.input_request_blood_group);
        EditText inputUnits = dialog.findViewById(R.id.input_request_units);
        AutoCompleteTextView actvComp = dialog.findViewById(R.id.input_request_component);
        AutoCompleteTextView actvUrgency = dialog.findViewById(R.id.input_request_urgency);
        EditText inputPatientRef = dialog.findViewById(R.id.input_request_patient_ref);
        EditText inputNotes = dialog.findViewById(R.id.input_request_notes);
        TextView txtError = dialog.findViewById(R.id.txt_create_request_error);
        View btnSubmit = dialog.findViewById(R.id.btn_submit_blood_request);
        View btnClose = dialog.findViewById(R.id.btn_close_create_request_dialog);

        String[] groups = new String[]{"O+", "O-", "A+", "A-", "B+", "B-", "AB+", "AB-", "Bombay Blood Group (Oh)"};
        if (actvGroup != null) {
            actvGroup.setAdapter(new ArrayAdapter<>(this, android.R.layout.simple_dropdown_item_1line, groups));
            actvGroup.setOnClickListener(v -> actvGroup.showDropDown());

        int lowStockCount = 0;
        for (String g : allGroups) {
            if (groupTotalStock.get(g) <= LOW_STOCK_THRESHOLD) {
                lowStockCount++;
            }
        }
        if (txtStatLowStock != null) {
            txtStatLowStock.setText(String.format(Locale.US, "%d Low Stock", lowStockCount));
        }

        // Real-Time Firestore Snapshot Listener for Hospital Requests
        String currentUid = currentUser != null ? currentUser.getUid() : "HOS-8842";
        try {
            hospitalRequestsListener = FirebaseFirestore.getInstance().collection("bloodRequests")
                .whereEqualTo("hospitalId", currentUid)
                .addSnapshotListener((queryDocumentSnapshots, e) -> {
                    if (e != null) {
                        android.util.Log.e("SmartBlood", "Error listening to hospital requests: " + e.getMessage());
                        return;
                    }

                    liveHospitalRequests.clear();
                    int total = 0;
                    int pending = 0;
                    int accepted = 0;
                    int fulfilled = 0;
                    int emergency = 0;

                    if (queryDocumentSnapshots != null && !queryDocumentSnapshots.isEmpty()) {
                        for (QueryDocumentSnapshot doc : queryDocumentSnapshots) {
                            String reqId = doc.getString("requestId") != null ? doc.getString("requestId") : doc.getId();
                            String hosp = doc.getString("hospitalName") != null ? doc.getString("hospitalName") : hospName;
                            String bGroup = doc.getString("bloodGroup") != null ? doc.getString("bloodGroup") : "O+";
                            String comp = doc.getString("component") != null ? doc.getString("component") : "Packed RBC";
                            Long qtyLong = doc.getLong("quantity");
                            if (qtyLong == null) qtyLong = doc.getLong("requiredUnits");
                            int qty = qtyLong != null ? qtyLong.intValue() : 4;
                            String urgency = doc.getString("urgency") != null ? doc.getString("urgency") : "Normal";
                            String status = doc.getString("status") != null ? doc.getString("status") : "Pending";
                            String createdAt = doc.getString("createdAt") != null ? doc.getString("createdAt") : "Recent";
                            String notes = doc.getString("notes") != null ? doc.getString("notes") : "";

                            BloodRequest req = new BloodRequest(reqId, currentUid, hosp, bGroup, comp, qty, urgency, status, createdAt, notes, userLat, userLng, hospLocation);
                            String assigned = doc.getString("assignedSource");
                            if (assigned != null) req.setAssignedSource(assigned);
                            liveHospitalRequests.add(req);

                            total++;
                            String statusLower = status.toLowerCase(Locale.US);
                            if (statusLower.contains("pending") || statusLower.contains("searching")) {
                                pending++;
                            } else if (statusLower.contains("verif") || statusLower.contains("accept") || statusLower.contains("allocat") || statusLower.contains("dispatch") || statusLower.contains("transit")) {
                                accepted++;
                            } else if (statusLower.contains("fulfil") || statusLower.contains("complet")) {
                                fulfilled++;
                            }

                            String urgencyLower = urgency.toLowerCase(Locale.US);
                            if (urgencyLower.contains("emerg") || urgencyLower.contains("critic")) {
                                emergency++;
                            }
                        }
                    }

                    // Update UI Statistics
                    if (txtStatTotal != null) txtStatTotal.setText(String.valueOf(total));
                    if (txtStatPending != null) txtStatPending.setText(String.valueOf(pending));
                    if (txtStatAccepted != null) txtStatAccepted.setText(String.valueOf(accepted));
                    if (txtStatFulfilled != null) txtStatFulfilled.setText(String.valueOf(fulfilled));
                    if (txtStatEmergency != null) txtStatEmergency.setText(String.valueOf(emergency));

                    // Update Active Lifecycle Card
                    if (!liveHospitalRequests.isEmpty()) {
                        BloodRequest latestReq = liveHospitalRequests.get(0);
                        if (layoutActiveCard != null) layoutActiveCard.setVisibility(View.VISIBLE);
                        if (layoutEmptyRequests != null) layoutEmptyRequests.setVisibility(View.GONE);

                        if (txtActiveReqId != null) txtActiveReqId.setText(latestReq.getRequestId());
                        if (txtActiveDetails != null) {
                        if (txtSubtitle != null) txtSubtitle.setText("✓ Verified Reserve Dashboard • ID: " + currentBankId);
                        if (txtLocation != null) txtLocation.setText("📍 " + address);
                        renderStockData.accept(initStock);
                    }
                });

            // Real-time listener for incoming Blood Requests (Pending and Emergency Counts)
            bloodBankRequestsListener = FirebaseFirestore.getInstance().collection("bloodRequests")
                .addSnapshotListener((snaps, err) -> {
                    if (snaps == null) return;
                    int pendingCount = 0;
                    int emergencyCount = 0;
                    DocumentSnapshot topEmergencyDoc = null;

                    for (DocumentSnapshot doc : snaps.getDocuments()) {
                        String reqStatus = doc.getString("status");
                        String targetId = doc.getString("targetBloodBankId");
                        String bName = doc.getString("bloodBankName");
                        String urgency = doc.getString("urgency");
                        String priority = doc.getString("priority");

                        boolean matchesBank = false;
                        if (targetId != null && (targetId.equalsIgnoreCase(currentBankId) || targetId.equalsIgnoreCase(currentUid))) {
                            matchesBank = true;
                        } else if (bName != null && bName.trim().equalsIgnoreCase(bankName.trim())) {
                            matchesBank = true;
                        } else if (bName != null && bankName != null) {
                            String bLower = bankName.toLowerCase(Locale.US);
                            String nLower = bName.toLowerCase(Locale.US);
                            if ((bLower.contains("msi") && nLower.contains("msi")) ||
                                (bLower.contains("bombay") && nLower.contains("bombay")) ||
                                (bLower.contains("shashwat") && nLower.contains("shashwat")) ||
                                (bLower.contains("civil") && nLower.contains("civil"))) {
                                matchesBank = true;
                            }
                        }

                        if (matchesBank) {
                            String sUpper = reqStatus != null ? reqStatus.toUpperCase(Locale.US) : "PENDING";
                            boolean isPending = sUpper.equals("PENDING") || sUpper.equals("PENDING_VERIFICATION");
                            String nLower = bName.toLowerCase(Locale.US);
                            if ((bLower.contains("msi") && nLower.contains("msi")) ||
                                (bLower.contains("bombay") && nLower.contains("bombay")) ||
                                (bLower.contains("shashwat") && nLower.contains("shashwat")) ||
                                (bLower.contains("civil") && nLower.contains("civil"))) {
                                matchesBank = true;
                            }
                        }

                        if (matchesBank) {
                            String sUpper = reqStatus != null ? reqStatus.toUpperCase(Locale.US) : "PENDING";
                            boolean isPending = sUpper.equals("PENDING") || sUpper.equals("PENDING_VERIFICATION");
                            boolean isEmergency = (urgency != null && (urgency.equalsIgnoreCase("Emergency") || urgency.equalsIgnoreCase("Critical"))) ||
                                                  (priority != null && (priority.equalsIgnoreCase("EMERGENCY") || priority.equalsIgnoreCase("CRITICAL")));
                            boolean isActive = !sUpper.equals("FULFILLED") && !sUpper.contains("REJECT") && !sUpper.contains("CANCEL");

                            if (isPending) {
                                pendingCount++;
                            }
                            if (isEmergency && isActive) {
                                emergencyCount++;
                                if (topEmergencyDoc == null && isPending) {
                                    topEmergencyDoc = doc;
                                }
                            }
                        }
                    }

                    if (txtStatPending != null) txtStatPending.setText(String.valueOf(pendingCount));
                    if (txtStatEmergency != null) txtStatEmergency.setText(String.valueOf(emergencyCount));

                    if (topEmergencyDoc != null && txtAlertCrit != null) {
                        String hName = topEmergencyDoc.getString("hospitalName") != null ? topEmergencyDoc.getString("hospitalName") : "Hospital";
                        String bGrp = topEmergencyDoc.getString("bloodGroup") != null ? topEmergencyDoc.getString("bloodGroup") : "Blood";
                        Long qLong = topEmergencyDoc.getLong("quantity");
                        int q = qLong != null ? qLong.intValue() : 2;
                        txtAlertCrit.setText("🚨 CRITICAL EMERGENCY: " + hName + " requested " + q + "u of " + bGrp + "! Tap to respond.");
                        txtAlertCrit.setOnClickListener(v -> loadView(R.layout.view_requests, this::bindRequestsView));
                    }
                });

            // Real-time listener for Blood Bank pending Donor Appointments
            bloodBankDonorAppointmentsListener = FirebaseFirestore.getInstance().collection("donorAppointments")
                .addSnapshotListener((snapshots, err) -> {
                    if (snapshots == null) return;
                    int pendingDonorApts = 0;
                    for (DocumentSnapshot doc : snapshots.getDocuments()) {
                        String bId = doc.getString("bloodBankId");
                        String bName = doc.getString("bloodBankName");
                        String aptStatus = doc.getString("status");

                        boolean matchesBank = false;
                        if (bId != null && (bId.equalsIgnoreCase(currentBankId) || bId.equalsIgnoreCase(currentUid))) {
                            matchesBank = true;
                        } else if (bName != null && bName.trim().equalsIgnoreCase(bankName.trim())) {
                            matchesBank = true;
                        } else if (bankName != null) {
                            String bLower = bankName.toLowerCase(Locale.US);
                            String nLower = bName != null ? bName.toLowerCase(Locale.US) : "";
                            String idLower = bId != null ? bId.toLowerCase(Locale.US) : "";
                            if (bLower.contains("msi") && (idLower.contains("msi") || nLower.contains("msi"))) matchesBank = true;
                            if (txtTimeline2 != null) {
                                txtTimeline2.setText("✓ Step 2: Blood Bank Allocated • " + assigned);
                                txtTimeline2.setTextColor(ContextCompat.getColor(this, R.color.status_available_text));
                            }
                            if (txtTimeline3 != null) {
                                txtTimeline3.setText("✓ Step 3: Verified Courier Dispatch & Handover (In Transit)");
                                txtTimeline3.setTextColor(ContextCompat.getColor(this, R.color.status_available_text));
                            }
                            if (txtTimeline4 != null) {
                                txtTimeline4.setText("🟡 Step 4: Transfusion Delivery in Progress");
                                txtTimeline4.setTextColor(ContextCompat.getColor(this, R.color.status_low_text));
                            }
                        } else if (statusUpper.contains("FULFIL") || statusUpper.contains("COMPLET")) {
                            if (txtTimeline1 != null) {
                                txtTimeline1.setText("✓ Step 1: Requisition Created & Verified (" + latestReq.getCreatedAt() + ")");
                                txtTimeline1.setTextColor(ContextCompat.getColor(this, R.color.status_available_text));
                            }
                            if (txtTimeline2 != null) {
                                txtTimeline2.setText("✓ Step 2: Blood Bank Allocated • " + assigned);
                                txtTimeline2.setTextColor(ContextCompat.getColor(this, R.color.status_available_text));
                            }
                            if (txtTimeline3 != null) {
                                txtTimeline3.setText("✓ Step 3: Verified Courier Dispatch & Handover Completed");
                                txtTimeline3.setTextColor(ContextCompat.getColor(this, R.color.status_available_text));
                            }
                            if (txtTimeline4 != null) {
                                txtTimeline4.setText("✓ Step 4: Transfusion Delivered & Fulfilled");
                                txtTimeline4.setTextColor(ContextCompat.getColor(this, R.color.status_available_text));
                            }
                        } else if (statusUpper.contains("REJECT")) {
                    TextView txtUnits = new TextView(this);
                    txtUnits.setText(String.format(Locale.US, "%d Units Available across network", units));
                    txtUnits.setTextColor(ContextCompat.getColor(this, R.color.white));
                    txtUnits.setTextSize(14f);
                    txtUnits.setTypeface(null, android.graphics.Typeface.BOLD);
                    LinearLayout.LayoutParams unitsLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                    unitsLp.topMargin = 12;
                    txtUnits.setLayoutParams(unitsLp);
                    itemCard.addView(txtUnits);

                    TextView txtBank = new TextView(this);
                    txtBank.setText("Nearest Source: " + nearest);
                    txtBank.setTextColor(ContextCompat.getColor(this, R.color.text_secondary));
                    txtBank.setTextSize(12f);
                    LinearLayout.LayoutParams bankLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                    bankLp.topMargin = 4;
                    txtBank.setLayoutParams(bankLp);
                    itemCard.addView(txtBank);

                    TextView btnOrder = new TextView(this);
                    btnOrder.setText("+ Create Requisition for " + group);
                    btnOrder.setTextColor(ContextCompat.getColor(this, R.color.white));
                    btnOrder.setTextSize(12f);
                    btnOrder.setTypeface(null, android.graphics.Typeface.BOLD);
                    btnOrder.setGravity(android.view.Gravity.CENTER);
                    btnOrder.setBackgroundResource(R.drawable.bg_button_hospital);
                    LinearLayout.LayoutParams orderLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 84);
                    orderLp.topMargin = 20;
                    btnOrder.setLayoutParams(orderLp);
                    btnOrder.setOnClickListener(v -> {
                        dialog.dismiss();
                        showCreateBloodRequestDialog(group);
                    });
                    itemCard.addView(btnOrder);

                    container.addView(itemCard);
                }
            }
        }

                        if (matchesBank) {
                            String sUpper = status != null ? status.toUpperCase(Locale.US) : "PENDING";
                            if (!sUpper.equals("COMPLETED") && !sUpper.contains("REJECT") && !sUpper.contains("CANCEL")) {
                                activeTransferCount++;
                            }
                        }
                    }

                    if (txtStatActiveTransfers != null) txtStatActiveTransfers.setText(String.valueOf(activeTransferCount));
                });

        } catch (Exception e) {
            if (progress != null) progress.setVisibility(View.GONE);
        }
    }

    private void updateBloodGroupStockCard(TextView txtUnits, TextView txtStatus, int units) {
        if (txtUnits == null || txtStatus == null) return;
        txtUnits.setText(String.format(Locale.US, "%d %s", units, units == 1 ? "Unit" : "Units"));
        if (units == 0) {
            txtStatus.setText("🔴 Out of Stock");
            txtStatus.setBackgroundResource(R.drawable.bg_chip_status_pending);
            txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_critical_text));
        } else if (units <= LOW_STOCK_THRESHOLD) {
            txtStatus.setText("🟡 Low Stock");
            txtStatus.setBackgroundResource(R.drawable.bg_chip_status_low);
            txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_low_text));
        } else {
            txtStatus.setText("🟢 Available");
            txtStatus.setBackgroundResource(R.drawable.bg_chip_status_available);
            txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_available_text));
        }
    }

    private void bindHospitalDashboardV2(View view) {
        View glowCyan = view.findViewById(R.id.bg_glow_hosp_dash_cyan);
        View gridHosp = view.findViewById(R.id.bg_grid_hosp_dash);

        if (glowCyan != null) {
            android.animation.ObjectAnimator pulseCyan = android.animation.ObjectAnimator.ofFloat(glowCyan, "alpha", 0.55f, 0.95f, 0.55f);
            pulseCyan.setDuration(3600);
            pulseCyan.setRepeatCount(android.animation.ValueAnimator.INFINITE);
            pulseCyan.start();
        }
        if (gridHosp != null) {
            android.animation.ObjectAnimator gridAnim = android.animation.ObjectAnimator.ofFloat(gridHosp, "translationY", -10f, 10f, -10f);
            gridAnim.setDuration(8000);
            gridAnim.setRepeatCount(android.animation.ValueAnimator.INFINITE);
            gridAnim.start();
        }

        UserProfile currentUser = repository.getCurrentUser();
        String hospName = currentUser != null && currentUser.getDisplayName() != null ? currentUser.getDisplayName() : "St. Jude General Hospital";
        String hospId = currentUser != null ? currentUser.getUid() : "HOS-8842";
        String hospLocation = currentUser != null && currentUser.getLocationAddress() != null ? currentUser.getLocationAddress() : "Sangli, Maharashtra, India";

        TextView txtName = view.findViewById(R.id.txt_hosp_dash_name);
        TextView txtId = view.findViewById(R.id.txt_hosp_dash_id);
        TextView txtLoc = view.findViewById(R.id.txt_hosp_dash_location);

        if (txtName != null) txtName.setText(hospName);
        if (txtId != null) txtId.setText("✓ Verified Hospital Account • ID: " + hospId);
        if (txtLoc != null) txtLoc.setText("📍 " + hospLocation);

        View btnCreateRequest = view.findViewById(R.id.btn_create_request_v2);
        if (btnCreateRequest != null) {
            btnCreateRequest.setOnClickListener(v -> showCreateBloodRequestDialog(null, "Normal"));
        }

        View btnEmergencyAction = view.findViewById(R.id.btn_hosp_emergency_action);
        if (btnEmergencyAction != null) {
            btnEmergencyAction.setOnClickListener(v -> showCreateBloodRequestDialog(null, "Emergency"));
        }

        View cardEmergencyRequests = view.findViewById(R.id.card_stat_emergency_requests);
        if (cardEmergencyRequests != null) {
            cardEmergencyRequests.setOnClickListener(v -> showCreateBloodRequestDialog(null, "Emergency"));
        }

        View cardLowStock = view.findViewById(R.id.card_stat_low_stock);
        if (cardLowStock != null) {
            cardLowStock.setOnClickListener(v -> showLowStockDetailsDialog());
        }

        TextView txtStatTotal = view.findViewById(R.id.txt_stat_total_requests);
        TextView txtStatPending = view.findViewById(R.id.txt_stat_pending_requests);
        TextView txtStatAccepted = view.findViewById(R.id.txt_stat_accepted_requests);
        TextView txtStatFulfilled = view.findViewById(R.id.txt_stat_fulfilled_requests);
        TextView txtStatLowStock = view.findViewById(R.id.txt_stat_low_stock);
        TextView txtStatEmergency = view.findViewById(R.id.txt_stat_emergency_requests);

        View layoutActiveCard = view.findViewById(R.id.layout_active_request_card);
        View layoutEmptyRequests = view.findViewById(R.id.layout_hosp_empty_requests);
        TextView txtActiveReqId = view.findViewById(R.id.txt_active_req_id);
        TextView txtActiveStatusChip = view.findViewById(R.id.txt_active_req_status_chip);
        TextView txtActiveDetails = view.findViewById(R.id.txt_active_req_details);
        TextView txtActiveTime = view.findViewById(R.id.txt_active_req_hospital_time);
        TextView txtTimeline1 = view.findViewById(R.id.txt_timeline_step1);
