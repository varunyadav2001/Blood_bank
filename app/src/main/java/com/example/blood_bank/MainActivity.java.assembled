        // Helper lambda to render dashboard UI from stock map
        java.util.function.Consumer<Map<String, Integer>> renderStockData = (stockMap) -> {
            if (stockMap == null) return;

            int oPos = getNumericStock(stockMap, "O+");
            int oNeg = getNumericStock(stockMap, "O-");
            int aPos = getNumericStock(stockMap, "A+");
            int aNeg = getNumericStock(stockMap, "A-");
            int bPos = getNumericStock(stockMap, "B+");
            int bNeg = getNumericStock(stockMap, "B-");
            int abPos = getNumericStock(stockMap, "AB+");
            int abNeg = getNumericStock(stockMap, "AB-");
            int bombay = getNumericStock(stockMap, "Bombay");

            // Update Blood Group Stock Cards
            Map<String, Integer>[] liveStockH = (Map<String, Integer>[]) new Map<?, ?>[]{defaultStockForBank(bankName)};
            showSelectBloodBankDialog(idHolder, nameHolder, liveStockH, () -> {
                loadView(R.layout.view_blood_bank_dashboard_v2, this::bindBloodBankDashboardV2);
            });
        };
        if (btnSwitchFac != null) btnSwitchFac.setOnClickListener(switchFacListener);
        if (layoutHeaderInfo != null) layoutHeaderInfo.setOnClickListener(switchFacListener);

        // Operations Stat references & Cards
        TextView txtStatPending = view.findViewById(R.id.txt_bank_stat_pending_requests);
        if (btnSearch != null) {
            btnSearch.setOnClickListener(v -> {
                String group = inputGroup != null ? inputGroup.getText().toString().trim() : "O+";
                String comp = inputComponent != null ? inputComponent.getText().toString().trim() : "RBC";
                String city = inputCity != null ? inputCity.getText().toString().trim() : "Metro City";

                List<InventoryItem> results = repository.searchPublicEmergencyBlood(group, comp, city);
                if (results.isEmpty()) {
                    Toast.makeText(this, "No matching blood stock found nearby in " + city + ". Try searching another location.", Toast.LENGTH_LONG).show();
                } else {
                    Toast.makeText(this, "Found " + results.size() + " blood bank reserve matches for " + group + "!", Toast.LENGTH_SHORT).show();
                }
            });
        }

        if (btnCall != null) btnCall.setOnClickListener(v -> Toast.makeText(this, "Dialing City Central Blood Bank (+1 555-019-2839)...", Toast.LENGTH_SHORT).show());
        if (btnDirections != null) btnDirections.setOnClickListener(v -> Toast.makeText(this, "Opening GPS Directions to City Central Blood Bank...", Toast.LENGTH_SHORT).show());
        if (btnClose != null) btnClose.setOnClickListener(v -> dialog.dismiss());

        dialog.show();
    }

