    private void initSmartBankData() {
        smartMapItemList.clear();

        UserProfile currentUser = repository.getCurrentUser();
        if (currentUser != null && currentUser.getLatitude() != 0.0 && currentUser.getLongitude() != 0.0) {
            userLat = currentUser.getLatitude();
            userLng = currentUser.getLongitude();
        } else if (userLat == 37.7710 || userLat == 0.0) {
            userLat = 16.8524;
            userLng = 74.5815; // Sangli default
        }

        // Emergency Hospital Markers for tracking context
        Map<String, Integer> stockHosp1 = new HashMap<>();
        smartMapItemList.add(new SmartMapItem("HOSP-01", "City General Hospital & Emergency", "HOSPITAL", userLat + 0.012, userLng + 0.008, "+15550293847", "Healthcare Center", true, 0, stockHosp1));

        Map<String, Integer> stockHosp2 = new HashMap<>();
        smartMapItemList.add(new SmartMapItem("HOSP-02", "Apex Trauma Care & Hospital", "HOSPITAL", userLat - 0.015, userLng - 0.010, "+15550384756", "West District", true, 0, stockHosp2));

        // Pre-populate all blood banks with real distances so inventory search is complete immediately
        List<RawBank> rawBanks = getMasterBloodBankList();
        for (RawBank b : rawBanks) {
            Map<String, Integer> stock = defaultStockForBank(b.name);
            SmartMapItem item = new SmartMapItem(b.id, b.name, "BLOOD_BANK", b.lat, b.lng, b.phone, b.city, true, 37, stock);
            item.distanceKm = calculateDistanceInKm(userLat, userLng, b.lat, b.lng);
            smartMapItemList.add(item);
        }

        try {
            // Seed Firestore "bloodBanks" collection if not already seeded
        String canonical = getCanonicalBloodGroup(bloodGroup);
        Integer val = stockMap.get(canonical);
        if (val != null && val > 0) return val;

        // 2. Direct lookup with raw key
        val = stockMap.get(bloodGroup);
        if (val != null && val > 0) return val;

        // 3. Uppercase lookup
        val = stockMap.get(bloodGroup.toUpperCase(Locale.US).trim());
        if (val != null && val > 0) return val;

        // 4. Clean key lookup
        String clean = bloodGroup.toUpperCase(Locale.US).replace(" ", "").replace("_", "").replace("-", "");
        val = stockMap.get(clean);
        if (val != null && val > 0) return val;

        // 5. Match all entries against canonical blood group
        for (Map.Entry<String, Integer> entry : stockMap.entrySet()) {
            if (entry.getKey() != null && entry.getValue() != null && entry.getValue() > 0) {
                if (getCanonicalBloodGroup(entry.getKey()).equalsIgnoreCase(canonical)) {
                    return entry.getValue();
                }
            }
        }

        return 0;
    }

