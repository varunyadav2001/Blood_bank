        EditText inputCity = dialog.findViewById(R.id.reg_bank_city);
        EditText inputPassword = dialog.findViewById(R.id.reg_bank_password);
        EditText inputConfirmPassword = dialog.findViewById(R.id.reg_bank_confirm_password);
        TextView txtError = dialog.findViewById(R.id.reg_bank_error_text);

        View btnUseLocationBank = dialog.findViewById(R.id.btn_reg_bank_use_location);
        TextView txtBankLocationStatus = dialog.findViewById(R.id.txt_reg_bank_location_status);

        View btnSubmit = dialog.findViewById(R.id.btn_submit_reg_bank);
        View btnClose = dialog.findViewById(R.id.btn_close_reg_bank);

        if (btnUseLocationBank != null) {
            btnUseLocationBank.setOnClickListener(v -> {
                if (!isLocationPermissionGranted()) {
                    requestLocationPermission();
                    return;
                }
                if (!isGpsEnabled()) {
                    if (txtBankLocationStatus != null) {
                        txtBankLocationStatus.setText("Location Services are turned off. Please enable location to continue blood bank registration.");
                    }
                    try {
                        startActivity(new Intent(Settings.ACTION_LOCATION_SOURCE_SETTINGS));
                    } catch (Exception ignored) {}
                    return;
                }

                String cityStr = inputCity != null && !inputCity.getText().toString().trim().isEmpty() ? inputCity.getText().toString().trim() : "Sangli";
                showMapLocationPickerDialog(false, cityStr, (lat, lng, address) -> {
                    regBankLat = lat;
                    regBankLng = lng;
                    regBankAddress = address;
                    if (txtBankLocationStatus != null) {
                        txtBankLocationStatus.setText(String.format(java.util.Locale.US, "✓ Blood Bank Location Selected:\n%s (%.4f, %.4f)", regBankAddress, regBankLat, regBankLng));
                    }
                    Toast.makeText(this, "📍 Blood Bank location confirmed!", Toast.LENGTH_SHORT).show();
                });
            });
        }

        if (btnSubmit != null) {
            btnSubmit.setOnClickListener(v -> {
                String name = inputName != null ? inputName.getText().toString().trim() : "";
                String email = inputEmail != null ? inputEmail.getText().toString().trim() : "";
                String phone = inputPhone != null ? inputPhone.getText().toString().trim() : "";
                String city = inputCity != null ? inputCity.getText().toString().trim() : "";
                String password = inputPassword != null ? inputPassword.getText().toString().trim() : "";
                String confirmPassword = inputConfirmPassword != null ? inputConfirmPassword.getText().toString().trim() : "";

                if (TextUtils.isEmpty(name) || TextUtils.isEmpty(email) || TextUtils.isEmpty(password) || TextUtils.isEmpty(confirmPassword)) {
                    showRegError(txtError, "Please complete all required fields (Blood Bank Name, Email, Password, Confirm Password).");
                    return;
                }

                if (!android.util.Patterns.EMAIL_ADDRESS.matcher(email).matches()) {
                    showRegError(txtError, "Please enter a valid reserve email address.");
                    return;
                }

                if (!password.equals(confirmPassword)) {
                    showRegError(txtError, "Password and Confirm Password do not match.");
                    return;
                }

                if (regBankLat == 0.0 || regBankLng == 0.0) {
                    showRegError(txtError, "Please add your blood bank location before completing registration.");
                    return;
                }

                if (txtError != null) txtError.setVisibility(View.GONE);
                btnSubmit.setEnabled(false);

                try {
                    FirebaseAuth.getInstance().createUserWithEmailAndPassword(email, password)
                        .addOnCompleteListener(this, task -> {
                            if (task.isSuccessful()) {
                                FirebaseUser fbUser = FirebaseAuth.getInstance().getCurrentUser();
                                String uid = fbUser != null ? fbUser.getUid() : "USR-BB-" + System.currentTimeMillis();

                                Map<String, Object> userMap = new HashMap<>();
                                userMap.put("name", name);
                                userMap.put("email", email);
                                userMap.put("role", "BLOOD_BANK");
                                userMap.put("phone", phone);
                                userMap.put("city", city);
                                userMap.put("latitude", regBankLat);
                                userMap.put("longitude", regBankLng);
                                userMap.put("locationAddress", regBankAddress);
                                userMap.put("locationUpdatedAt", System.currentTimeMillis());

                                try {
                                    FirebaseFirestore.getInstance().collection("users").document(uid).set(userMap);
                                } catch (Exception ignored) {}

                                repository.registerBloodBankWithUid(uid, name, email, phone, "", city, regBankLat, regBankLng, regBankAddress);
                                try {
                                    FirebaseAuth.getInstance().signOut();
                                } catch (Exception ignored) {}

                                Toast.makeText(this, "Blood Bank Registered Successfully! Please sign in with your credentials.", Toast.LENGTH_LONG).show();
                                dialog.dismiss();
                                loadBloodBankLoginScreen(email);
                            } else {
                                btnSubmit.setEnabled(true);
                                String errMsg = "Registration failed.";
                                if (task.getException() != null && task.getException().getMessage() != null) {
                                    String exc = task.getException().getMessage();
                                    if (exc.contains("already in use") || exc.contains("EMAIL_EXISTS")) {
                                        errMsg = "This email is already registered. Please login instead.";
                                    } else {
                                        errMsg = exc;
                                    }
                                }
                                showRegError(txtError, errMsg);
                            }
                        });
                } catch (Exception e) {
                    btnSubmit.setEnabled(true);
                    showRegError(txtError, "Registration error: " + e.getMessage());
                }
            });
        }

        if (btnClose != null) btnClose.setOnClickListener(v -> dialog.dismiss());
        dialog.show();
    }

    private void showRegError(TextView txtError, String message) {
        if (txtError != null) {
            txtError.setText(message);
            txtError.setVisibility(View.VISIBLE);
        } else {
            Toast.makeText(this, message, Toast.LENGTH_SHORT).show();
        }
    }

    private void showForgotPasswordDialog() {
        Dialog dialog = new Dialog(this);
        dialog.setContentView(R.layout.dialog_forgot_password);
        if (dialog.getWindow() != null) {
            dialog.getWindow().setLayout(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        }

        EditText inputResetEmail = dialog.findViewById(R.id.input_reset_email);
        TextView txtMsg = dialog.findViewById(R.id.reset_status_message);
        View btnSend = dialog.findViewById(R.id.btn_send_reset_link);
        View btnClose = dialog.findViewById(R.id.btn_close_forgot_dialog);

        if (btnSend != null) {
            btnSend.setOnClickListener(v -> {
                String resetEmail = inputResetEmail != null ? inputResetEmail.getText().toString().trim() : "";
                if (TextUtils.isEmpty(resetEmail)) {
                    Toast.makeText(this, "Please enter your registered email.", Toast.LENGTH_SHORT).show();
                    return;
                }
                if (txtMsg != null) {
                    txtMsg.setText("✓ Password reset email sent to " + resetEmail + ". Please check your inbox.");
                    txtMsg.setVisibility(View.VISIBLE);
                }
            });
        }

        if (btnClose != null) btnClose.setOnClickListener(v -> dialog.dismiss());
        dialog.show();
    }
            pulsePurple.setDuration(4000);
            pulsePurple.setRepeatCount(android.animation.ValueAnimator.INFINITE);
            pulsePurple.start();
        }
        if (nodesBank != null) {
            android.animation.ObjectAnimator nodesAnim = android.animation.ObjectAnimator.ofFloat(nodesBank, "translationY", -10f, 10f, -10f);
            nodesAnim.setDuration(7800);
            nodesAnim.setRepeatCount(android.animation.ValueAnimator.INFINITE);
            nodesAnim.start();
            btnSend.setOnClickListener(v -> {
                String resetEmail = inputResetEmail != null ? inputResetEmail.getText().toString().trim() : "";
                if (TextUtils.isEmpty(resetEmail)) {
                    Toast.makeText(this, "Please enter your registered email.", Toast.LENGTH_SHORT).show();
                    return;
                }

                if (txtMsg != null) {
                    txtMsg.setText("Sending password reset email...");
                    txtMsg.setVisibility(View.VISIBLE);
                }

                FirebaseAuth.getInstance().sendPasswordResetEmail(resetEmail)
                    .addOnCompleteListener(t -> {
                        if (t.isSuccessful()) {
                            if (txtMsg != null) {
                                txtMsg.setText("✓ Password reset email sent. Please check your inbox.");
                                txtMsg.setVisibility(View.VISIBLE);
                            }
                            Toast.makeText(this, "Password reset email sent to " + resetEmail, Toast.LENGTH_LONG).show();
                        } else {
                            String err = "Unable to send password reset email.";
                            if (t.getException() != null && t.getException().getMessage() != null) {
                                String exc = t.getException().getMessage().toLowerCase(Locale.US);
                                if (exc.contains("user-not-found") || exc.contains("no user record")) {
                                    err = "No account found with this email.";
                                } else if (exc.contains("invalid-email") || exc.contains("badly formatted")) {
                                    err = "Please enter a valid email address.";
                                }
                            }
                            if (txtMsg != null) {
                                txtMsg.setText("⚠️ " + err);
                                txtMsg.setVisibility(View.VISIBLE);
                            }
                        }
                    });
            });
        }

        if (btnClose != null) btnClose.setOnClickListener(v -> dialog.dismiss());
        dialog.show();
    }

    private void showMobileOTPDialog(String mobileNumber) {
        Dialog dialog = new Dialog(this);
        dialog.setContentView(R.layout.dialog_mobile_otp);
        if (dialog.getWindow() != null) {
            dialog.getWindow().setLayout(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        }

        TextView txtSub = dialog.findViewById(R.id.txt_otp_subtitle);
        if (txtSub != null) txtSub.setText("Enter 4-digit code sent to " + mobileNumber);

        TextView txtCountdown = dialog.findViewById(R.id.txt_otp_countdown);
        if (txtCountdown != null) {
            if (otpTimer != null) otpTimer.cancel();
            otpTimer = new CountDownTimer(60000, 1000) {
                @Override
                public void onTick(long millisUntilFinished) {
                    txtCountdown.setText("⏱ Resend code in " + (millisUntilFinished / 1000) + "s");
                }

                @Override
                public void onFinish() {
                    txtCountdown.setText("⏱ Resend available");
                }
            }.start();
        }

        View btnVerify = dialog.findViewById(R.id.btn_verify_otp_submit);
        View btnClose = dialog.findViewById(R.id.btn_close_otp_dialog);

        if (btnVerify != null) {
            btnVerify.setOnClickListener(v -> {
                Toast.makeText(this, "Security Requirement: Please sign in with your registered email & password.", Toast.LENGTH_LONG).show();
                dialog.dismiss();
            });
        }

        if (btnClose != null) btnClose.setOnClickListener(v -> dialog.dismiss());
        dialog.show();
    }

    private void showPublicEmergencySearchDialog() {
        Dialog dialog = new Dialog(this);
        dialog.setContentView(R.layout.dialog_public_emergency_search);
        if (dialog.getWindow() != null) {
            dialog.getWindow().setLayout(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        }

        EditText inputGroup = dialog.findViewById(R.id.input_public_blood_group);
        EditText inputComponent = dialog.findViewById(R.id.input_public_component);
        EditText inputCity = dialog.findViewById(R.id.input_public_city);
        View btnSearch = dialog.findViewById(R.id.btn_execute_public_search);
        View btnClose = dialog.findViewById(R.id.btn_close_public_search);

        View btnCall = dialog.findViewById(R.id.btn_public_call_1);
        View btnDirections = dialog.findViewById(R.id.btn_public_directions_1);

        if (btnSearch != null) {
            btnSearch.setOnClickListener(v -> {
                String group = inputGroup != null ? inputGroup.getText().toString().trim() : "O+";
                String comp = inputComponent != null ? inputComponent.getText().toString().trim() : "RBC";
                String city = inputCity != null ? inputCity.getText().toString().trim() : "Metro City";

                List<InventoryItem> results = repository.searchPublicEmergencyBlood(group, comp, city);
                if (results.isEmpty()) {
                    Toast.makeText(this, "No matching blood stock found nearby in " + city + ". Try searching another location.", Toast.LENGTH_LONG).show();
                } else {
                    Toast.makeText(this, "Found " + results.size() + " blood bank reserve matches for " + group + "!", Toast.LENGTH_SHORT).show();
                }
            });
        }

        if (btnCall != null) btnCall.setOnClickListener(v -> Toast.makeText(this, "Dialing City Central Blood Bank (+1 555-019-2839)...", Toast.LENGTH_SHORT).show());
        if (btnDirections != null) btnDirections.setOnClickListener(v -> Toast.makeText(this, "Opening GPS Directions to City Central Blood Bank...", Toast.LENGTH_SHORT).show());
        if (btnClose != null) btnClose.setOnClickListener(v -> dialog.dismiss());

        dialog.show();
    }

