            return;
        }

        Dialog picker = new Dialog(this);
        picker.requestWindowFeature(android.view.Window.FEATURE_NO_TITLE);

        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        root.setBackgroundResource(R.drawable.bg_card_hospital);
        root.setPadding(28, 24, 28, 24);

        RelativeLayout header = new RelativeLayout(this);
        header.setLayoutParams(new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));

        TextView txtTitle = new TextView(this);
        txtTitle.setText("🏥 Select Blood Bank");
        txtTitle.setTextColor(ContextCompat.getColor(this, R.color.white));
        txtTitle.setTextSize(16f);
        txtTitle.setTypeface(null, android.graphics.Typeface.BOLD);


            Collections.sort(filteredBanks, (a, b) -> Double.compare(a.distanceKm, b.distanceKm));

            List<String> bankNames = new ArrayList<>();
            for (SmartMapItem b : filteredBanks) {
                bankNames.add(b.name + " (" + String.format(Locale.US, "%.1f km", b.distanceKm) + ")");
            }

            if (dropdownBank != null) {
                ArrayAdapter<String> bankAdapter = new ArrayAdapter<>(this, android.R.layout.simple_dropdown_item_1line, bankNames);
                dropdownBank.setAdapter(bankAdapter);
                dropdownBank.setOnItemClickListener((parent, v, position, id) -> {
                    if (position >= 0 && position < filteredBanks.size()) {
                        selectedBankHolder[0] = filteredBanks.get(position);
                        SmartMapItem sb = selectedBankHolder[0];
                        if (txtSelectedBankName != null) txtSelectedBankName.setText(sb.name);
                        if (txtSelectedBankDist != null) txtSelectedBankDist.setText(String.format(Locale.US, "%.1f KM away", sb.distanceKm));
                        if (txtSelectedBankLoc != null) txtSelectedBankLoc.setText("📍 " + (sb.area != null ? sb.area : "Maharashtra, India"));
                        if (txtSelectedBankContact != null) txtSelectedBankContact.setText("📞 " + (sb.phone != null ? sb.phone : "+91 233 2374501"));
                    }
                });
            }

            if (selectedBankHolder[0] != null) {
                SmartMapItem sb = selectedBankHolder[0];
                double dist = calculateDistanceInKm(userLat, userLng, sb.lat, sb.lng);
                sb.distanceKm = dist;
                if (dropdownBank != null) dropdownBank.setText(sb.name + " (" + String.format(Locale.US, "%.1f km", dist) + ")", false);
                if (txtSelectedBankName != null) txtSelectedBankName.setText(sb.name);
                if (txtSelectedBankDist != null) txtSelectedBankDist.setText(String.format(Locale.US, "%.1f KM away", dist));
                if (txtSelectedBankLoc != null) txtSelectedBankLoc.setText("📍 " + (sb.area != null ? sb.area : "Maharashtra, India"));
                if (txtSelectedBankContact != null) txtSelectedBankContact.setText("📞 " + (sb.phone != null ? sb.phone : "+91 233 2374501"));
            } else if (!filteredBanks.isEmpty()) {
                selectedBankHolder[0] = filteredBanks.get(0);
                SmartMapItem sb = selectedBankHolder[0];
                if (dropdownBank != null) dropdownBank.setText(sb.name + " (" + String.format(Locale.US, "%.1f km", sb.distanceKm) + ")", false);
                if (txtSelectedBankName != null) txtSelectedBankName.setText(sb.name);
                if (txtSelectedBankDist != null) txtSelectedBankDist.setText(String.format(Locale.US, "%.1f KM away", sb.distanceKm));
                if (txtSelectedBankLoc != null) txtSelectedBankLoc.setText("📍 " + (sb.area != null ? sb.area : "Maharashtra, India"));
                if (txtSelectedBankContact != null) txtSelectedBankContact.setText("📞 " + (sb.phone != null ? sb.phone : "+91 233 2374501"));
            }
        };

        for (int i = 0; i < allChips.length; i++) {
            final int index = i;
            if (allChips[i] != null) {
                allChips[i].setOnClickListener(v -> {
                    donorBookingFilterRadius = radiusValues[index];
                    for (int j = 0; j < allChips.length; j++) {
                        if (allChips[j] != null) {
                            if (j == index) {
                                allChips[j].setBackgroundResource(R.drawable.bg_button_primary);
                                allChips[j].setTextColor(ContextCompat.getColor(this, R.color.white));
                            } else {
                                allChips[j].setBackgroundResource(R.drawable.bg_chip_status_pending);
                                allChips[j].setTextColor(ContextCompat.getColor(this, R.color.text_secondary));
                            }
                        }
                    }
                    updateBankDropdown.run();
                });
            }
        }

        if (dropdownBank != null) {
            dropdownBank.setOnClickListener(v -> dropdownBank.showDropDown());
        }

        updateBankDropdown.run();

        // Date selection setup (Disallowing past dates)
        final Calendar selectedCal = Calendar.getInstance();
        if (inputDate != null) {
            SimpleDateFormat df = new SimpleDateFormat("dd MMM yyyy", Locale.US);
            inputDate.setText(df.format(selectedCal.getTime()));
            inputDate.setOnClickListener(v -> {
                Calendar nowCal = Calendar.getInstance();
                DatePickerDialog dpd = new DatePickerDialog(this, (view1, year, month, dayOfMonth) -> {
                    selectedCal.set(Calendar.YEAR, year);
                    selectedCal.set(Calendar.MONTH, month);
                    selectedCal.set(Calendar.DAY_OF_MONTH, dayOfMonth);
                    inputDate.setText(df.format(selectedCal.getTime()));
                }, selectedCal.get(Calendar.YEAR), selectedCal.get(Calendar.MONTH), selectedCal.get(Calendar.DAY_OF_MONTH));
                dpd.getDatePicker().setMinDate(nowCal.getTimeInMillis() - 1000);
                dpd.show();
            });
        }

        // Time selection setup (Validating against past time if today)
        if (inputTime != null) {
            SimpleDateFormat tf = new SimpleDateFormat("hh:mm a", Locale.US);
            selectedCal.add(Calendar.HOUR_OF_DAY, 2);
            inputTime.setText(tf.format(selectedCal.getTime()));
            inputTime.setOnClickListener(v -> {
                TimePickerDialog tpd = new TimePickerDialog(this, (view12, hourOfDay, minute) -> {
                    Calendar checkCal = Calendar.getInstance();
                    boolean isToday = selectedCal.get(Calendar.YEAR) == checkCal.get(Calendar.YEAR) &&
                                      selectedCal.get(Calendar.DAY_OF_YEAR) == checkCal.get(Calendar.DAY_OF_YEAR);
                    if (isToday) {
                        if (hourOfDay < checkCal.get(Calendar.HOUR_OF_DAY) ||
                            (hourOfDay == checkCal.get(Calendar.HOUR_OF_DAY) && minute < checkCal.get(Calendar.MINUTE))) {
                            Toast.makeText(this, "Please select a future time for today.", Toast.LENGTH_SHORT).show();
                            return;
                        }
                    }
                    selectedCal.set(Calendar.HOUR_OF_DAY, hourOfDay);
                    selectedCal.set(Calendar.MINUTE, minute);
                    inputTime.setText(tf.format(selectedCal.getTime()));
                }, selectedCal.get(Calendar.HOUR_OF_DAY), selectedCal.get(Calendar.MINUTE), false);
                tpd.show();
            });
        }

        if (btnClose != null) btnClose.setOnClickListener(v -> dialog.dismiss());
        if (btnCancel != null) btnCancel.setOnClickListener(v -> dialog.dismiss());

        if (btnSubmit != null) {
            btnSubmit.setOnClickListener(v -> {
                if (selectedBankHolder[0] == null) {
                    if (txtError != null) {
                        txtError.setText("Please select a valid Blood Bank.");
                        txtError.setVisibility(View.VISIBLE);
                    }
                    return;
                }

                String dateStr = inputDate != null ? inputDate.getText().toString().trim() : "";
                String timeStr = inputTime != null ? inputTime.getText().toString().trim() : "";
                String msgStr = inputMessage != null ? inputMessage.getText().toString().trim() : "";

                if (TextUtils.isEmpty(dateStr) || TextUtils.isEmpty(timeStr)) {
                    if (txtError != null) {
                        txtError.setText("Please select both Appointment Date and Time.");
                        txtError.setVisibility(View.VISIBLE);
                    }
                    return;
                }

                btnSubmit.setEnabled(false);
                if (txtError != null) txtError.setVisibility(View.GONE);

                String currentUid = currentUser != null ? currentUser.getUid() : "USR-DNR-01";
                String currentName = currentUser != null ? currentUser.getDisplayName() : "Donor";
                String currentEmail = currentUser != null ? currentUser.getEmail() : "donor@smartblood.org";
                String currentPhone = currentUser != null ? currentUser.getMobileNumber() : "+91 9876543210";
                SmartMapItem targetBank = selectedBankHolder[0];

                FirebaseFirestore db = FirebaseFirestore.getInstance();

                // Duplicate Check: Same donor, same bank, same date, same time
                db.collection("donorAppointments")
                    .whereEqualTo("donorAuthUid", currentUid)
                    .whereEqualTo("bloodBankId", targetBank.id)
                    .whereEqualTo("date", dateStr)
                    .whereEqualTo("time", timeStr)
                    .get()
                    .addOnCompleteListener(dupTask -> {
                        if (dupTask.isSuccessful() && dupTask.getResult() != null && !dupTask.getResult().isEmpty()) {
                            boolean hasActive = false;
                            for (DocumentSnapshot dDoc : dupTask.getResult().getDocuments()) {
                inventoryBankListener = FirebaseFirestore.getInstance().collection("bloodBanks")
                    .addSnapshotListener((querySnapshot, e) -> {
                        if (progress != null) progress.setVisibility(View.GONE);
                        if (e != null || querySnapshot == null || querySnapshot.isEmpty()) {
                            refreshBankList.run();
                            return;
                        }

                        double hospL = (userLat != 0.0 && !Double.isNaN(userLat)) ? userLat : 16.8524;
                        double hospG = (userLng != 0.0 && !Double.isNaN(userLng)) ? userLng : 74.5815;
                        UserProfile cUser = repository.getCurrentUser();
                        if (cUser != null && cUser.getLatitude() != 0.0 && cUser.getLongitude() != 0.0) {
                            hospL = cUser.getLatitude();
                            hospG = cUser.getLongitude();
                        }

                        for (com.google.firebase.firestore.QueryDocumentSnapshot doc : querySnapshot) {
                            String docId = doc.getId();
                            String name = doc.getString("name");
                            if (TextUtils.isEmpty(name)) continue;

                            Double rawLat = doc.getDouble("latitude");
                            Double rawLng = doc.getDouble("longitude");
                            double lat = (rawLat != null && !Double.isNaN(rawLat) && !Double.isInfinite(rawLat)) ? rawLat : 16.8524;
                            double lng = (rawLng != null && !Double.isNaN(rawLng) && !Double.isInfinite(rawLng)) ? rawLng : 74.5815;
                            String phone = doc.getString("phone") != null ? doc.getString("phone") : "+91 233 2374500";
                            String city = doc.getString("city") != null ? doc.getString("city") : "City Reserve";

                            Map<String, Integer> stockMap = extractStockMapFromDoc(doc);

                            boolean exists = false;
                            for (SmartMapItem item : smartMapItemList) {
                                if (item.id.equals(docId) || item.name.equalsIgnoreCase(name)) {
                                    item.stockMap = stockMap;
                                    item.phone = phone;
                                    item.area = city;
                                    item.lat = lat;
                                    item.lng = lng;
                                    item.distanceKm = calculateDistanceInKm(hospL, hospG, lat, lng);
                                    exists = true;
                                    break;
                                }
                            }
                            if (!exists) {
                                SmartMapItem regItem = new SmartMapItem(docId, name, "BLOOD_BANK", lat, lng, phone, city, true, 37, stockMap);
                                regItem.distanceKm = calculateDistanceInKm(hospL, hospG, lat, lng);
                                smartMapItemList.add(regItem);
                            }
                        }
                        refreshBankList.run();
                    });
            } catch (Exception e) {
                if (progress != null) progress.setVisibility(View.GONE);
                refreshBankList.run();
            }
        } else if (currentRole == UserRole.BLOOD_BANK) {
            EditText inputSearch = view.findViewById(R.id.input_search_inventory);
            ProgressBar progress = view.findViewById(R.id.loading_inventory_progress);
            LinearLayout container = view.findViewById(R.id.layout_inventory_container);
            View emptyState = view.findViewById(R.id.layout_inventory_empty);
            TextView txtCount = view.findViewById(R.id.txt_inventory_count);
            View btnInventoryFilter = view.findViewById(R.id.btn_inventory_filter);

            TextView chipAll = view.findViewById(R.id.chip_filter_all);
            TextView chipOPos = view.findViewById(R.id.chip_filter_available);
            TextView chipONeg = view.findViewById(R.id.chip_filter_low);
            TextView chipAPos = view.findViewById(R.id.chip_filter_critical);
            TextView chipBPos = view.findViewById(R.id.chip_filter_expiring);
            TextView chipANeg = view.findViewById(R.id.chip_filter_a_neg);
            TextView chipBNeg = view.findViewById(R.id.chip_filter_b_neg);
            TextView chipABPos = view.findViewById(R.id.chip_filter_ab_pos);
            TextView chipABNeg = view.findViewById(R.id.chip_filter_ab_neg);
            TextView chipBombay = view.findViewById(R.id.chip_filter_bombay);

            if (inputSearch != null) inputSearch.setHint("Search Bank or Filter Group (O+, A-, AB)...");
            if (chipAll != null) chipAll.setText("All Groups");
            if (chipOPos != null) chipOPos.setText("O+");
            if (chipONeg != null) chipONeg.setText("O-");
            if (chipAPos != null) chipAPos.setText("A+");
            if (chipBPos != null) chipBPos.setText("B+");
            if (chipANeg != null) chipANeg.setText("A-");
            if (chipBNeg != null) chipBNeg.setText("B-");
            if (chipABPos != null) chipABPos.setText("AB+");
            if (chipABNeg != null) chipABNeg.setText("AB-");
            if (chipBombay != null) {
                chipBombay.setText("Bombay (Oh)");
                chipBombay.setVisibility(View.VISIBLE);
            }

            UserProfile currentUser = repository.getCurrentUser();
                        });

                        // Manage / Update Dialog
                        TextView btnManage = new TextView(this);
                        btnManage.setText("✏️ Update Stock");
                        btnManage.setTextColor(0xFF38BDF8);
                        btnManage.setTextSize(12f);
                        btnManage.setTypeface(null, android.graphics.Typeface.BOLD);
                        btnManage.setGravity(android.view.Gravity.CENTER);
                        btnManage.setBackgroundResource(R.drawable.bg_chip_hospital);
                        LinearLayout.LayoutParams manLp = new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.MATCH_PARENT, 1.3f);
                        btnManage.setLayoutParams(manLp);
                        btnManage.setOnClickListener(v -> showUpdateStockDialog(groupName, units));

                        actionsRow.addView(btnQuickAdd);
                        actionsRow.addView(btnQuickDeduct);
                        actionsRow.addView(btnManage);
                        card.addView(actionsRow);

                        container.addView(card);
                    }
                }
            };

            updateChipStyles.run();
            refreshBankInventory.run();

            if (inputSearch != null) {
                inputSearch.addTextChangedListener(new TextWatcher() {
                    @Override public void beforeTextChanged(CharSequence s, int start, int count, int after) {}
                    @Override public void onTextChanged(CharSequence s, int start, int before, int count) {}
                    @Override public void afterTextChanged(Editable s) { refreshBankInventory.run(); }
                });
            }

            if (chipAll != null) chipAll.setOnClickListener(v -> {
                selectedBloodFilter[0] = "ALL";
                updateChipStyles.run();
                refreshBankInventory.run();
            });
            if (chipOPos != null) chipOPos.setOnClickListener(v -> {
                selectedBloodFilter[0] = "O+";
                updateChipStyles.run();
                refreshBankInventory.run();
            });
            if (chipONeg != null) chipONeg.setOnClickListener(v -> {
                selectedBloodFilter[0] = "O-";
                updateChipStyles.run();
                refreshBankInventory.run();
            });
            if (chipAPos != null) chipAPos.setOnClickListener(v -> {
                selectedBloodFilter[0] = "A+";
                updateChipStyles.run();
                refreshBankInventory.run();
            });
            if (chipBPos != null) chipBPos.setOnClickListener(v -> {
                selectedBloodFilter[0] = "B+";
                updateChipStyles.run();
                refreshBankInventory.run();
            });
            if (chipANeg != null) chipANeg.setOnClickListener(v -> {
                selectedBloodFilter[0] = "A-";
                updateChipStyles.run();
                refreshBankInventory.run();
            });
            if (chipBNeg != null) chipBNeg.setOnClickListener(v -> {
                selectedBloodFilter[0] = "B-";
                updateChipStyles.run();
                refreshBankInventory.run();
            });
            if (chipABPos != null) chipABPos.setOnClickListener(v -> {
                selectedBloodFilter[0] = "AB+";
                updateChipStyles.run();
                refreshBankInventory.run();
            });
            if (chipABNeg != null) chipABNeg.setOnClickListener(v -> {
                selectedBloodFilter[0] = "AB-";
                updateChipStyles.run();
                refreshBankInventory.run();
            });
            if (chipBombay != null) chipBombay.setOnClickListener(v -> {
                selectedBloodFilter[0] = "BOMBAY";
                updateChipStyles.run();
                refreshBankInventory.run();
            });

            // Real-Time Firestore Snapshot Listener for authenticated Blood Bank
            if (progress != null) progress.setVisibility(View.VISIBLE);
            try {
                if (inventoryBankListener != null) {
                    inventoryBankListener.remove();
                }
                inventoryBankListener = FirebaseFirestore.getInstance().collection("bloodBanks")
                    .addSnapshotListener((querySnapshot, e) -> {
                        if (progress != null) progress.setVisibility(View.GONE);
                        if (e != null || querySnapshot == null || querySnapshot.isEmpty()) {
                            refreshBankInventory.run();
                            return;
                        }
                            txtUpcomingStatus.setBackgroundResource(R.drawable.bg_chip_status_pending);
                            txtUpcomingStatus.setTextColor(ContextCompat.getColor(this, R.color.status_low_text));
                        }
                    }

                    if (btnUpcomingAction != null) {
                        btnUpcomingAction.setText("View Appointment Details ➔");
                        btnUpcomingAction.setOnClickListener(v -> loadView(R.layout.view_requests, this::bindRequestsView));
                    }
                } else {
                    if (txtUpcomingBank != null) txtUpcomingBank.setText("No upcoming appointment");
                    if (txtUpcomingDateTime != null) txtUpcomingDateTime.setText("Click Donate Blood to schedule your lifesaving donation.");
                    if (txtUpcomingStatus != null) {
                        txtUpcomingStatus.setText("READY TO BOOK");
                        txtUpcomingStatus.setBackgroundResource(R.drawable.bg_chip_status_pending);
                        txtUpcomingStatus.setTextColor(ContextCompat.getColor(this, R.color.status_low_text));
                    }
                    if (btnUpcomingAction != null) {
                        btnUpcomingAction.setText("+ Book Blood Donation");
                        btnUpcomingAction.setOnClickListener(v -> showBookBloodDonationDialog(null));
                    }
                }
            });

        // Emergency Center Section (Live emergency requests matching or proximate)
        TextView txtEmerTitle = view.findViewById(R.id.txt_donor_emergency_title);
        TextView txtEmerDist = view.findViewById(R.id.txt_donor_emergency_distance);
        TextView txtEmerHosp = view.findViewById(R.id.txt_donor_emergency_hospital);
        View btnRespond = view.findViewById(R.id.btn_donor_respond_emergency);

                                btnSubmit.setEnabled(true);
                                if (txtError != null) {
                                    txtError.setText("Appointment already exists for this time at " + targetBank.name + ".");
                                    txtError.setVisibility(View.VISIBLE);
                                } else {
                                    Toast.makeText(this, "Appointment already exists for this time.", Toast.LENGTH_LONG).show();
                                }
                                return;
                            }
                        }

                        // Create Appointment in Firestore
                        String appointmentId = "APT-" + System.currentTimeMillis();
                        String formattedCreated = new SimpleDateFormat("dd MMM yyyy, hh:mm a", Locale.US).format(new Date());

                        Map<String, Object> aptMap = new HashMap<>();
                        aptMap.put("appointmentId", appointmentId);
                        aptMap.put("donorId", currentUid);
                        aptMap.put("donorAuthUid", currentUid);
                        aptMap.put("donorName", currentName);
                        aptMap.put("donorEmail", currentEmail);
                        aptMap.put("donorPhone", currentPhone);
                        aptMap.put("bloodBankId", targetBank.id);
                        aptMap.put("bloodBankName", targetBank.name);
                        aptMap.put("bloodGroup", donorGroup);
                        aptMap.put("date", dateStr);
                        aptMap.put("time", timeStr);
                        aptMap.put("message", msgStr);
                        aptMap.put("status", "PENDING");
                        aptMap.put("createdAt", formattedCreated);
                        aptMap.put("createdAtTimestamp", System.currentTimeMillis());
                        aptMap.put("updatedAt", System.currentTimeMillis());

                        db.collection("donorAppointments").document(appointmentId).set(aptMap)
                            .addOnSuccessListener(aVoid -> {
                                // Notification for Blood Bank
                                String notifBankId = "NOTIF-BB-" + System.currentTimeMillis();
                                Map<String, Object> bankNotif = new HashMap<>();
                                bankNotif.put("notificationId", notifBankId);
                                bankNotif.put("recipientBloodBankId", targetBank.id);
                                bankNotif.put("bloodBankId", targetBank.id);
                                bankNotif.put("targetRole", "BLOOD_BANK");
                                bankNotif.put("title", "New Donor Appointment");
                                bankNotif.put("message", "New blood donation appointment booked by " + currentName + " (" + donorGroup + ") for " + dateStr + " at " + timeStr + ".");
                                bankNotif.put("type", "DONOR_APPOINTMENT");
                                bankNotif.put("appointmentId", appointmentId);
                                bankNotif.put("createdAt", formattedCreated);
                                bankNotif.put("timestamp", System.currentTimeMillis());
                                bankNotif.put("isRead", false);
                                bankNotif.put("read", false);
                                db.collection("notifications").document(notifBankId).set(bankNotif);
                            hNotif.put("timestamp", System.currentTimeMillis());
                            hNotif.put("isRead", false);
                            hNotif.put("read", false);
                            FirebaseFirestore.getInstance().collection("notifications").document(notifId).set(hNotif);

                            repository.addAuditLog(currentUid, "DONOR", "ACCEPT_EMERGENCY", fDoc.getId(), "10:22 AM", "SEARCHING", "RESPONDED", "Donor " + donorName + " accepted emergency request from " + hName);
                            Toast.makeText(this, "Response sent to " + hName + "! Blood Bank will coordinate your donation.", Toast.LENGTH_LONG).show();
                        });
                    }
                }
            });

        // Impact Statistics
        TextView txtTotalDonations = view.findViewById(R.id.txt_donor_stat_total_donations);
        if (txtTotalDonations != null) {
            txtTotalDonations.setText(String.valueOf(currentUser != null ? currentUser.getTotalDonations() : 0));
        }
    }

    private void bindEmergencyCenterView(View view) {
        TextView txtTimer = view.findViewById(R.id.txt_live_timer);
        if (txtTimer != null) {
            if (emergencyTimer != null) emergencyTimer.cancel();
            emergencyTimer = new CountDownTimer(900000, 1000) {
                @Override
                public void onTick(long millisUntilFinished) {
                    long mins = (millisUntilFinished / 1000) / 60;
                    long secs = (millisUntilFinished / 1000) % 60;
                    txtTimer.setText(String.format("⏱ %02d:%02d remaining", mins, secs));
                }

                @Override
                public void onFinish() {
                    txtTimer.setText("⏱ EXPIRED");
                }
            }.start();
        }

        View btnDispatch = view.findViewById(R.id.btn_dispatch_source_1);
        if (btnDispatch != null) {
            btnDispatch.setOnClickListener(v -> {
                repository.addAuditLog(currentRole.name(), currentRole.name(), "DISPATCH_UNITS", "REQ-2026-904", "10:25 AM", "SEARCHING", "RESERVED", "Dispatched 2 units O- from City Central Blood Bank.");
                Toast.makeText(this, "Dispatched 2 units O- from City Central Blood Bank!", Toast.LENGTH_LONG).show();
                loadView(R.layout.view_map, this::bindMapView);
            });
        }
    }

    private void bindSmartMatchView(View view) {
        View btnDetails1 = view.findViewById(R.id.btn_source_details_1);
        if (btnDetails1 != null) btnDetails1.setOnClickListener(v -> loadView(R.layout.view_map, this::bindMapView));
    }

    private void bindInventoryView(View view) {
        attachRoleBackgroundAnimators(view);

        if (currentRole == UserRole.HOSPITAL) {
            EditText inputSearch = view.findViewById(R.id.input_search_inventory);
            ProgressBar progress = view.findViewById(R.id.loading_inventory_progress);
            LinearLayout container = view.findViewById(R.id.layout_inventory_container);
            View emptyState = view.findViewById(R.id.layout_inventory_empty);

            TextView chipAll = view.findViewById(R.id.chip_filter_all);
            TextView chipOPos = view.findViewById(R.id.chip_filter_available);
            TextView chipONeg = view.findViewById(R.id.chip_filter_low);
            TextView chipAPos = view.findViewById(R.id.chip_filter_critical);
            TextView chipBPos = view.findViewById(R.id.chip_filter_expiring);
            TextView chipANeg = view.findViewById(R.id.chip_filter_a_neg);
            TextView chipBNeg = view.findViewById(R.id.chip_filter_b_neg);
            TextView chipABPos = view.findViewById(R.id.chip_filter_ab_pos);
            TextView chipABNeg = view.findViewById(R.id.chip_filter_ab_neg);
            TextView chipBombay = view.findViewById(R.id.chip_filter_bombay);

            // Filter state: "ALL", "O+", "O-", "A+", "B+", "A-", "B-", "AB+", "AB-", "BOMBAY"
            final String[] selectedBloodFilter = new String[]{"ALL"};

            Runnable updateChipStyles = () -> {
                TextView[] chips = new TextView[]{chipAll, chipOPos, chipONeg, chipAPos, chipBPos, chipANeg, chipBNeg, chipABPos, chipABNeg, chipBombay};
                String[] filterKeys = new String[]{"ALL", "O+", "O-", "A+", "B+", "A-", "B-", "AB+", "AB-", "BOMBAY"};
                String current = selectedBloodFilter[0];
                for (int i = 0; i < chips.length; i++) {
                    TextView ch = chips[i];
                    if (ch == null) continue;
                    String k = filterKeys[i];
                    boolean isSelected = k.equalsIgnoreCase(current) || 
                        ("O_POS".equalsIgnoreCase(current) && "O+".equalsIgnoreCase(k)) ||
                        ("O_NEG_EMERGENCY".equalsIgnoreCase(current) && "O-".equalsIgnoreCase(k)) ||
                        ("A_POS".equalsIgnoreCase(current) && "A+".equalsIgnoreCase(k)) ||
                        ("B_POS".equalsIgnoreCase(current) && "B+".equalsIgnoreCase(k));
                    if (isSelected) {
                        ch.setBackgroundResource(R.drawable.bg_button_primary);
                        ch.setTextColor(ContextCompat.getColor(this, R.color.white));
                    } else {
                        ch.setBackgroundResource(R.drawable.bg_chip_status_pending);
                        ch.setTextColor(ContextCompat.getColor(this, R.color.text_secondary));
                    }
                }
            };

        TextView txtUpcomingDateTime = view.findViewById(R.id.txt_upcoming_date_time);
        TextView btnUpcomingAction = view.findViewById(R.id.btn_donor_view_appointment);

        donorUpcomingAppointmentListener = FirebaseFirestore.getInstance().collection("donorAppointments")
            .whereEqualTo("donorAuthUid", currentUid)
            .addSnapshotListener((snaps, err) -> {
                if (snaps == null) return;
                DocumentSnapshot activeDoc = null;
                for (DocumentSnapshot d : snaps.getDocuments()) {
                    String st = d.getString("status");
                    if (st != null && (st.equalsIgnoreCase("PENDING") || st.equalsIgnoreCase("CONFIRMED"))) {
                        activeDoc = d;
                        break;
                    }
                }

                if (activeDoc != null) {
                    String bName = activeDoc.getString("bloodBankName") != null ? activeDoc.getString("bloodBankName") : "Blood Bank";
                    String dDate = activeDoc.getString("date") != null ? activeDoc.getString("date") : "";
                    String dTime = activeDoc.getString("time") != null ? activeDoc.getString("time") : "";
        View cardDonateBloodCta = view.findViewById(R.id.card_donor_donate_blood_cta);
        if (cardDonateBloodCta != null) {
            cardDonateBloodCta.setOnClickListener(v -> showBookBloodDonationDialog(null));
        }

        // Upcoming Blood Donation Appointment Card
        TextView txtUpcomingBank = view.findViewById(R.id.txt_upcoming_bank_name);
        TextView txtUpcomingStatus = view.findViewById(R.id.txt_upcoming_status_badge);
        TextView txtUpcomingDateTime = view.findViewById(R.id.txt_upcoming_date_time);
        TextView btnUpcomingAction = view.findViewById(R.id.btn_donor_view_appointment);

        donorUpcomingAppointmentListener = FirebaseFirestore.getInstance().collection("donorAppointments")
            .whereEqualTo("donorAuthUid", currentUid)
            .addSnapshotListener((snaps, err) -> {
                if (snaps == null) return;
                DocumentSnapshot activeDoc = null;
                for (DocumentSnapshot d : snaps.getDocuments()) {
                    String st = d.getString("status");
                    if (st != null && (st.equalsIgnoreCase("PENDING") || st.equalsIgnoreCase("CONFIRMED"))) {
                        activeDoc = d;
                        break;
                    }
                }

                if (activeDoc != null) {
                    String bName = activeDoc.getString("bloodBankName") != null ? activeDoc.getString("bloodBankName") : "Blood Bank";
                    String dDate = activeDoc.getString("date") != null ? activeDoc.getString("date") : "";
                    String dTime = activeDoc.getString("time") != null ? activeDoc.getString("time") : "";
                    String st = activeDoc.getString("status") != null ? activeDoc.getString("status").toUpperCase(Locale.US) : "PENDING";

                    if (txtUpcomingBank != null) txtUpcomingBank.setText(bName);
                    if (txtUpcomingDateTime != null) txtUpcomingDateTime.setText("🗓️ " + dDate + " at " + dTime);

                    if (txtUpcomingStatus != null) {
                        if ("CONFIRMED".equals(st)) {
                            txtUpcomingStatus.setText("✓ CONFIRMED");
                            txtUpcomingStatus.setBackgroundResource(R.drawable.bg_chip_status_verified);
                            txtUpcomingStatus.setTextColor(ContextCompat.getColor(this, R.color.status_verified_text));
                        } else {
                            txtUpcomingStatus.setText("⏳ PENDING");
                            txtUpcomingStatus.setBackgroundResource(R.drawable.bg_chip_status_pending);
                            txtUpcomingStatus.setTextColor(ContextCompat.getColor(this, R.color.status_low_text));
                        }
                    }

                    if (btnUpcomingAction != null) {
                        btnUpcomingAction.setText("View Appointment Details ➔");
                        btnUpcomingAction.setOnClickListener(v -> loadView(R.layout.view_requests, this::bindRequestsView));
                    }
                } else {
                    if (txtUpcomingBank != null) txtUpcomingBank.setText("No upcoming appointment");
                    if (txtUpcomingDateTime != null) txtUpcomingDateTime.setText("Click Donate Blood to schedule your lifesaving donation.");
                    if (txtUpcomingStatus != null) {
                        txtUpcomingStatus.setText("READY TO BOOK");
                        txtUpcomingStatus.setBackgroundResource(R.drawable.bg_chip_status_pending);
                        txtUpcomingStatus.setTextColor(ContextCompat.getColor(this, R.color.status_low_text));
                    }
                    if (btnUpcomingAction != null) {
                        btnUpcomingAction.setText("+ Book Blood Donation");
                        btnUpcomingAction.setOnClickListener(v -> showBookBloodDonationDialog(null));
                    }
                }
            });

        // Emergency Center Section (Live emergency requests matching or proximate)
        TextView txtEmerTitle = view.findViewById(R.id.txt_donor_emergency_title);
        TextView txtEmerDist = view.findViewById(R.id.txt_donor_emergency_distance);
        TextView txtEmerHosp = view.findViewById(R.id.txt_donor_emergency_hospital);
        View btnRespond = view.findViewById(R.id.btn_donor_respond_emergency);

        donorEmergencyListener = FirebaseFirestore.getInstance().collection("bloodRequests")
            .whereEqualTo("urgency", "Emergency")
            .addSnapshotListener((snaps, err) -> {
                if (snaps == null) return;
                DocumentSnapshot topEmer = null;
                for (DocumentSnapshot d : snaps.getDocuments()) {
                    String st = d.getString("status");
                    if (st != null && !st.equalsIgnoreCase("Fulfilled") && !st.equalsIgnoreCase("Cancelled") && !st.equalsIgnoreCase("REJECTED")) {
                        topEmer = d;
                        break;
                    }
                }

                if (topEmer != null) {
                    final DocumentSnapshot fDoc = topEmer;
                    String hName = fDoc.getString("hospitalName") != null ? fDoc.getString("hospitalName") : "Regional Hospital";
                    String bGroup = fDoc.getString("bloodGroup") != null ? fDoc.getString("bloodGroup") : donorGroup;
                    Long qUnits = fDoc.getLong("quantity");
                    int qty = qUnits != null ? qUnits.intValue() : 2;
                    double hLat = fDoc.getDouble("hospitalLat") != null ? fDoc.getDouble("hospitalLat") : 16.8524;
                    double hLng = fDoc.getDouble("hospitalLng") != null ? fDoc.getDouble("hospitalLng") : 74.5815;
                    double distKm = calculateDistanceInKm(userLat, userLng, hLat, hLng);

                    if (txtEmerTitle != null) txtEmerTitle.setText(bGroup + " Urgent Emergency Request");
                    if (txtEmerDist != null) txtEmerDist.setText(String.format(Locale.US, "%.1f km away", distKm));
                    if (txtEmerHosp != null) txtEmerHosp.setText(hName + " • " + qty + " Units Required");

                    if (btnRespond != null) {
                        btnRespond.setOnClickListener(v -> {
                            Map<String, Object> respMap = new HashMap<>();
                            respMap.put("matchedDonorId", currentUid);
                            respMap.put("donorName", donorName);
                            respMap.put("donorBloodGroup", donorGroup);
                            respMap.put("donorStatus", "AVAILABLE");
                            respMap.put("donorDistanceKm", distKm);
                            respMap.put("donorResponseTime", System.currentTimeMillis());

                            FirebaseFirestore.getInstance().collection("bloodRequests").document(fDoc.getId())
                                .set(respMap, com.google.firebase.firestore.SetOptions.merge());

                            String notifId = "NOTIF-HOS-RESP-" + System.currentTimeMillis();
                            Map<String, Object> hNotif = new HashMap<>();
                            hNotif.put("notificationId", notifId);
                            hNotif.put("hospitalId", fDoc.getString("hospitalId"));
                            hNotif.put("recipientFacilityId", fDoc.getString("hospitalId"));
                            hNotif.put("targetRole", "HOSPITAL");
                            hNotif.put("title", "Matching Donor Responded");
                            hNotif.put("message", "Donor " + donorName + " (" + donorGroup + ", " + String.format(Locale.US, "%.1f km away", distKm) + ") responded: Available / Ready to Donate.");
                            hNotif.put("type", "DONOR_RESPONSE");
                            hNotif.put("requestId", fDoc.getId());
                            hNotif.put("createdAt", new SimpleDateFormat("dd MMM yyyy, hh:mm a", Locale.US).format(new Date()));
                            hNotif.put("timestamp", System.currentTimeMillis());
                            hNotif.put("isRead", false);
                            hNotif.put("read", false);
                            FirebaseFirestore.getInstance().collection("notifications").document(notifId).set(hNotif);

                            repository.addAuditLog(currentUid, "DONOR", "ACCEPT_EMERGENCY", fDoc.getId(), "10:22 AM", "SEARCHING", "RESPONDED", "Donor " + donorName + " accepted emergency request from " + hName);
                            Toast.makeText(this, "Response sent to " + hName + "! Blood Bank will coordinate your donation.", Toast.LENGTH_LONG).show();
                        });
                    }
                }
            });

        // Impact Statistics
        TextView txtTotalDonations = view.findViewById(R.id.txt_donor_stat_total_donations);
        if (txtTotalDonations != null) {
            txtTotalDonations.setText(String.valueOf(currentUser != null ? currentUser.getTotalDonations() : 0));
        }
    }

    private void bindEmergencyCenterView(View view) {
        TextView txtTimer = view.findViewById(R.id.txt_live_timer);
        if (txtTimer != null) {
            if (emergencyTimer != null) emergencyTimer.cancel();
            emergencyTimer = new CountDownTimer(900000, 1000) {
                @Override
                public void onTick(long millisUntilFinished) {
                    long mins = (millisUntilFinished / 1000) / 60;
                    long secs = (millisUntilFinished / 1000) % 60;
                    txtTimer.setText(String.format("⏱ %02d:%02d remaining", mins, secs));
                }

                @Override
                public void onFinish() {
                    txtTimer.setText("⏱ EXPIRED");
                }
            }.start();
        }

        View btnDispatch = view.findViewById(R.id.btn_dispatch_source_1);
        if (btnDispatch != null) {
            btnDispatch.setOnClickListener(v -> {
                repository.addAuditLog(currentRole.name(), currentRole.name(), "DISPATCH_UNITS", "REQ-2026-904", "10:25 AM", "SEARCHING", "RESERVED", "Dispatched 2 units O- from City Central Blood Bank.");
                Toast.makeText(this, "Dispatched 2 units O- from City Central Blood Bank!", Toast.LENGTH_LONG).show();
                loadView(R.layout.view_map, this::bindMapView);
            });
        }
    }

    private void bindSmartMatchView(View view) {
        View btnDetails1 = view.findViewById(R.id.btn_source_details_1);
        if (btnDetails1 != null) btnDetails1.setOnClickListener(v -> loadView(R.layout.view_map, this::bindMapView));
    }

    private void bindInventoryView(View view) {
        attachRoleBackgroundAnimators(view);

        if (currentRole == UserRole.HOSPITAL) {
            EditText inputSearch = view.findViewById(R.id.input_search_inventory);
            ProgressBar progress = view.findViewById(R.id.loading_inventory_progress);
            LinearLayout container = view.findViewById(R.id.layout_inventory_container);
                    TextView ch = chips[i];
                    if (ch == null) continue;
