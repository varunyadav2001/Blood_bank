    private void seedAndSyncFirestoreBloodBanks() {
        List<RawBank> rawList = getMasterBloodBankList();

        try {
            FirebaseFirestore db = FirebaseFirestore.getInstance();
            db.collection("bloodBanks").get().addOnSuccessListener(snapshot -> {
                Set<String> existingNames = new HashSet<>();
                if (snapshot != null && !snapshot.isEmpty()) {
                    for (com.google.firebase.firestore.QueryDocumentSnapshot doc : snapshot) {
                        String n = doc.getString("name");
                        if (n != null) existingNames.add(n.toLowerCase(java.util.Locale.US).trim());
                        // Ensure existing document has full blood group stock fields
                        Map<String, Object> existingStock = (Map<String, Object>) doc.get("bloodStock");
                        int bUnits = (n != null && (n.contains("Civil") || n.contains("Government") || n.contains("Medical College") || n.contains("Prakash Institute"))) ? 2 : 0;
                        if (existingStock == null || !existingStock.containsKey("O+") || !existingStock.containsKey("Bombay")) {
                            Map<String, Object> fullStock = new HashMap<>();
                            fullStock.put("O+", 15);
                            fullStock.put("A+", 12);
                            fullStock.put("B+", 10);
                            fullStock.put("AB+", 6);
                            fullStock.put("O-", 4);
                            fullStock.put("A-", 3);
                            fullStock.put("B-", 2);
                            fullStock.put("AB-", 1);
                            fullStock.put("Bombay", bUnits);
                            try { doc.getReference().update("bloodStock", fullStock); } catch (Exception ignored) {}
                        }
                    }
                }

                for (RawBank b : rawList) {
                    if (!existingNames.contains(b.name.toLowerCase(java.util.Locale.US).trim())) {
                        Map<String, Object> data = new HashMap<>();
                        data.put("name", b.name);
                        data.put("city", b.city);
                        data.put("address", b.address);
                        data.put("latitude", b.lat); // Stored strictly as Double Number
                        data.put("longitude", b.lng); // Stored strictly as Double Number
                        data.put("phone", b.phone);
                        data.put("availableBloodGroups", Arrays.asList("A+", "B+", "O+", "AB+", "O-", "Bombay"));
                        
                        Map<String, Integer> stock = new HashMap<>();
                        stock.put("O+", 15);
                        stock.put("A+", 12);
                        stock.put("B+", 10);
                        stock.put("AB+", 6);
                        stock.put("O-", 4);
                        stock.put("A-", 3);
                        stock.put("B-", 2);
                        stock.put("AB-", 1);
                        // Rare Bombay Blood Group (Oh) available at selected regional medical centers
                        if (b.name.contains("Civil") || b.name.contains("Government") || b.name.contains("Medical College") || b.name.contains("Prakash Institute")) {
                            stock.put("Bombay", 2);
                        } else {
                            stock.put("Bombay", 0);
                        }
                        data.put("bloodStock", stock);
                        
                        data.put("status", "Available");
                        data.put("verified", true);
                        stock.put("O+", 15);
                        stock.put("A+", 12);
                        stock.put("B+", 10);
                        stock.put("AB+", 6);
                        stock.put("O-", 4);
                        stock.put("A-", 3);
                        stock.put("B-", 2);
                        stock.put("AB-", 1);
                        // Rare Bombay Blood Group (Oh) available at selected regional medical centers
                        if (b.name.contains("Civil") || b.name.contains("Government") || b.name.contains("Medical College") || b.name.contains("Prakash Institute")) {
                            stock.put("Bombay", 2);
                        } else {
                            stock.put("Bombay", 0);
                        }
                        data.put("bloodStock", stock);
                        
                        data.put("status", "Available");
                        data.put("verified", true);

                        db.collection("bloodBanks").add(data);
                    }
                }
            });
        } catch (Exception ignored) {}
    }

