                BloodRequest newReq = new BloodRequest(reqId, hospitalId, hospitalName, group, comp, units, urgency, "PENDING", timeStr, notes, userLat, userLng, locationAddr);
                newReq.setBloodBankId(targetBankId);
                newReq.setBloodBankName(targetBankName);
                newReq.setAssignedSource(targetBankName);
                repository.getRequests().add(0, newReq);
                repository.addAuditLog(hospitalId, "HOSPITAL", "CREATE_REQUEST", reqId, timeStr, "NONE", "PENDING", (isEmergency ? "🚨 EMERGENCY: " : "") + "Created blood request for " + units + " units " + group + " to " + targetBankName + ". Status: PENDING");

                dialog.dismiss();
