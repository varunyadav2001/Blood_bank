    private void performBloodAllocation(String reqId, String hospId, String hospName, String bGroup, int qty, String bankUid, String bankName) {
        FirebaseFirestore db = FirebaseFirestore.getInstance();
        UserProfile curUser = repository.getCurrentUser();
        String defaultBankId = curUser != null && curUser.getBloodBankId() != null ? curUser.getBloodBankId() : bankUid;
        String defaultBankName = curUser != null && curUser.getDisplayName() != null ? curUser.getDisplayName() : bankName;

        String currentBankId = selectedBloodBank != null ? selectedBloodBank.id : defaultBankId;
        String finalBankName = selectedBloodBank != null ? selectedBloodBank.name : defaultBankName;

                LinearLayout card = new LinearLayout(this);
                card.setOrientation(LinearLayout.VERTICAL);
                card.setBackgroundResource(isTargetFocused ? R.drawable.bg_card_hero_crimson : R.drawable.bg_card_hospital);
                card.setPadding(32, 28, 32, 28);
                LinearLayout.LayoutParams cardLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                cardLp.setMargins(0, 0, 0, 24);
                card.setLayoutParams(cardLp);

                if (isTargetFocused) {
                    TextView txtFocused = new TextView(this);
                    txtFocused.setText("🎯 Focused Notification Transfer • " + trfId);
                    txtFocused.setTextColor(0xFF38BDF8);
                    txtFocused.setTextSize(11f);
                    txtFocused.setTypeface(null, android.graphics.Typeface.BOLD);
                    txtFocused.setBackgroundResource(R.drawable.bg_chip_status_pending);
                    txtFocused.setPadding(16, 6, 16, 6);
                    LinearLayout.LayoutParams fLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                    fLp.bottomMargin = 10;
                    txtFocused.setLayoutParams(fLp);
                    card.addView(txtFocused);
                }

                // Top Row: Source ➔ Destination + Status Badge
                RelativeLayout topRow = new RelativeLayout(this);
                topRow.setLayoutParams(new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));

                TextView txtRoute = new TextView(this);
                txtRoute.setText("🏥 " + srcName + " → " + destName);
                txtRoute.setTextColor(ContextCompat.getColor(this, R.color.white));
                txtRoute.setTextSize(14f);
                txtRoute.setTypeface(null, android.graphics.Typeface.BOLD);
                RelativeLayout.LayoutParams routeLp = new RelativeLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                routeLp.addRule(RelativeLayout.ALIGN_PARENT_START);
                routeLp.addRule(RelativeLayout.CENTER_VERTICAL);
                txtRoute.setLayoutParams(routeLp);

                TextView txtStatus = new TextView(this);
                String statusUpper = status.toUpperCase(Locale.US);
                txtStatus.setTextSize(11f);
                txtStatus.setTypeface(null, android.graphics.Typeface.BOLD);
                txtStatus.setPadding(18, 6, 18, 6);

                if (statusUpper.contains("PENDING")) {
                    txtStatus.setText("PENDING APPROVAL");
                    txtStatus.setBackgroundResource(R.drawable.bg_chip_status_pending);
                    txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_low_text));
                } else if (statusUpper.contains("APPROV") || statusUpper.contains("COMPLET")) {
                    txtStatus.setText("COMPLETED");
                    txtStatus.setBackgroundResource(R.drawable.bg_chip_status_available);
                    txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_available_text));
                } else if (statusUpper.contains("DECLIN") || statusUpper.contains("REJECT")) {
                    txtStatus.setText("DECLINED");
                    txtStatus.setBackgroundResource(R.drawable.bg_chip_status_critical);
                txtStepText.setText("Step 1 Request Cancelled");
                txtStepText.setTextColor(ContextCompat.getColor(this, R.color.status_critical_text));
                txtStepText.setTypeface(null, android.graphics.Typeface.BOLD);
            } else if (stepNumber < currentStep) {
                txtStepIcon.setText("✓");
                txtStepIcon.setTextColor(ContextCompat.getColor(this, R.color.status_available_text));
                txtStepText.setText("Step " + stepNumber + " " + stepLabels[i]);
                txtStepText.setTextColor(ContextCompat.getColor(this, R.color.text_secondary));
            } else if (stepNumber == currentStep) {
                txtStepIcon.setText(currentStep == 6 ? "✓" : "●");
                txtStepIcon.setTextColor(currentStep == 6 ? ContextCompat.getColor(this, R.color.status_available_text) : 0xFF38BDF8);
                txtStepText.setText("Step " + stepNumber + " " + stepLabels[i]);
                txtStepText.setTextColor(ContextCompat.getColor(this, R.color.white));
                txtStepText.setTypeface(null, android.graphics.Typeface.BOLD);
            } else {
                txtStepIcon.setText("○");
                txtStepIcon.setTextColor(ContextCompat.getColor(this, R.color.text_tertiary));
                txtStepText.setText("Step " + stepNumber + " " + stepLabels[i]);
                txtStepText.setTextColor(ContextCompat.getColor(this, R.color.text_tertiary));
            }

            stepRow.addView(txtStepIcon);
            stepRow.addView(txtStepText);
            stepsContainer.addView(stepRow);
        }

        timelineLayout.addView(stepsContainer);
        return timelineLayout;
    }

    private int activeBloodBankRequestTab = 0; // 0: Hospital Requests, 1: Donor Appointments

    private void bindRequestsView(View view) {
        attachRoleBackgroundAnimators(view);

        TextView txtTitle = view.findViewById(R.id.txt_requests_page_title);
        TextView txtSubtitle = view.findViewById(R.id.txt_requests_subtitle);
        TextView btnCreate = view.findViewById(R.id.btn_requests_page_create);
        ProgressBar progress = view.findViewById(R.id.loading_requests_progress);
        LinearLayout container = view.findViewById(R.id.layout_requests_container);
        View emptyState = view.findViewById(R.id.layout_requests_empty_state);
        TextView txtEmptyTitle = view.findViewById(R.id.txt_empty_requests_title);
        TextView txtEmptyDesc = view.findViewById(R.id.txt_empty_requests_desc);
        View btnEmptyCreate = view.findViewById(R.id.btn_empty_create_request);

        View layoutBankTabs = view.findViewById(R.id.layout_bank_request_tabs);
        TextView tabHospital = view.findViewById(R.id.tab_bank_hospital_requests);
        TextView tabDonor = view.findViewById(R.id.tab_bank_donor_appointments);

        UserProfile currentUser = repository.getCurrentUser();
        String currentUid = currentUser != null ? currentUser.getUid() : "USR-8842";
        String currentDisplayName = currentUser != null && currentUser.getDisplayName() != null ? currentUser.getDisplayName() : "User";

        if (currentRole == UserRole.DONOR) {
            if (layoutBankTabs != null) layoutBankTabs.setVisibility(View.GONE);
            if (txtTitle != null) txtTitle.setText("My Donation Appointments");
            if (txtSubtitle != null) txtSubtitle.setText("Live appointment status with regional blood banks");
            if (btnCreate != null) {
                btnCreate.setVisibility(View.VISIBLE);
                btnCreate.setText("+ Book Donation");
                btnCreate.setBackgroundResource(R.drawable.bg_button_donor);
                btnCreate.setOnClickListener(v -> showBookBloodDonationDialog(null));
            }
            if (txtEmptyTitle != null) txtEmptyTitle.setText("No Donation Appointments");
            if (txtEmptyDesc != null) txtEmptyDesc.setText("You haven't scheduled any blood donation appointments yet. Book an appointment to help save lives!");
            if (btnEmptyCreate != null) {
                btnEmptyCreate.setVisibility(View.VISIBLE);
                btnEmptyCreate.setBackgroundResource(R.drawable.bg_button_donor);
                btnEmptyCreate.setOnClickListener(v -> showBookBloodDonationDialog(null));
            }

            if (progress != null) progress.setVisibility(View.VISIBLE);

            try {
                if (donorAppointmentsListener != null) {
                    donorAppointmentsListener.remove();
                    donorAppointmentsListener = null;
                }

                donorAppointmentsListener = FirebaseFirestore.getInstance().collection("donorAppointments")
                    .whereEqualTo("donorAuthUid", currentUid)
                    .addSnapshotListener((queryDocumentSnapshots, e) -> {
                        if (progress != null) progress.setVisibility(View.GONE);
                        if (container == null) return;
                        container.removeAllViews();

                        if (e != null || queryDocumentSnapshots == null || queryDocumentSnapshots.isEmpty()) {
                            if (emptyState != null) emptyState.setVisibility(View.VISIBLE);
                            return;
                        }

                        List<DocumentSnapshot> apptDocs = new ArrayList<>(queryDocumentSnapshots.getDocuments());
                        if (apptDocs.isEmpty()) {
                            if (emptyState != null) emptyState.setVisibility(View.VISIBLE);
                            return;
                        }

                        if (emptyState != null) emptyState.setVisibility(View.GONE);

                        Collections.sort(apptDocs, (d1, d2) -> {
                            Long t1 = d1.getLong("createdAtTimestamp");
                            Long t2 = d2.getLong("createdAtTimestamp");
                            if (t1 == null) t1 = 0L;
                            if (t2 == null) t2 = 0L;
                            return Long.compare(t2, t1);
                        });

                        for (DocumentSnapshot doc : apptDocs) {
                            String apptId = doc.getString("appointmentId") != null ? doc.getString("appointmentId") : doc.getId();
                            String bBankName = doc.getString("bloodBankName") != null ? doc.getString("bloodBankName") : "Regional Blood Bank";
                            String bGroup = doc.getString("bloodGroup") != null ? doc.getString("bloodGroup") : "O+";
                            String date = doc.getString("date") != null ? doc.getString("date") : "Upcoming";
                            String time = doc.getString("time") != null ? doc.getString("time") : "10:00 AM";
                            String status = doc.getString("status") != null ? doc.getString("status") : "PENDING";
                            String message = doc.getString("message") != null ? doc.getString("message") : "";
                            String statusUpper = status.toUpperCase(Locale.US);

                            LinearLayout card = new LinearLayout(this);
                            card.setOrientation(LinearLayout.VERTICAL);
                            card.setBackgroundResource(R.drawable.bg_card_hospital);
                            card.setPadding(32, 28, 32, 28);
                            LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                            lp.setMargins(0, 0, 0, 24);
                            card.setLayoutParams(lp);

                            RelativeLayout topRow = new RelativeLayout(this);
                            topRow.setLayoutParams(new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));

                            TextView txtBank = new TextView(this);
                            txtBank.setText("🏥 " + bBankName);
                            txtBank.setTextColor(ContextCompat.getColor(this, R.color.white));
                            txtBank.setTextSize(16f);
                            txtBank.setTypeface(null, android.graphics.Typeface.BOLD);

                            TextView txtStatus = new TextView(this);
                            txtStatus.setTextSize(11f);
                            txtStatus.setTypeface(null, android.graphics.Typeface.BOLD);
                            txtStatus.setPadding(18, 6, 18, 6);

                            if (statusUpper.contains("PENDING")) {
                                txtStatus.setText("⏳ PENDING CONFIRMATION");
                                txtStatus.setBackgroundResource(R.drawable.bg_chip_status_pending);
                                txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_low_text));
                            } else if (statusUpper.contains("CONFIRM") || statusUpper.contains("ACCEPT")) {
                                txtStatus.setText("✓ CONFIRMED");
                                txtStatus.setBackgroundResource(R.drawable.bg_chip_status_reserved);
                                txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_reserved_text));
                            } else if (statusUpper.contains("COMPLET")) {
                                txtStatus.setText("✓ DONATION COMPLETED");
                                txtStatus.setBackgroundResource(R.drawable.bg_chip_status_available);
                                txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_available_text));
                            } else if (statusUpper.contains("REJECT")) {
                                txtStatus.setText("✕ REJECTED");
                                txtStatus.setBackgroundResource(R.drawable.bg_chip_status_critical);
                                txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_critical_text));
                            } else {
                                txtStatus.setText("CANCELLED");
                                txtStatus.setBackgroundResource(R.drawable.bg_chip_status_pending);
                                txtStatus.setTextColor(ContextCompat.getColor(this, R.color.text_tertiary));
                            }

                            RelativeLayout.LayoutParams sLp = new RelativeLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                            sLp.addRule(RelativeLayout.ALIGN_PARENT_END);
                            sLp.addRule(RelativeLayout.CENTER_VERTICAL);
                            txtStatus.setLayoutParams(sLp);

                            topRow.addView(txtBank);
                            topRow.addView(txtStatus);
                            card.addView(topRow);

                            // Blood Group & Appointment Schedule
                            TextView txtDetails = new TextView(this);
                            txtDetails.setText("🩸 " + bGroup + " Blood Donation • 📅 " + date + " at " + time);
                            txtDetails.setTextColor(0xFF38BDF8);
                            txtDetails.setTextSize(14f);
                            txtDetails.setTypeface(null, android.graphics.Typeface.BOLD);
                            LinearLayout.LayoutParams dtLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                            dtLp.topMargin = 10;
                            txtDetails.setLayoutParams(dtLp);
                            card.addView(txtDetails);

                            if (!message.isEmpty()) {
                                TextView txtNote = new TextView(this);
                                txtNote.setText("Note: " + message);
                                txtNote.setTextColor(ContextCompat.getColor(this, R.color.text_secondary));
                                txtNote.setTextSize(12f);
                                LinearLayout.LayoutParams nLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                                nLp.topMargin = 6;
                                txtNote.setLayoutParams(nLp);
                                card.addView(txtNote);
                            }

                            // Subtitle ID
                            TextView txtId = new TextView(this);
                            txtId.setText("Appointment ID: " + apptId);
                            txtId.setTextColor(ContextCompat.getColor(this, R.color.text_tertiary));
                            txtId.setTextSize(11f);
                            LinearLayout.LayoutParams idLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                            idLp.topMargin = 6;
                            txtId.setLayoutParams(idLp);
                            card.addView(txtId);

                            if (statusUpper.contains("PENDING") || statusUpper.contains("CONFIRM")) {
                                TextView btnCancel = new TextView(this);
                                btnCancel.setText("Cancel Appointment");
                                btnCancel.setTextColor(ContextCompat.getColor(this, R.color.status_critical_text));
                                btnCancel.setTextSize(12f);
                                btnCancel.setTypeface(null, android.graphics.Typeface.BOLD);
                                btnCancel.setGravity(android.view.Gravity.CENTER);
                                btnCancel.setBackgroundResource(R.drawable.bg_card_emergency);
                                LinearLayout.LayoutParams canLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 76);
                                canLp.topMargin = 16;
                                btnCancel.setLayoutParams(canLp);
                                btnCancel.setOnClickListener(v -> {
                                    new android.app.AlertDialog.Builder(this)
                                        .setTitle("Cancel Appointment")
                                        .setMessage("Are you sure you want to cancel your donation appointment with " + bBankName + "?")
                                        .setPositiveButton("Yes, Cancel", (d, w) -> {
                                            Map<String, Object> upd = new HashMap<>();
                                            upd.put("status", "CANCELLED");
                                            upd.put("updatedAt", System.currentTimeMillis());
                                            doc.getReference().update(upd);
                                            Toast.makeText(this, "Appointment cancelled.", Toast.LENGTH_SHORT).show();
                                        })
                                        .setNegativeButton("No", null)
                                        .show();
                                });
                                card.addView(btnCancel);
                            }

                            container.addView(card);
                        }
                    });
            } catch (Exception e) {
                if (progress != null) progress.setVisibility(View.GONE);
                if (emptyState != null) emptyState.setVisibility(View.VISIBLE);
            }
        } else if (currentRole == UserRole.BLOOD_BANK) {
            if (layoutBankTabs != null) {
                layoutBankTabs.setVisibility(View.VISIBLE);
            }
            if (btnCreate != null) btnCreate.setVisibility(View.GONE);
            if (btnEmptyCreate != null) btnEmptyCreate.setVisibility(View.GONE);

            String defaultBankName = currentUser != null && currentUser.getDisplayName() != null ? currentUser.getDisplayName() : "MSI Blood Bank Sangli";
            String defaultBankName = currentUser != null && currentUser.getDisplayName() != null ? currentUser.getDisplayName() : "MSI Blood Bank Sangli";
            String bankUid = currentUser != null ? currentUser.getUid() : "BB-MSI";
            String defaultBankId = currentUser != null && currentUser.getBloodBankId() != null ? currentUser.getBloodBankId() : bankUid;
            String bankName = selectedBloodBank != null ? selectedBloodBank.name : defaultBankName;
            String currentBankId = selectedBloodBank != null ? selectedBloodBank.id : defaultBankId;

            Runnable renderBloodBankView = () -> {
                if (progress != null) progress.setVisibility(View.VISIBLE);
                if (container != null) container.removeAllViews();

                if (tabHospital != null) {
                    tabHospital.setBackgroundResource(activeBloodBankRequestTab == 0 ? R.drawable.bg_button_hospital : R.drawable.bg_search_bar);
                    tabHospital.setTextColor(activeBloodBankRequestTab == 0 ? ContextCompat.getColor(this, R.color.white) : ContextCompat.getColor(this, R.color.text_secondary));
                }
                if (tabDonor != null) {
                    tabDonor.setBackgroundResource(activeBloodBankRequestTab == 1 ? R.drawable.bg_button_donor : R.drawable.bg_search_bar);
                    tabDonor.setTextColor(activeBloodBankRequestTab == 1 ? ContextCompat.getColor(this, R.color.white) : ContextCompat.getColor(this, R.color.text_secondary));
                }
                if (tabCamps != null) {
                    tabCamps.setBackgroundResource(activeBloodBankRequestTab == 2 ? R.drawable.bg_button_primary : R.drawable.bg_search_bar);
                    tabCamps.setTextColor(activeBloodBankRequestTab == 2 ? ContextCompat.getColor(this, R.color.white) : ContextCompat.getColor(this, R.color.text_secondary));
                }

                if (activeBloodBankRequestTab == 0) {
                    // TAB 0: Hospital Blood Requests
                    if (txtTitle != null) txtTitle.setText("Hospital Blood Requisitions");
                    if (txtSubtitle != null) txtSubtitle.setText("Incoming requisitions from healthcare centers awaiting verification");
                    if (txtEmptyTitle != null) txtEmptyTitle.setText("No Hospital Requisitions");
                    if (txtEmptyDesc != null) txtEmptyDesc.setText("No pending hospital requisitions for " + bankName + ".");

                    try {
                        if (bloodBankRequestsListener != null) {
                            bloodBankRequestsListener.remove();
                            bloodBankRequestsListener = null;
                        }
                        bloodBankRequestsListener = FirebaseFirestore.getInstance().collection("bloodRequests")
                            .addSnapshotListener((queryDocumentSnapshots, e) -> {
                                if (progress != null) progress.setVisibility(View.GONE);
                                if (container == null) return;
                                container.removeAllViews();

                                List<DocumentSnapshot> validDocs = new ArrayList<>();
                                for (QueryDocumentSnapshot doc : queryDocumentSnapshots) {
                                    String assigned = doc.getString("assignedSource") != null ? doc.getString("assignedSource") : "";
                                    String targetBankId = doc.getString("targetBloodBankId") != null ? doc.getString("targetBloodBankId") : (doc.getString("bloodBankId") != null ? doc.getString("bloodBankId") : "");
                                    String bBankName = doc.getString("bloodBankName") != null ? doc.getString("bloodBankName") : "";

                                    boolean matchesId = !targetBankId.isEmpty() && (targetBankId.equalsIgnoreCase(currentBankId) || targetBankId.equalsIgnoreCase(bankUid));
                                    boolean matchesName = (!bBankName.isEmpty() && bBankName.equalsIgnoreCase(bankName)) ||
                                                          (!assigned.isEmpty() && assigned.equalsIgnoreCase(bankName));

                                    if (!matchesId && !matchesName) {
                                        String bNameLower = bankName.toLowerCase(Locale.US);
                                        String tNameLower = bBankName.toLowerCase(Locale.US);
                                        String aNameLower = assigned.toLowerCase(Locale.US);
                                        String tIdLower = targetBankId.toLowerCase(Locale.US);

                                        if (bNameLower.contains("msi") && (tNameLower.contains("msi") || aNameLower.contains("msi") || tIdLower.contains("msi") || tIdLower.contains("bb-msi"))) {
                                            matchesName = true;
                                        } else if (bNameLower.contains("bombay") && (tNameLower.contains("bombay") || aNameLower.contains("bombay") || tIdLower.contains("bombay") || tIdLower.contains("bb-bombay"))) {
                                            matchesName = true;
                                        } else if (bNameLower.contains("shashwat") && (tNameLower.contains("shashwat") || aNameLower.contains("shashwat") || tIdLower.contains("shashwat") || tIdLower.contains("bb-shashwat"))) {
                                            matchesName = true;
                                        } else if (bNameLower.contains("civil") && (tNameLower.contains("civil") || aNameLower.contains("civil") || tIdLower.contains("civil") || tIdLower.contains("bb-sangli-civil"))) {
                                            matchesName = true;
                                        }
                                    }

                                    if (matchesId || matchesName) {
                                        validDocs.add(doc);
                                    }
                                }

                                if (validDocs.isEmpty()) {
                                    if (emptyState != null) emptyState.setVisibility(View.VISIBLE);
                                    return;
                                }

                                if (emptyState != null) emptyState.setVisibility(View.GONE);

                                Collections.sort(validDocs, (d1, d2) -> {
                                    String s1 = d1.getString("status");
                                    String s2 = d2.getString("status");
                                    String u1 = d1.getString("urgency");
                                    String u2 = d2.getString("urgency");
                                    
                                    boolean e1 = u1 != null && (u1.equalsIgnoreCase("Emergency") || u1.equalsIgnoreCase("Critical"));
                                    boolean e2 = u2 != null && (u2.equalsIgnoreCase("Emergency") || u2.equalsIgnoreCase("Critical"));
                                    
                                    boolean active1 = s1 != null && !s1.contains("FULFIL") && !s1.contains("REJECT") && !s1.contains("CANCEL");
                                    boolean active2 = s2 != null && !s2.contains("FULFIL") && !s2.contains("REJECT") && !s2.contains("CANCEL");

                                    if (e1 && active1 && !(e2 && active2)) return -1;
                                    if (!(e1 && active1) && (e2 && active2)) return 1;

                                    boolean active2 = s2 != null && !s2.contains("FULFIL") && !s2.contains("REJECT") && !s2.contains("CANCEL");

                                    if (e1 && active1 && !(e2 && active2)) return -1;
                                    if (!(e1 && active1) && (e2 && active2)) return 1;

                                    if (active1 && !active2) return -1;
                                    if (!active1 && active2) return 1;

                                    Long t1 = d1.getLong("createdAtTimestamp");
                                    Long t2 = d2.getLong("createdAtTimestamp");
                                    if (t1 == null) t1 = 0L;
                                    if (t2 == null) t2 = 0L;
                                    return Long.compare(t2, t1);
                                });

                                for (DocumentSnapshot doc : validDocs) {
                                    String reqId = doc.getString("requestId") != null ? doc.getString("requestId") : doc.getId();
                                    String hospId = doc.getString("hospitalId") != null ? doc.getString("hospitalId") : "";
                                    String hospName = doc.getString("hospitalName") != null ? doc.getString("hospitalName") : "Healthcare Facility";
                                    String bGroup = doc.getString("bloodGroup") != null ? doc.getString("bloodGroup") : "O+";
                                    String comp = doc.getString("component") != null ? doc.getString("component") : "Whole Blood";
                                    String createdAt = doc.getString("createdAt") != null ? doc.getString("createdAt") : "Today";
                                    String notes = doc.getString("notes") != null ? doc.getString("notes") : "";
                                    if (notes.isEmpty() && doc.getString("reason") != null) notes = doc.getString("reason");
                                    if (notes.isEmpty() && doc.getString("message") != null) notes = doc.getString("message");
                                    String location = doc.getString("locationAddress") != null ? doc.getString("locationAddress") : "";

                                    String matchedDonorName = doc.getString("donorName");
                                    String matchedDonorGroup = doc.getString("donorBloodGroup");
                                    String matchedDonorStatus = doc.getString("donorStatus");
                                    Double matchedDistance = doc.getDouble("donorDistanceKm");

                                    boolean isEmergencyReq = urgency.equalsIgnoreCase("Emergency") || urgency.equalsIgnoreCase("Critical");
                                    boolean isTargetFocused = highlightTargetRequestId != null && reqId.equalsIgnoreCase(highlightTargetRequestId);

                                    LinearLayout card = new LinearLayout(this);
                                    card.setOrientation(LinearLayout.VERTICAL);
                                    if (isTargetFocused) {
                                        card.setBackgroundResource(R.drawable.bg_card_hero_crimson);
                                    } else if (isEmergencyReq && !status.contains("FULFIL") && !status.contains("REJECT") && !status.contains("CANCEL")) {
                                        card.setBackgroundResource(R.drawable.bg_card_emergency);
                                    } else {
                                        card.setBackgroundResource(R.drawable.bg_card_hospital);
                                    }
                                    card.setPadding(32, 28, 32, 28);
                                    LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                                    lp.setMargins(0, 0, 0, 24);
                                    card.setLayoutParams(lp);

                                    if (isTargetFocused) {
                                        TextView txtFocused = new TextView(this);
                                        txtFocused.setText("🎯 Focused Notification Request • " + reqId);
                                        txtFocused.setTextColor(0xFF38BDF8);
                                        txtFocused.setTextSize(11f);
                                        txtFocused.setTypeface(null, android.graphics.Typeface.BOLD);
                                        txtFocused.setBackgroundResource(R.drawable.bg_chip_status_pending);
                                        txtFocused.setPadding(16, 6, 16, 6);
                                        LinearLayout.LayoutParams fLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                                        fLp.bottomMargin = 10;
                                        txtFocused.setLayoutParams(fLp);
                                        card.addView(txtFocused);
                                    }

                                    RelativeLayout topRow = new RelativeLayout(this);
                                    topRow.setLayoutParams(new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));

                                    TextView txtHosp = new TextView(this);
                                    txtHosp.setText((isEmergencyReq ? "🚨 " : "🏥 ") + hospName);
                                    txtHosp.setTextColor(ContextCompat.getColor(this, R.color.white));
                                    txtHosp.setTextSize(16f);
                                    txtHosp.setTypeface(null, android.graphics.Typeface.BOLD);

                                    TextView txtStatus = new TextView(this);
                                    String statusUpper = status.toUpperCase(Locale.US);
                                    txtStatus.setTextSize(11f);
                                    txtStatus.setTypeface(null, android.graphics.Typeface.BOLD);
                                    txtStatus.setPadding(18, 6, 18, 6);

                                    if (statusUpper.contains("PENDING") || statusUpper.contains("SEARCHING")) {
                                        txtStatus.setText(isEmergencyReq ? "🚨 EMERGENCY PENDING" : "PENDING");
                                        txtStatus.setBackgroundResource(isEmergencyReq ? R.drawable.bg_chip_status_critical : R.drawable.bg_chip_status_pending);
                                        txtStatus.setTextColor(ContextCompat.getColor(this, isEmergencyReq ? R.color.status_critical_text : R.color.status_low_text));
                                    } else if (statusUpper.equals("VERIFIED") || statusUpper.equals("ACCEPTED")) {
                                        txtStatus.setText("VERIFIED");
                                        txtStatus.setBackgroundResource(R.drawable.bg_chip_status_reserved);
                                        txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_reserved_text));
                                    } else if (statusUpper.equals("ALLOCATED")) {
                                        txtStatus.setText("ALLOCATED");
                                        txtStatus.setBackgroundResource(R.drawable.bg_chip_status_reserved);
                                        txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_reserved_text));
                                    } else if (statusUpper.equals("DISPATCHED")) {
                                        txtStatus.setText("DISPATCHED");
                                        txtStatus.setBackgroundResource(R.drawable.bg_chip_status_reserved);
                                        txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_reserved_text));
                                    } else if (statusUpper.contains("TRANSIT") || statusUpper.equals("IN_TRANSIT")) {
                                        txtStatus.setText("IN TRANSIT");
                                        txtStatus.setBackgroundResource(R.drawable.bg_chip_status_reserved);
                                        txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_reserved_text));
                                    } else if (statusUpper.contains("FULFIL") || statusUpper.contains("COMPLET")) {
                                        txtStatus.setText("FULFILLED");
                                        txtStatus.setBackgroundResource(R.drawable.bg_chip_status_available);
                                        txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_available_text));
                                    } else if (statusUpper.contains("REJECT")) {
                                        txtStatus.setText("REJECTED");
                                        txtStatus.setBackgroundResource(R.drawable.bg_chip_status_critical);
                                        txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_critical_text));
                                    } else {
                                        txtStatus.setText("CANCELLED");
                                        txtStatus.setBackgroundResource(R.drawable.bg_chip_status_pending);
                                        txtStatus.setTextColor(ContextCompat.getColor(this, R.color.text_tertiary));
                                    }

                                    RelativeLayout.LayoutParams statusLp = new RelativeLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                                    statusLp.addRule(RelativeLayout.ALIGN_PARENT_END);
                                    statusLp.addRule(RelativeLayout.CENTER_VERTICAL);
                                    txtStatus.setLayoutParams(statusLp);

                                    topRow.addView(txtHosp);
                                    topRow.addView(txtStatus);
                                    card.addView(topRow);

                                    LinearLayout detailsRow = new LinearLayout(this);
                                    detailsRow.setOrientation(LinearLayout.HORIZONTAL);
                                    detailsRow.setGravity(android.view.Gravity.CENTER_VERTICAL);
                                    LinearLayout.LayoutParams dtLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                                    dtLp.topMargin = 10;
                                    detailsRow.setLayoutParams(dtLp);

                                    TextView txtBlood = new TextView(this);
                                    txtBlood.setText(String.format(Locale.US, "%s • %d Units %s", bGroup, qty, comp));
                                    txtBlood.setTextColor(0xFF38BDF8);
                                    txtBlood.setTextSize(16f);
                                    txtBlood.setTypeface(null, android.graphics.Typeface.BOLD);

                                    TextView txtUrgency = new TextView(this);
                                    txtUrgency.setText(isEmergencyReq ? "🚨 HIGH PRIORITY" : urgency.toUpperCase(Locale.US));
                                    txtUrgency.setTextSize(10f);
                                    txtUrgency.setTypeface(null, android.graphics.Typeface.BOLD);
                                    txtUrgency.setPadding(14, 4, 14, 4);

                                    if (isEmergencyReq) {
                                        txtUrgency.setBackgroundResource(R.drawable.bg_chip_status_critical);
                                        txtUrgency.setTextColor(ContextCompat.getColor(this, R.color.status_critical_text));
                                    } else {
                                        txtUrgency.setBackgroundResource(R.drawable.bg_chip_status_available);
                                        txtUrgency.setBackgroundResource(R.drawable.bg_chip_status_available);
                                        txtUrgency.setTextColor(ContextCompat.getColor(this, R.color.status_available_text));
                                    }
                                    LinearLayout.LayoutParams urgLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                                    urgLp.leftMargin = 14;
                                    urgLp.leftMargin = 14;
                                    txtUrgency.setLayoutParams(urgLp);

                                    detailsRow.addView(txtBlood);
                                    detailsRow.addView(txtUrgency);
                                    card.addView(detailsRow);

                                    // Subtitle
                                    TextView txtInfo = new TextView(this);
                                    String noteStr = !notes.isEmpty() ? " • " + notes : "";
                                    if (matchedDonorName != null && !matchedDonorName.isEmpty()) {
                                         final String fMatchedDonorId = doc.getString("matchedDonorId");
                                         final String fMatchedDonorName = matchedDonorName;
                                         final String fMatchedDonorGroup = matchedDonorGroup != null ? matchedDonorGroup : bGroup;
                                         final String fMatchedDonorStatus = matchedDonorStatus != null ? matchedDonorStatus : "AVAILABLE";

                                         LinearLayout donorCard = new LinearLayout(this);
                                         donorCard.setOrientation(LinearLayout.VERTICAL);
                                         donorCard.setBackgroundResource(R.drawable.bg_card_donor);
                                         donorCard.setPadding(22, 18, 22, 18);
                                         LinearLayout.LayoutParams dcLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                                         dcLp.topMargin = 12;
                                         donorCard.setLayoutParams(dcLp);

                                         RelativeLayout donorTop = new RelativeLayout(this);
                                         donorTop.setLayoutParams(new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));

                                         TextView txtDonorHeader = new TextView(this);
                                         String distStr = matchedDistance != null ? String.format(Locale.US, " (%.1f KM away)", matchedDistance) : "";
                                         txtDonorHeader.setText("🧑 Matched Life Saver Responded" + distStr);
                                         txtDonorHeader.setTextColor(ContextCompat.getColor(this, R.color.white));
                                         txtDonorHeader.setTextSize(13f);
                                         txtDonorHeader.setTypeface(null, android.graphics.Typeface.BOLD);

                                         TextView txtDonorStatusBadge = new TextView(this);
                                         txtDonorStatusBadge.setText(fMatchedDonorStatus);
                                         txtDonorStatusBadge.setTextSize(10f);
                                         txtDonorStatusBadge.setTypeface(null, android.graphics.Typeface.BOLD);
                                         txtDonorStatusBadge.setPadding(12, 4, 12, 4);

                                         if ("SELECTED".equalsIgnoreCase(fMatchedDonorStatus)) {
                                             txtDonorStatusBadge.setText("⭐ SELECTED");
                                             txtDonorStatusBadge.setBackgroundResource(R.drawable.bg_chip_status_verified);
                                             txtDonorStatusBadge.setTextColor(ContextCompat.getColor(this, R.color.status_verified_text));
                                         } else if ("COMPLETED".equalsIgnoreCase(fMatchedDonorStatus)) {
                                             txtDonorStatusBadge.setText("✓ COMPLETED");
                                             txtDonorStatusBadge.setBackgroundResource(R.drawable.bg_chip_status_available);
                                             txtDonorStatusBadge.setTextColor(ContextCompat.getColor(this, R.color.status_available_text));
                                         } else {
                                             txtDonorStatusBadge.setText("🟢 AVAILABLE");
                                             txtDonorStatusBadge.setBackgroundResource(R.drawable.bg_chip_status_available);
                                             txtDonorStatusBadge.setTextColor(ContextCompat.getColor(this, R.color.status_available_text));
                                         }

                                         RelativeLayout.LayoutParams dsbLp = new RelativeLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                                         dsbLp.addRule(RelativeLayout.ALIGN_PARENT_END);
                                         dsbLp.addRule(RelativeLayout.CENTER_VERTICAL);
                                         txtDonorStatusBadge.setLayoutParams(dsbLp);

                                         donorTop.addView(txtDonorHeader);
                                         donorTop.addView(txtDonorStatusBadge);
                                         donorCard.addView(donorTop);

                                         TextView txtDonorSub = new TextView(this);
                                         txtDonorSub.setText("Donor: " + fMatchedDonorName + " • Blood Group: " + fMatchedDonorGroup);
                                         txtDonorSub.setTextColor(0xFF38BDF8);
                                         txtDonorSub.setTextSize(12f);
                                         LinearLayout.LayoutParams dsbSubLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                                         dsbSubLp.topMargin = 4;
                                         txtDonorSub.setLayoutParams(dsbSubLp);
                                         donorCard.addView(txtDonorSub);

                                         if ("AVAILABLE".equalsIgnoreCase(fMatchedDonorStatus)) {
                                             TextView btnSelectDonor = new TextView(this);
                                             btnSelectDonor.setText("⭐ Select Donor for Emergency Transfusion");
                                             btnSelectDonor.setTextColor(ContextCompat.getColor(this, R.color.white));
                                             btnSelectDonor.setTextSize(12f);
                                             btnSelectDonor.setTypeface(null, android.graphics.Typeface.BOLD);
                                             btnSelectDonor.setGravity(android.view.Gravity.CENTER);
                                             btnSelectDonor.setBackgroundResource(R.drawable.bg_button_donor);
                                             LinearLayout.LayoutParams sdBtLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 76);
                                             sdBtLp.topMargin = 10;
                                             btnSelectDonor.setLayoutParams(sdBtLp);
                                             btnSelectDonor.setOnClickListener(v -> {
                                                 Map<String, Object> reqUpd = new HashMap<>();
                                                 reqUpd.put("donorStatus", "SELECTED");
                                                 FirebaseFirestore.getInstance().collection("bloodRequests").document(reqId).update(reqUpd);

                                                 if (fMatchedDonorId != null && !fMatchedDonorId.isEmpty()) {
                                                     String respId = "RESP-" + reqId + "-" + fMatchedDonorId;
                                                     FirebaseFirestore.getInstance().collection("donorEmergencyResponses").document(respId).update("responseStatus", "SELECTED");

                                                     String notifId = "NOTIF-DNR-SEL-" + System.currentTimeMillis();
                                                     Map<String, Object> dNotif = new HashMap<>();
                                                     dNotif.put("notificationId", notifId);
                                                     dNotif.put("donorAuthUid", fMatchedDonorId);
                                                     dNotif.put("targetUserId", fMatchedDonorId);
                                                     dNotif.put("targetRole", "DONOR");
                                                     dNotif.put("title", "⭐ Selected for Emergency Transfusion!");
                                                     dNotif.put("message", "You have been selected for the emergency request by " + bankName + ". Please proceed to the facility.");
                                                     dNotif.put("type", "DONOR_SELECTED");
                                                     dNotif.put("requestId", reqId);
                                                     dNotif.put("createdAt", new SimpleDateFormat("dd MMM yyyy, hh:mm a", Locale.US).format(new Date()));
                                                     dNotif.put("timestamp", System.currentTimeMillis());
                                                     dNotif.put("isRead", false);
                                                     dNotif.put("read", false);
                                                     FirebaseFirestore.getInstance().collection("notifications").document(notifId).set(dNotif);
                                                 }

                                                 Toast.makeText(this, "Donor " + fMatchedDonorName + " selected for emergency transfusion.", Toast.LENGTH_SHORT).show();
                                             });
                                             donorCard.addView(btnSelectDonor);
                                         } else if ("SELECTED".equalsIgnoreCase(fMatchedDonorStatus)) {
                                             TextView btnCompleteDonation = new TextView(this);
                                             btnCompleteDonation.setText("✓ Mark Emergency Donation Completed");
                                             btnCompleteDonation.setTextColor(ContextCompat.getColor(this, R.color.white));
                                             btnCompleteDonation.setTextSize(12f);
                                             btnCompleteDonation.setTypeface(null, android.graphics.Typeface.BOLD);
                                             btnCompleteDonation.setGravity(android.view.Gravity.CENTER);
                                             btnCompleteDonation.setBackgroundResource(R.drawable.bg_button_hospital);
                                             LinearLayout.LayoutParams cdBtLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 76);
                                             cdBtLp.topMargin = 10;
                                             btnCompleteDonation.setLayoutParams(cdBtLp);
                                             btnCompleteDonation.setOnClickListener(v -> {
                                                 String todayDate = new SimpleDateFormat("dd MMM yyyy", Locale.US).format(new Date());
                                                 Map<String, Object> reqUpd = new HashMap<>();
                                                 reqUpd.put("donorStatus", "COMPLETED");
                                                 FirebaseFirestore.getInstance().collection("bloodRequests").document(reqId).update(reqUpd);

                                                 if (fMatchedDonorId != null && !fMatchedDonorId.isEmpty()) {
                                                     String respId = "RESP-" + reqId + "-" + fMatchedDonorId;
                                                     FirebaseFirestore.getInstance().collection("donorEmergencyResponses").document(respId).update("responseStatus", "COMPLETED");

                                                     FirebaseFirestore.getInstance().collection("users").document(fMatchedDonorId)
                                                         .update("lastDonationDate", todayDate, "totalDonations", FieldValue.increment(1));

                                                     String notifId = "NOTIF-DNR-CMP-" + System.currentTimeMillis();
                                                     Map<String, Object> dNotif = new HashMap<>();
                                                     dNotif.put("notificationId", notifId);
                                                     dNotif.put("donorAuthUid", fMatchedDonorId);
                                                     dNotif.put("targetUserId", fMatchedDonorId);
                                                     dNotif.put("targetRole", "DONOR");
                                                     dNotif.put("title", "🎉 Lifesaving Donation Completed!");
                                                     dNotif.put("message", "Your emergency donation was successfully recorded. Thank you for being a hero!");
                                                     dNotif.put("type", "DONATION_COMPLETED");
                                                     dNotif.put("requestId", reqId);
                                                     dNotif.put("createdAt", todayDate);
                                                     dNotif.put("timestamp", System.currentTimeMillis());
                                                     dNotif.put("isRead", false);
                                                     dNotif.put("read", false);
                                                     dNotif.put("targetRole", "DONOR");
                                                     dNotif.put("title", "🎉 Lifesaving Donation Completed!");
                                                     dNotif.put("message", "Your emergency donation was successfully recorded. Thank you for being a hero!");
                                                     dNotif.put("type", "DONATION_COMPLETED");
                                                     dNotif.put("requestId", reqId);
                                                     dNotif.put("createdAt", todayDate);
                                                     dNotif.put("timestamp", System.currentTimeMillis());
                                                     dNotif.put("isRead", false);
                                                     dNotif.put("read", false);
                                                     FirebaseFirestore.getInstance().collection("notifications").document(notifId).set(dNotif);
                                                 }

                                                 Toast.makeText(this, "Emergency donation marked as COMPLETED!", Toast.LENGTH_SHORT).show();
                                             });
                                             donorCard.addView(btnCompleteDonation);
                                         }

                                         card.addView(donorCard);
                                     }

                                    // If matched donor exists
                                    }

                                    // Timeline
                                    card.addView(buildRequestTimelineView(status));

                                    // Blood Bank Actions
                                    if (statusUpper.contains("PENDING") || statusUpper.contains("SEARCHING")) {
                                        LinearLayout actRow = new LinearLayout(this);
                                        actRow.setOrientation(LinearLayout.HORIZONTAL);
                                        LinearLayout.LayoutParams actLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 84);
                                        actLp.topMargin = 16;
                                        actRow.setLayoutParams(actLp);

                                        TextView btnVerify = new TextView(this);
                                        btnVerify.setText("✓ Verify");
                    // TAB 1: Donor Appointments Management
                    if (txtTitle != null) txtTitle.setText("Donor Appointments");
                    if (txtSubtitle != null) txtSubtitle.setText("Manage scheduled donor appointments and record completed donations");
                    if (txtEmptyTitle != null) txtEmptyTitle.setText("No Donor Appointments");
                    if (txtEmptyDesc != null) txtEmptyDesc.setText("No scheduled donor appointments found for " + bankName + ".");

                    try {
                        if (bloodBankDonorAppointmentsListener != null) {
                            bloodBankDonorAppointmentsListener.remove();
                            bloodBankDonorAppointmentsListener = null;
            if (txtBadge != null) txtBadge.setText("Facility ID: " + bankId);
        } else if (currentRole == UserRole.HOSPITAL) {
            if (txtRole != null) txtRole.setText("Verified Healthcare Center");
            if (txtBadge != null) txtBadge.setText("Hospital ID: " + uid);
        } else {
            if (txtRole != null) txtRole.setText("Verified Donor Account");
            if (txtBadge != null) txtBadge.setText("Donor ID: " + uid);
        }
        if (txtEmail != null) txtEmail.setText(email);
        if (txtPhone != null) txtPhone.setText(phone);
        if (txtAddress != null) txtAddress.setText(address);
        if (txtCoords != null) txtCoords.setText(String.format(Locale.US, "GPS: %.4f° N, %.4f° E", profileLat, profileLng));

        if (btnEdit != null) {
            btnEdit.setOnClickListener(v -> showEditHospitalProfileDialog());
        }

        SwitchCompat switchDarkMode = view.findViewById(R.id.switch_dark_mode);
        if (switchDarkMode != null) {
            int currentMode = AppCompatDelegate.getDefaultNightMode();
            switchDarkMode.setChecked(currentMode == AppCompatDelegate.MODE_NIGHT_YES);

            switchDarkMode.setOnCheckedChangeListener((buttonView, isChecked) -> {
                AppCompatDelegate.setDefaultNightMode(
                        isChecked ? AppCompatDelegate.MODE_NIGHT_YES : AppCompatDelegate.MODE_NIGHT_NO
                );
            });
        }

        View btnLogout = view.findViewById(R.id.btn_profile_logout);
        if (btnLogout != null) btnLogout.setOnClickListener(v -> handleUserLogout());
    }

    private void attachRoleBackgroundAnimators(View view) {
        if (view == null) return;
        View glowView = view.findViewById(R.id.bg_glow_bank_dash_purple);
        View overlayView = view.findViewById(R.id.bg_nodes_bank_dash);

        if (glowView != null) {
            android.animation.ObjectAnimator pulseGlow = android.animation.ObjectAnimator.ofFloat(glowView, "alpha", 0.50f, 0.95f, 0.50f);
            pulseGlow.setDuration(4000);
            pulseGlow.setRepeatCount(android.animation.ValueAnimator.INFINITE);
            pulseGlow.start();
        }
        if (overlayView != null) {
            android.animation.ObjectAnimator transOverlay = android.animation.ObjectAnimator.ofFloat(overlayView, "translationY", -10f, 10f, -10f);
            transOverlay.setDuration(7800);
            transOverlay.setRepeatCount(android.animation.ValueAnimator.INFINITE);
            transOverlay.start();
        }
    }

    private void bindOnboardingView(View view) {
        TextView btnNext = view.findViewById(R.id.btn_onboarding_next);
        TextView btnSkip = view.findViewById(R.id.btn_onboarding_skip);
        TextView title = view.findViewById(R.id.onboarding_title);
        TextView desc = view.findViewById(R.id.onboarding_description);

        if (btnNext != null) {
            btnNext.setOnClickListener(v -> {
                onboardingStep++;
                if (onboardingStep == 2) {
                    if (title != null) title.setText("Connect Hospitals & Blood Banks");
                    if (desc != null) desc.setText("Seamless real-time inventory sharing between healthcare centers and emergency dispatchers.");
                } else if (onboardingStep == 3) {
                    if (title != null) title.setText("Smart Emergency Coordination");
                    if (desc != null) desc.setText("AI-driven proximity matching ensuring zero delay in life-saving transfusions.");
                    btnNext.setText("Get Started 🚀");
                } else {
                    onboardingStep = 1;
                    loadHomeDashboardForRole();
                }
            });
        }

        if (btnSkip != null) btnSkip.setOnClickListener(v -> loadHomeDashboardForRole());
    }

    private void bindAuditLogsView(View view) {}

    // DIALOG POPUPS FOR V2 INTELLIGENCE FEATURES

    private void showAIAssistantDialog() {
        Dialog dialog = new Dialog(this);
        dialog.setContentView(R.layout.dialog_ai_assistant);
        if (dialog.getWindow() != null) {
            dialog.getWindow().setLayout(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        }

        TextView txtResponse = dialog.findViewById(R.id.ai_response_text);
        EditText inputQuery = dialog.findViewById(R.id.input_ai_query);
        View btnSend = dialog.findViewById(R.id.btn_send_ai_query);
        View btnClose = dialog.findViewById(R.id.btn_close_ai_dialog);

        View chipCritical = dialog.findViewById(R.id.chip_ai_critical);
        View chipExpiring = dialog.findViewById(R.id.chip_ai_expiring);
        View chipRequests = dialog.findViewById(R.id.chip_ai_requests);

        if (chipCritical != null) {
            chipCritical.setOnClickListener(v -> {
                if (txtResponse != null) txtResponse.setText(AIAssistantEngine.generateResponse("Which blood groups are critical?"));
            });
        }

        if (chipExpiring != null) {
            chipExpiring.setOnClickListener(v -> {
                if (txtResponse != null) txtResponse.setText(AIAssistantEngine.generateResponse("Which units expire soon?"));
            });
        }

        if (chipRequests != null) {
            chipRequests.setOnClickListener(v -> {
                if (txtResponse != null) txtResponse.setText(AIAssistantEngine.generateResponse("How many emergency requests are pending?"));
            });

                                    TextView txtStatus = new TextView(this);
                                    txtStatus.setTextSize(11f);
                                    txtStatus.setTypeface(null, android.graphics.Typeface.BOLD);
                                    txtStatus.setPadding(18, 6, 18, 6);

                                    if (statusUpper.contains("PENDING")) {
                                        txtStatus.setText("⏳ PENDING APPROVAL");
                                        txtStatus.setBackgroundResource(R.drawable.bg_chip_status_pending);
                                        txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_low_text));
                                    } else if (statusUpper.contains("CONFIRM") || statusUpper.contains("ACCEPT")) {
                                        txtStatus.setText("✓ CONFIRMED");
                                        txtStatus.setBackgroundResource(R.drawable.bg_chip_status_reserved);
                                        txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_reserved_text));
                                    } else if (statusUpper.contains("COMPLET")) {
                                        txtStatus.setText("✓ COMPLETED");
                                        txtStatus.setBackgroundResource(R.drawable.bg_chip_status_available);
                                        txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_available_text));
                                    } else if (statusUpper.contains("REJECT")) {
                                        txtStatus.setText("✕ REJECTED");
                                        txtStatus.setBackgroundResource(R.drawable.bg_chip_status_critical);
                                        txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_critical_text));
                                    } else {
                                        txtStatus.setText("CANCELLED");
