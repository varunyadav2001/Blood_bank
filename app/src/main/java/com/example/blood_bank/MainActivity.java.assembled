                            }
                            if (txtTimeline2 != null) {
                                txtTimeline2.setText("✓ Step 2: Blood Bank Allocated • " + assigned);
                        txtDist.setTypeface(null, android.graphics.Typeface.BOLD);
                        txtDist.setBackgroundResource(R.drawable.bg_chip_status_available);
