    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        EdgeToEdge.enable(this);
        setContentView(R.layout.activity_main);

        fusedLocationClient = LocationServices.getFusedLocationProviderClient(this);
        try {
            com.google.android.gms.maps.MapsInitializer.initialize(getApplicationContext());
        } catch (Exception ignored) {}

        View mainRoot = findViewById(R.id.main_root);
        View topAppBar = findViewById(R.id.top_app_bar);
        View bottomNav = findViewById(R.id.bottom_navigation);

        if (mainRoot != null) {
            ViewCompat.setOnApplyWindowInsetsListener(mainRoot, (v, insets) -> {
                Insets systemBars = insets.getInsets(WindowInsetsCompat.Type.systemBars());
                if (topAppBar != null) {
                    topAppBar.setPadding(
                            topAppBar.getPaddingLeft(),
                            systemBars.top + 8,
                            topAppBar.getPaddingRight(),
                            12
                    );
                }
                if (bottomNav != null) {
                    bottomNav.setPadding(
                            bottomNav.getPaddingLeft(),
                            8,
                            bottomNav.getPaddingRight(),
                            systemBars.bottom + 8
                    );
                }
                return WindowInsetsCompat.CONSUMED;
            });
        }

        fragmentContainer = findViewById(R.id.fragment_container);
        activeRoleBadge = findViewById(R.id.txt_active_role_badge);
        topBarSubtitle = findViewById(R.id.top_bar_subtitle);
        bottomNavigationView = findViewById(R.id.bottom_navigation);

        setupTopBarActions();

        // Strict Firebase Authentication session state check
        // Auto-login persistence check with Firebase Auth & Profile validation
        FirebaseUser firebaseUser = FirebaseAuth.getInstance().getCurrentUser();
        if (firebaseUser != null && firebaseUser.getEmail() != null) {
            final String fbEmail = firebaseUser.getEmail();
            final String fbUid = firebaseUser.getUid();
            UserProfile cached = repository.getUserProfileByEmail(fbEmail);
            try {
                FirebaseFirestore.getInstance().collection("users").document(fbUid).get()
                    .addOnCompleteListener(task -> {
                        String role = cached != null ? cached.getRole() : "DONOR";
                        String name = cached != null ? cached.getDisplayName() : "User";
                        String bbId = cached != null ? cached.getBloodBankId() : ("BB-" + fbUid.substring(0, Math.min(8, fbUid.length())));
                        String city = cached != null ? cached.getCity() : "Sangli";
                        String address = city + ", Maharashtra";
                        String phone = cached != null ? cached.getMobileNumber() : "";
                        String bloodGroup = cached != null ? cached.getBloodGroup() : "O+";
                        String lastDonation = cached != null ? cached.getLastDonationDate() : "Not donated yet";
                        int totalDonations = cached != null ? cached.getTotalDonations() : 0;
                            if (doc.getString("phone") != null) phone = doc.getString("phone");
                        }

                        UserProfile profile = new UserProfile(fbUid, fbEmail, phone, name, role, true, true, name, city);
                        profile.setBloodBankId(bbId);
                        profile.setLocationAddress(address);
                        repository.setCurrentUser(profile);
                        repository.saveUserProfile(profile);

                        android.util.Log.d("SmartBloodAuth", "================ AUTO-LOGIN USER ================");
                        android.util.Log.d("SmartBloodAuth", "LOGIN USER: " + fbEmail + " (UID: " + fbUid + ")");
                        android.util.Log.d("SmartBloodAuth", "BLOOD BANK ID: " + bbId);
                        android.util.Log.d("SmartBloodAuth", "NAME: " + name);

                        final String finalBankId = bbId;
                if (cached != null) {
                    repository.setCurrentUser(cached);
                    setRoleFromProfile(cached);
                } else {
                                .addOnSuccessListener(bSnap -> {
                                    if (bSnap != null && bSnap.exists() && bSnap.contains("bloodStock")) {
                                        Map<String, Integer> bStock = extractStockMapFromDoc(bSnap);
                                        int bTotal = 0;
                                        for (int v : bStock.values()) bTotal += v;
                                        android.util.Log.d("SmartBloodAuth", "ON LOGIN: LOADED FIREBASE VALUE: " + bStock);
                                        for (SmartMapItem item : smartMapItemList) {
                                            if ("BLOOD_BANK".equalsIgnoreCase(item.type) && 
                                                (item.id.equalsIgnoreCase(finalBankId) || (item.name != null && item.name.equalsIgnoreCase(finalBankName)))) {
                                                item.stockMap = bStock;
                                                item.totalUnits = bTotal;
                                                break;
                                            }
                                        }
                                    }
                                    setRoleFromProfile(profile);
                                })
                                .addOnFailureListener(err -> setRoleFromProfile(profile));
                        } else {
                            setRoleFromProfile(profile);
                        }
                    })
                    .addOnFailureListener(e -> loadLoginScreen());
            } catch (Exception e) {
                if (cached != null) {
                    repository.setCurrentUser(cached);
                    setRoleFromProfile(cached);
                } else {
                    loadLoginScreen();
                }
            }
        } else {
            repository.signOutUser();
            loadLoginScreen();
        }
    }

    private void loadLoginScreen() {
        if (bottomNavigationView != null) bottomNavigationView.setVisibility(View.GONE);
        if (activeRoleBadge != null) activeRoleBadge.setText("Sign In Required");
        if (topBarSubtitle != null) topBarSubtitle.setText("Select Workspace Portal");
        loadView(R.layout.view_auth_role_select, this::bindRoleSelectView);
    }

    public void setRoleFromProfile(UserProfile profile) {
        if (profile == null || profile.getRole() == null) {
            loadLoginScreen();
            return;
        }

        String roleStr = profile.getRole().toLowerCase();
                    activeRoleBadge.setBackgroundResource(R.drawable.bg_chip_hospital_verified);
                    if (topBarSubtitle != null) topBarSubtitle.setText(orgName + " • Healthcare Center");
                    break;
                case BLOOD_BANK:
                    activeRoleBadge.setBackgroundResource(R.drawable.bg_chip_bloodbank_verified);
                    if (topBarSubtitle != null) topBarSubtitle.setText(orgName + " • Reserve Operations");
                    break;
                case ADMIN:
                    activeRoleBadge.setBackgroundResource(R.drawable.bg_chip_status_verified);
                    if (topBarSubtitle != null) topBarSubtitle.setText(orgName + " • Admin Console");
                    break;
            }
        } else if (topBarSubtitle != null) {
            topBarSubtitle.setText(orgName + " Workspace");
        }
    }

    private void updateBottomMenuForRole(UserRole role) {
        if (bottomNavigationView == null) return;
        bottomNavigationView.setVisibility(View.VISIBLE);
        bottomNavigationView.getMenu().clear();

        switch (role) {
            case DONOR:
                bottomNavigationView.inflateMenu(R.menu.menu_donor);
                break;
            case HOSPITAL:
                bottomNavigationView.inflateMenu(R.menu.menu_hospital);
                break;
            case BLOOD_BANK:
                bottomNavigationView.inflateMenu(R.menu.menu_bloodbank);
                break;
            case ADMIN:
                bottomNavigationView.inflateMenu(R.menu.menu_admin);
                break;
        }

        setupBottomNavigationListeners();
    }
        loadHomeDashboardForRole();
    }

    private void updateRoleUI(UserProfile profile) {
        String roleName = profile != null ? profile.getRole().toUpperCase() : currentRole.name();
        String orgName = profile != null ? profile.getDisplayName() : "SmartBlood User";

        if (activeRoleBadge != null) {
            activeRoleBadge.setText("Role: " + roleName);
            switch (currentRole) {
                case DONOR:
                    activeRoleBadge.setBackgroundResource(R.drawable.bg_chip_donor_verified);
                    if (topBarSubtitle != null) topBarSubtitle.setText(orgName + " • Blood Donor Workspace");
                    break;
                case HOSPITAL:
                    activeRoleBadge.setBackgroundResource(R.drawable.bg_chip_hospital_verified);
                    if (topBarSubtitle != null) topBarSubtitle.setText(orgName + " • Healthcare Center");
                    break;
                case BLOOD_BANK:
                    activeRoleBadge.setBackgroundResource(R.drawable.bg_chip_bloodbank_verified);
                    if (topBarSubtitle != null) topBarSubtitle.setText(orgName + " • Reserve Operations");
                    break;
                case ADMIN:
                    activeRoleBadge.setBackgroundResource(R.drawable.bg_chip_status_verified);
                    if (topBarSubtitle != null) topBarSubtitle.setText(orgName + " • Admin Console");
                    break;
            }
        } else if (topBarSubtitle != null) {
            topBarSubtitle.setText(orgName + " Workspace");
        }
    }

