        } else if (currentRole == UserRole.BLOOD_BANK) {
            if (avatar != null) {
                avatar.setImageResource(R.drawable.ic_blood_bank);
                avatar.setColorFilter(0xFF38BDF8);
            }
            if (txtRole != null) txtRole.setText("Verified Regional Blood Center");
            String bankId = selectedBloodBank != null ? selectedBloodBank.id : (currentUser != null && currentUser.getBloodBankId() != null ? currentUser.getBloodBankId() : uid);
            if (txtBadge != null) txtBadge.setText("Facility ID: " + bankId);
            if (txtSectionTitle != null) txtSectionTitle.setText("Facility Information");
            if (layoutDonorExtra != null) layoutDonorExtra.setVisibility(View.GONE);
            if (layoutHistorySection != null) layoutHistorySection.setVisibility(View.GONE);
            if (btnEdit != null) {
                btnEdit.setText("✏️ Edit Blood Bank Information");
                btnEdit.setBackgroundResource(R.drawable.bg_button_hospital);
                btnEdit.setOnClickListener(v -> showEditHospitalProfileDialog());
            }
        } else {
            if (avatar != null) {
                avatar.setImageResource(R.drawable.ic_hospital);
                avatar.setColorFilter(0xFF38BDF8);
            }
            if (txtRole != null) txtRole.setText("Verified Healthcare Center");
            if (txtBadge != null) txtBadge.setText("Hospital ID: " + uid);
