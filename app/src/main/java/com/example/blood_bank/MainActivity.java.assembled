    private void loadView(int layoutResId, ViewBinder binder) {
        cleanupHospitalListeners();
        cleanupBankListeners();

            return;
        }

        switch (currentRole) {
            case DONOR:
                loadView(R.layout.view_donor_dashboard_v2, this::bindDonorDashboardV2);
                break;
            case HOSPITAL:
                loadView(R.layout.view_hospital_dashboard_v2, this::bindHospitalDashboardV2);
                break;
            case BLOOD_BANK:
                loadView(R.layout.view_blood_bank_dashboard_v2, this::bindBloodBankDashboardV2);
                break;
            case ADMIN:
                loadView(R.layout.view_admin_dashboard_v2, this::bindAdminDashboardV2);
                break;
        }
    }

    private interface ViewBinder {
        void bind(View view);
    }

    private void loadView(int layoutResId, ViewBinder binder) {
        cleanupHospitalListeners();
        cleanupBankListeners();

        // Enforce logged-out protection for all protected views
        boolean isPublicView = (layoutResId == R.layout.view_auth_role_select ||
                                layoutResId == R.layout.view_auth_donor || 
                                layoutResId == R.layout.view_auth_hospital || 
                                layoutResId == R.layout.view_auth_bloodbank || 
                                layoutResId == R.layout.view_onboarding);

        if (!isPublicView && (repository.getCurrentUser() == null || FirebaseAuth.getInstance().getCurrentUser() == null)) {
            Toast.makeText(this, "Session expired or logged out. Please sign in.", Toast.LENGTH_SHORT).show();
            loadLoginScreen();
            return;
        }

        if (fragmentContainer == null) return;
            cardDonorLogin.setScaleX(0.97f);
            cardDonorLogin.setScaleY(0.97f);
            cardDonorLogin.setAlpha(0f);
            cardDonorLogin.animate().translationY(0f).scaleX(1.0f).scaleY(1.0f).alpha(1.0f).setDuration(480).setStartDelay(320).setInterpolator(new android.view.animation.DecelerateInterpolator()).start();
        }

        // STEP 6: Email field and Password field appear with a small staggered fade-in
        if (layoutEmailInput != null) {
            layoutEmailInput.setAlpha(0f);
            layoutEmailInput.animate().alpha(1.0f).setDuration(350).setStartDelay(440).start();
        }
        if (layoutPasswordInput != null) {
            layoutPasswordInput.setAlpha(0f);
            layoutPasswordInput.animate().alpha(1.0f).setDuration(350).setStartDelay(520).start();
        }
        TextView txtError = view.findViewById(R.id.donor_login_error_text);
        View heroIcon = view.findViewById(R.id.icon_donor_hero);
        View glowPulse = view.findViewById(R.id.glow_donor_pulse);
        View txtTitle = view.findViewById(R.id.txt_donor_login_title);
        View txtSubtitle = view.findViewById(R.id.txt_donor_login_subtitle);
        View cardDonorLogin = view.findViewById(R.id.card_donor_login);
        View layoutEmailInput = view.findViewById(R.id.layout_donor_email_input);
        View layoutPasswordInput = view.findViewById(R.id.layout_donor_password_input);

    private void loadDonorLoginScreen(String emailPrefill) {
        if (bottomNavigationView != null) bottomNavigationView.setVisibility(View.GONE);
        if (activeRoleBadge != null) activeRoleBadge.setText("Donor Portal");
        if (topBarSubtitle != null) topBarSubtitle.setText("Blood Donor Authentication");
        loadView(R.layout.view_auth_donor, view -> bindDonorLoginView(view, emailPrefill));
    }

    private void bindDonorLoginView(View view, String emailPrefill) {
        View btnBack = view.findViewById(R.id.btn_donor_login_back);
        EditText inputEmail = view.findViewById(R.id.input_donor_email);
        EditText inputPassword = view.findViewById(R.id.input_donor_password);
        TextView btnSubmit = view.findViewById(R.id.btn_donor_login_submit);
        TextView btnRegisterLink = view.findViewById(R.id.btn_donor_register_link);
        TextView btnForgotPassword = view.findViewById(R.id.btn_donor_forgot_password);
        TextView txtError = view.findViewById(R.id.donor_login_error_text);
        View heroIcon = view.findViewById(R.id.icon_donor_hero);
        View glowPulse = view.findViewById(R.id.glow_donor_pulse);
        View txtTitle = view.findViewById(R.id.txt_donor_login_title);
        View txtSubtitle = view.findViewById(R.id.txt_donor_login_subtitle);
        View cardDonorLogin = view.findViewById(R.id.card_donor_login);
        View layoutEmailInput = view.findViewById(R.id.layout_donor_email_input);
        View layoutPasswordInput = view.findViewById(R.id.layout_donor_password_input);

        View glowDonorCrimson = view.findViewById(R.id.bg_glow_donor_crimson);
        View glowDonorBlue = view.findViewById(R.id.bg_glow_donor_blue);

        if (glowDonorCrimson != null) {
            android.animation.ObjectAnimator pulseCrimson = android.animation.ObjectAnimator.ofFloat(glowDonorCrimson, "alpha", 0.4f, 0.85f, 0.4f);
            pulseCrimson.setDuration(3600);
            pulseCrimson.setRepeatCount(android.animation.ValueAnimator.INFINITE);
            pulseCrimson.start();

            android.animation.ObjectAnimator transCrimson = android.animation.ObjectAnimator.ofFloat(glowDonorCrimson, "translationY", -15f, 15f, -15f);
            transCrimson.setDuration(4800);
            transCrimson.setRepeatCount(android.animation.ValueAnimator.INFINITE);
            transCrimson.start();
        }

        if (glowDonorBlue != null) {
            android.animation.ObjectAnimator pulseBlue = android.animation.ObjectAnimator.ofFloat(glowDonorBlue, "alpha", 0.3f, 0.75f, 0.3f);
            pulseBlue.setDuration(4200);
            pulseBlue.setRepeatCount(android.animation.ValueAnimator.INFINITE);
            pulseBlue.start();

            android.animation.ObjectAnimator transBlue = android.animation.ObjectAnimator.ofFloat(glowDonorBlue, "translationY", 15f, -15f, 15f);
            transBlue.setDuration(5200);
            transBlue.setRepeatCount(android.animation.ValueAnimator.INFINITE);
            transBlue.start();
        }

        View waveDonor = view.findViewById(R.id.bg_wave_donor);
        if (waveDonor != null) {
            android.animation.ObjectAnimator waveAnim = android.animation.ObjectAnimator.ofFloat(waveDonor, "translationY", -12f, 12f, -12f);
            waveAnim.setDuration(7200);
            waveAnim.setRepeatCount(android.animation.ValueAnimator.INFINITE);
            waveAnim.start();
        }

        // STEP 1: Background smoothly fades in
        view.setAlpha(0f);
        view.animate().alpha(1.0f).setDuration(300).start();

        // STEP 2: Donor profile / blood-drop hero pulse & glow
        if (heroIcon != null) {
            heroIcon.setScaleX(0.9f);
            heroIcon.setScaleY(0.9f);
            heroIcon.setAlpha(0f);
            heroIcon.animate().alpha(1.0f).scaleX(1.0f).scaleY(1.0f).setDuration(400).setStartDelay(100).start();
        }
        if (glowPulse != null) {
            glowPulse.setAlpha(0.2f);
            glowPulse.animate().alpha(0.85f).scaleX(1.08f).scaleY(1.08f).setDuration(500).setStartDelay(100).start();
        }

        // STEP 3: "Blood Donor Login" title smoothly fades + slides upward a few pixels
        if (txtTitle != null) {
            txtTitle.setTranslationY(20f);
            txtTitle.setAlpha(0f);
            txtTitle.animate().translationY(0f).alpha(1.0f).setDuration(400).setStartDelay(150).setInterpolator(new android.view.animation.DecelerateInterpolator()).start();
        }

        // STEP 4: "Welcome back, Life Saver" subtitle appears with a slight delayed fade-in
        if (txtSubtitle != null) {
            txtSubtitle.setTranslationY(15f);
            txtSubtitle.setAlpha(0f);
            txtSubtitle.animate().translationY(0f).alpha(1.0f).setDuration(400).setStartDelay(250).setInterpolator(new android.view.animation.DecelerateInterpolator()).start();
        }

        // STEP 5: The login card smoothly appears (fade-in, slight upward movement, soft scale from 0.97 -> 1.0)
        if (cardDonorLogin != null) {
            cardDonorLogin.setTranslationY(30f);
            cardDonorLogin.setScaleX(0.97f);
            cardDonorLogin.setScaleY(0.97f);
            cardDonorLogin.setAlpha(0f);
            cardDonorLogin.animate().translationY(0f).scaleX(1.0f).scaleY(1.0f).alpha(1.0f).setDuration(480).setStartDelay(320).setInterpolator(new android.view.animation.DecelerateInterpolator()).start();
        }

        // STEP 6: Email field and Password field appear with a small staggered fade-in
        if (layoutEmailInput != null) {
            layoutEmailInput.setAlpha(0f);
            layoutEmailInput.animate().alpha(1.0f).setDuration(350).setStartDelay(440).start();
        }
        if (layoutPasswordInput != null) {
            layoutPasswordInput.setAlpha(0f);
            layoutPasswordInput.animate().alpha(1.0f).setDuration(350).setStartDelay(520).start();
        }

        // STEP 7: "Sign In to Donor Dashboard" button subtle one-time glow sweep / scale flash when screen loads
        if (btnSubmit != null) {
            btnSubmit.postDelayed(() -> {
                btnSubmit.animate().scaleX(1.03f).scaleY(1.03f).setDuration(180).withEndAction(() -> {
                    btnSubmit.animate().scaleX(1.0f).scaleY(1.0f).setDuration(180).start();
                }).start();
            }, 680);
        }

        if (emailPrefill != null && inputEmail != null) {
            inputEmail.setText(emailPrefill);
        }

        if (btnBack != null) btnBack.setOnClickListener(v -> loadLoginScreen());
        if (btnRegisterLink != null) btnRegisterLink.setOnClickListener(v -> showRegisterDonorDialog());
        if (btnForgotPassword != null) btnForgotPassword.setOnClickListener(v -> showForgotPasswordDialog());

        if (btnSubmit != null) {
            btnSubmit.setOnClickListener(v -> {
                String emailStr = inputEmail != null ? inputEmail.getText().toString().trim() : "";
                String pwdStr = inputPassword != null ? inputPassword.getText().toString().trim() : "";

                if (TextUtils.isEmpty(emailStr) || TextUtils.isEmpty(pwdStr)) {
                    showLoginError(txtError, btnSubmit, "Please enter your registered email and password.");
                    return;
                }

                if (txtError != null) txtError.setVisibility(View.GONE);
                btnSubmit.setEnabled(false);
                btnSubmit.setText("⏳ Signing in...");

                performRoleSpecificLogin(emailStr, pwdStr, UserRole.DONOR, txtError, btnSubmit);
            });
        }
    }

