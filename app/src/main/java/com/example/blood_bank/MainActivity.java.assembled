    private void performRoleSpecificLogin(String email, String password, UserRole expectedRole, TextView txtError, TextView btnSubmit) {
        if (TextUtils.isEmpty(email)) {
            showLoginError(txtError, btnSubmit, "Please enter a valid email.");
            return;
        }
        if (TextUtils.isEmpty(password)) {
            showLoginError(txtError, btnSubmit, "Please enter your password.");
            return;
        }

        if (btnSubmit != null) {
            btnSubmit.setEnabled(false);
            btnSubmit.setText("Signing in...");
        }
        if (txtError != null) txtError.setVisibility(View.GONE);

        try {
            FirebaseAuth auth = FirebaseAuth.getInstance();
            auth.signInWithEmailAndPassword(email, password)
                .addOnCompleteListener(this, task -> {
                    if (task.isSuccessful()) {
                        FirebaseUser fbUser = auth.getCurrentUser();
                        if (fbUser != null) {
                            String uid = fbUser.getUid();
                            handleSuccessfulAuthLogin(uid, email, expectedRole, txtError, btnSubmit);
                        } else {
                            showLoginError(txtError, btnSubmit, "Authentication failed. User session not found.");
                        }
                    } else {
                        Exception exc = task.getException();
                        UserProfile preSeeded = repository.getUserProfileByEmail(email);

                        if (preSeeded != null && preSeeded.getRole().toLowerCase().contains(expectedRole.name().toLowerCase())) {
                            // Account may not be in Firebase Auth yet -> create account with provided credentials
                            auth.createUserWithEmailAndPassword(email, password)
                                .addOnCompleteListener(createTask -> {
                                    if (createTask.isSuccessful() && auth.getCurrentUser() != null) {
                                        String newUid = auth.getCurrentUser().getUid();
                                        handleSuccessfulAuthLogin(newUid, email, expectedRole, txtError, btnSubmit);
                                    } else {
                                        String mappedError = mapFirebaseAuthError(task.getException(), expectedRole);
                                        showLoginError(txtError, btnSubmit, mappedError);
                                    }
                                });
                            return;
                        }

                        String mappedError = mapFirebaseAuthError(exc, expectedRole);
                        showLoginError(txtError, btnSubmit, mappedError);
                    }
                });
        } catch (Exception e) {
            showLoginError(txtError, btnSubmit, "Login failed: " + e.getMessage());
        }
    }

    private String mapFirebaseAuthError(Exception exc, UserRole expectedRole) {
        if (exc == null) return "Incorrect email or password.";
        String msg = exc.getMessage() != null ? exc.getMessage() : "";
        String msgLower = msg.toLowerCase(Locale.US);

        if (msgLower.contains("network") || msgLower.contains("network-request-failed") || msgLower.contains("unable to resolve host")) {
            return "Network error. Please check your internet connection.";
        }
    private void performRoleSpecificLogin(String email, String password, UserRole expectedRole, TextView txtError, TextView btnSubmit) {
        String cleanEmail = email != null ? email.trim().toLowerCase(Locale.US) : "";
        String rawPassword = password != null ? password : "";

        if (TextUtils.isEmpty(cleanEmail)) {
            showLoginError(txtError, btnSubmit, "Please enter a valid email.");
            return;
        }
        if (TextUtils.isEmpty(rawPassword)) {
            showLoginError(txtError, btnSubmit, "Please enter your password.");
            return;
        }

        if (btnSubmit != null) {
            btnSubmit.setEnabled(false);
            btnSubmit.setText("Signing in...");
        }
        if (txtError != null) txtError.setVisibility(View.GONE);

        try {
            FirebaseAuth auth = FirebaseAuth.getInstance();
            String currentProjectId = com.google.firebase.FirebaseApp.getInstance().getOptions().getProjectId();
            android.util.Log.d("SmartBloodAuth", "Firebase Project ID: " + currentProjectId);
            android.util.Log.d("SmartBloodAuth", "Attempting login with email: \"" + cleanEmail + "\"");

            auth.signInWithEmailAndPassword(cleanEmail, rawPassword)
                .addOnCompleteListener(this, task -> {
                    if (task.isSuccessful()) {
                        FirebaseUser fbUser = auth.getCurrentUser();
                        if (fbUser != null) {
                            String uid = fbUser.getUid();
                            android.util.Log.d("SmartBloodAuth", "signInWithEmailAndPassword SUCCESS for: " + cleanEmail + " | UID: " + uid);
                            handleSuccessfulAuthLogin(uid, cleanEmail, expectedRole, txtError, btnSubmit);
                        } else {
                            showLoginError(txtError, btnSubmit, "Authentication failed. User session not found.");
                        }
                    } else {
                        Exception exc = task.getException();
                        android.util.Log.e("SmartBloodAuth", "signInWithEmailAndPassword FAILED for " + cleanEmail + " | Error: " + (exc != null ? exc.getClass().getSimpleName() + " - " + exc.getMessage() : "null"));

                        UserProfile preSeeded = repository.getUserProfileByEmail(cleanEmail);

                        if (preSeeded != null && preSeeded.getRole().toLowerCase().contains(expectedRole.name().toLowerCase())) {
                            android.util.Log.d("SmartBloodAuth", "Attempting account auto-provision in Firebase Auth for: " + cleanEmail);
                            // Account not created in Firebase Auth yet -> create account with entered credentials
                            auth.createUserWithEmailAndPassword(cleanEmail, rawPassword)
                                .addOnCompleteListener(createTask -> {
                                    if (createTask.isSuccessful() && auth.getCurrentUser() != null) {
                                        String newUid = auth.getCurrentUser().getUid();
                                        android.util.Log.d("SmartBloodAuth", "createUserWithEmailAndPassword SUCCESS for: " + cleanEmail + " | UID: " + newUid);
                                        handleSuccessfulAuthLogin(newUid, cleanEmail, expectedRole, txtError, btnSubmit);
                                    } else {
                                        Exception createExc = createTask.getException();
                                        android.util.Log.e("SmartBloodAuth", "createUserWithEmailAndPassword failed: " + (createExc != null ? createExc.getClass().getSimpleName() + " - " + createExc.getMessage() : "null"));
                                        String mappedError = mapFirebaseAuthError(task.getException(), expectedRole);
                                        showLoginError(txtError, btnSubmit, mappedError);
                                    }
                                });
                            return;
                        }

                        String mappedError = mapFirebaseAuthError(exc, expectedRole);
                        showLoginError(txtError, btnSubmit, mappedError);
                    }
                });
        } catch (Exception e) {
            android.util.Log.e("SmartBloodAuth", "Login exception: " + e.getMessage());
            showLoginError(txtError, btnSubmit, "Login failed: " + e.getMessage());
        }
    }

    private String mapFirebaseAuthError(Exception exc, UserRole expectedRole) {
        if (exc == null) return "Incorrect email or password.";
        String msg = exc.getMessage() != null ? exc.getMessage() : "";
        String msgLower = msg.toLowerCase(Locale.US);

        if (msgLower.contains("network") || msgLower.contains("network-request-failed") || msgLower.contains("unable to resolve host")) {
            return "Network error. Please check your internet connection.";
        }
        if (msgLower.contains("too-many-requests") || msgLower.contains("too many requests")) {
            return "Too many login attempts. Please try again later.";
        }
        if (msgLower.contains("user-not-found") || msgLower.contains("no user record")) {
            String roleName = expectedRole == UserRole.BLOOD_BANK ? "Blood Bank" : (expectedRole == UserRole.HOSPITAL ? "Hospital" : "User");
            return "No " + roleName + " account found with this email.";
        }
        if (msgLower.contains("wrong-password") || msgLower.contains("invalid-password")) {
            return "Incorrect password.";
        }
        if (msgLower.contains("invalid-email") || msgLower.contains("badly formatted")) {
            return "Please enter a valid email address.";
        }
        if (msgLower.contains("invalid-credential") || msgLower.contains("invalid_credential")) {
            return "Incorrect email or password.";
        }
        return "Incorrect email or password.";
    }

