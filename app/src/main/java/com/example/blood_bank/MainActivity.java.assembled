    private void bindBloodBankDashboardV2(View view) {
        View glowPurple = view.findViewById(R.id.bg_glow_bank_dash_purple);
        View nodesBank = view.findViewById(R.id.bg_nodes_bank_dash);

        if (glowPurple != null) {
            android.animation.ObjectAnimator pulsePurple = android.animation.ObjectAnimator.ofFloat(glowPurple, "alpha", 0.50f, 0.95f, 0.50f);
                }
            }
            if (txtAlertLow != null) {
                if (!lowGroups.isEmpty()) {
                    txtAlertLow.setText("⏳ Low reserve groups (≤ " + LOW_STOCK_THRESHOLD + " units): " + TextUtils.join(", ", lowGroups));
                } else {
                    txtAlertLow.setText("✓ Low stock threshold set to ≤ " + LOW_STOCK_THRESHOLD + " units.");
                }
            }
            if (txtAlertInfo != null) {
                txtAlertInfo.setText("📋 " + bankName + " connected to live SmartBlood network.");
            }
        };

        // Fallback default stock data before Firestore sync
        Map<String, Integer> defaultStock = defaultStockForBank(bankName);
        for (SmartMapItem item : smartMapItemList) {
            if ("BLOOD_BANK".equalsIgnoreCase(item.type) && 
                (item.id.equalsIgnoreCase(currentBankId) || item.id.equalsIgnoreCase(currentUid) || (item.name != null && item.name.equalsIgnoreCase(bankName)))) {
                defaultStock = item.stockMap;
                break;
            }
        }
        renderStockData.accept(defaultStock);

        // Real-Time Firestore Snapshot Listener for authenticated Blood Bank
        if (progress != null) progress.setVisibility(View.VISIBLE);
        try {
            cleanupBankListeners();
        TextView txtLocation = view.findViewById(R.id.txt_bank_dash_location);
        ProgressBar progress = view.findViewById(R.id.loading_bank_progress);

        if (txtName != null) txtName.setText(bankName);
        if (txtSubtitle != null) txtSubtitle.setText("✓ Verified Reserve Dashboard • ID: " + currentBankId);
        if (txtLocation != null) txtLocation.setText("📍 " + address);

        // Header and Summary Stat references
        TextView txtStatTotal = view.findViewById(R.id.txt_bank_stat_total_units);
        TextView txtStatAvailable = view.findViewById(R.id.txt_bank_stat_available_units);
        TextView txtStatLowStock = view.findViewById(R.id.txt_bank_stat_low_stock);
        TextView txtStatOutOfStock = view.findViewById(R.id.txt_bank_stat_out_of_stock);

        // Header action handlers
        View btnSwitchFac = view.findViewById(R.id.btn_bank_switch_facility);
        View layoutHeaderInfo = view.findViewById(R.id.layout_bank_dash_header_info);
        View.OnClickListener switchFacListener = v -> {
            String[] idHolder = new String[]{currentBankId};
            String[] nameHolder = new String[]{bankName};
            Map<String, Integer>[] liveStockH = (Map<String, Integer>[]) new Map<?, ?>[]{defaultStockForBank(bankName)};
            showSelectBloodBankDialog(idHolder, nameHolder, liveStockH, () -> {
                loadView(R.layout.view_blood_bank_dashboard_v2, this::bindBloodBankDashboardV2);
            });
        };
        if (btnSwitchFac != null) btnSwitchFac.setOnClickListener(switchFacListener);
        if (layoutHeaderInfo != null) layoutHeaderInfo.setOnClickListener(switchFacListener);

        // Operations Stat references & Cards
        TextView txtStatPending = view.findViewById(R.id.txt_bank_stat_pending_requests);
        TextView txtStatEmergency = view.findViewById(R.id.txt_bank_stat_emergency_requests);
        TextView txtStatUnreadNotifs = view.findViewById(R.id.txt_bank_stat_unread_notifs);
        TextView txtStatActiveTransfers = view.findViewById(R.id.txt_bank_stat_active_transfers);

