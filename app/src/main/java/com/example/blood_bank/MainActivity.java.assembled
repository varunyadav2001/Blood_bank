        }).addOnFailureListener(e -> {
            Log.e("SmartBloodInventory", "FIREBASE QUERY: FAILED - " + e.getMessage(), e);
            Toast.makeText(this, "Failed to save stock: " + e.getMessage(), Toast.LENGTH_LONG).show();
        });
    }

    private View buildRequestTimelineView(String rawStatus) {
        String sUpper = rawStatus != null ? rawStatus.toUpperCase(Locale.US) : "PENDING";

        int currentStep = 1; // 1: Request Created, 2: Verified, 3: Blood Allocated, 4: Dispatched, 5: In Transit, 6: Fulfilled
        boolean isRejected = sUpper.contains("REJECT");
        boolean isCancelled = sUpper.contains("CANCEL");

        if (isRejected || isCancelled) {
            currentStep = 1;
        } else if (sUpper.contains("FULFIL") || sUpper.contains("COMPLET")) {
            currentStep = 6;
        } else if (sUpper.contains("TRANSIT") || sUpper.equals("IN_TRANSIT")) {
            currentStep = 5;
        } else if (sUpper.equals("DISPATCHED") || sUpper.contains("DISPATCH")) {
            currentStep = 4;
        } else if (sUpper.equals("ALLOCATED") || sUpper.contains("ALLOCAT")) {
            currentStep = 3;
        } else if (sUpper.equals("VERIFIED") || sUpper.contains("VERIF") || sUpper.equals("ACCEPTED")) {
            currentStep = 2;
        } else {
            currentStep = 1;
        }

        LinearLayout timelineLayout = new LinearLayout(this);
        timelineLayout.setOrientation(LinearLayout.VERTICAL);
        timelineLayout.setBackgroundResource(R.drawable.bg_chip_hospital);
        timelineLayout.setPadding(24, 18, 24, 18);
        LinearLayout.LayoutParams tmLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        tmLp.topMargin = 14;
        timelineLayout.setLayoutParams(tmLp);

        TextView txtTimelineTitle = new TextView(this);
        txtTimelineTitle.setText("REQUEST TIMELINE");
        txtTimelineTitle.setTextColor(ContextCompat.getColor(this, R.color.text_tertiary));
        txtTimelineTitle.setTextSize(10f);
        txtTimelineTitle.setTypeface(null, android.graphics.Typeface.BOLD);
        timelineLayout.addView(txtTimelineTitle);

        String[] stepLabels = new String[]{
            "Request Created",
            "Verified",
            "Blood Allocated",
            "Dispatched",
            "In Transit",
            "Fulfilled"
        };

        LinearLayout stepsContainer = new LinearLayout(this);
        stepsContainer.setOrientation(LinearLayout.VERTICAL);
        LinearLayout.LayoutParams scLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        scLp.topMargin = 8;
        stepsContainer.setLayoutParams(scLp);

        for (int i = 0; i < stepLabels.length; i++) {
            int stepNumber = i + 1;
            LinearLayout stepRow = new LinearLayout(this);
            stepRow.setOrientation(LinearLayout.HORIZONTAL);
            stepRow.setGravity(android.view.Gravity.CENTER_VERTICAL);
            stepRow.setPadding(0, 3, 0, 3);

            TextView txtStepIcon = new TextView(this);
            txtStepIcon.setTextSize(11f);
            txtStepIcon.setTypeface(null, android.graphics.Typeface.BOLD);

            TextView txtStepText = new TextView(this);
            txtStepText.setTextSize(12f);
            LinearLayout.LayoutParams stpLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
            stpLp.leftMargin = 10;
            txtStepText.setLayoutParams(stpLp);

            if (isRejected && stepNumber == 2) {
                txtStepIcon.setText("✕");
                txtStepIcon.setTextColor(ContextCompat.getColor(this, R.color.status_critical_text));
                txtStepText.setText("Step 2 Request Rejected");
                txtStepText.setTextColor(ContextCompat.getColor(this, R.color.status_critical_text));
                txtStepText.setTypeface(null, android.graphics.Typeface.BOLD);
            } else if (isCancelled && stepNumber == 1) {
                txtStepIcon.setText("✕");
                txtStepIcon.setTextColor(ContextCompat.getColor(this, R.color.status_critical_text));
                txtStepText.setText("Step 1 Request Cancelled");
                txtStepText.setTextColor(ContextCompat.getColor(this, R.color.status_critical_text));
                txtStepText.setTypeface(null, android.graphics.Typeface.BOLD);
            } else if (stepNumber < currentStep) {
                txtStepIcon.setText("✓");
                txtStepIcon.setTextColor(ContextCompat.getColor(this, R.color.status_available_text));
                txtStepText.setText("Step " + stepNumber + " " + stepLabels[i]);
                txtStepText.setTextColor(ContextCompat.getColor(this, R.color.text_secondary));
            } else if (stepNumber == currentStep) {
                txtStepIcon.setText(currentStep == 6 ? "✓" : "●");
                txtStepIcon.setTextColor(currentStep == 6 ? ContextCompat.getColor(this, R.color.status_available_text) : 0xFF38BDF8);
                txtStepText.setText("Step " + stepNumber + " " + stepLabels[i]);
                txtStepText.setTextColor(ContextCompat.getColor(this, R.color.white));
                txtStepText.setTypeface(null, android.graphics.Typeface.BOLD);
            } else {
                txtStepIcon.setText("○");
                txtStepIcon.setTextColor(ContextCompat.getColor(this, R.color.text_tertiary));
                txtStepText.setText("Step " + stepNumber + " " + stepLabels[i]);
                txtStepText.setTextColor(ContextCompat.getColor(this, R.color.text_tertiary));
            }

            stepRow.addView(txtStepIcon);
            stepRow.addView(txtStepText);
            stepsContainer.addView(stepRow);
        }

        timelineLayout.addView(stepsContainer);
        return timelineLayout;
            }

            stepRow.addView(txtStepIcon);
            stepRow.addView(txtStepText);
            stepsContainer.addView(stepRow);
            stepRow.addView(txtStepText);
            stepsContainer.addView(stepRow);
        }

        timelineLayout.addView(stepsContainer);
        return timelineLayout;
    }

    private int activeBloodBankRequestTab = 0; // 0: Hospital Requests, 1: Donor Appointments

    private void bindRequestsView(View view) {
        attachRoleBackgroundAnimators(view);

        TextView txtTitle = view.findViewById(R.id.txt_requests_title);
        TextView txtSubtitle = view.findViewById(R.id.txt_requests_subtitle);
        TextView btnCreate = view.findViewById(R.id.btn_requests_page_create);
        ProgressBar progress = view.findViewById(R.id.loading_requests_progress);
        LinearLayout container = view.findViewById(R.id.layout_requests_container);
        View emptyState = view.findViewById(R.id.layout_requests_empty_state);
        TextView txtEmptyTitle = view.findViewById(R.id.txt_empty_requests_title);
        TextView txtEmptyDesc = view.findViewById(R.id.txt_empty_requests_description);
        View btnEmptyCreate = view.findViewById(R.id.btn_empty_create_request);

        View layoutBankTabs = view.findViewById(R.id.layout_bank_request_tabs);
        TextView tabHospital = view.findViewById(R.id.tab_bank_hospital_requests);
        TextView tabDonor = view.findViewById(R.id.tab_bank_donor_appointments);

        UserProfile currentUser = repository.getCurrentUser();
        String currentUid = currentUser != null ? currentUser.getUid() : "USR-8842";
        String currentDisplayName = currentUser != null && currentUser.getDisplayName() != null ? currentUser.getDisplayName() : "User";

        if (currentRole == UserRole.DONOR) {
            if (layoutBankTabs != null) layoutBankTabs.setVisibility(View.GONE);
            if (txtTitle != null) txtTitle.setText("My Donation Appointments");
            if (txtSubtitle != null) txtSubtitle.setText("Live appointment status with regional blood banks");
            if (btnCreate != null) {
                btnCreate.setVisibility(View.VISIBLE);
                btnCreate.setText("+ Book Donation");
                btnCreate.setBackgroundResource(R.drawable.bg_button_donor);
                btnCreate.setOnClickListener(v -> showBookBloodDonationDialog(null));
            }
                            return;
                        }

                        if (queryDocumentSnapshots == null || queryDocumentSnapshots.isEmpty()) {
                            if (emptyState != null) emptyState.setVisibility(View.VISIBLE);
                            return;
