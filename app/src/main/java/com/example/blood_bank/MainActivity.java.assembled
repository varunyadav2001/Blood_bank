                if (TextUtils.isEmpty(name) || TextUtils.isEmpty(email) || TextUtils.isEmpty(dob) ||
                    TextUtils.isEmpty(gender) || TextUtils.isEmpty(group) || TextUtils.isEmpty(password) || TextUtils.isEmpty(confirmPassword)) {
                    showRegError(txtError, "Please complete all required fields (Name, Email, Date of Birth, Gender, Blood Group, Password, Confirm Password).");
                    return;
                }

                if (!android.util.Patterns.EMAIL_ADDRESS.matcher(email).matches()) {
                    showRegError(txtError, "Please enter a valid email address.");
                    return;
                }

                if (!password.equals(confirmPassword)) {
                    showRegError(txtError, "Password and Confirm Password do not match.");
                    return;
                }

                if (txtError != null) txtError.setVisibility(View.GONE);
                btnSubmit.setEnabled(false);

                try {
                    FirebaseAuth.getInstance().createUserWithEmailAndPassword(email, password)
                        .addOnCompleteListener(this, task -> {
                            if (task.isSuccessful()) {
                                FirebaseUser fbUser = FirebaseAuth.getInstance().getCurrentUser();
                                String uid = fbUser != null ? fbUser.getUid() : "USR-DNR-" + System.currentTimeMillis();

                                Map<String, Object> userMap = new HashMap<>();
                                userMap.put("name", name);
                                userMap.put("email", email);
                                userMap.put("role", "DONOR");
                                userMap.put("mobile", mobile);
                                userMap.put("bloodGroup", group);
                                userMap.put("dob", dob);
                                userMap.put("gender", gender);
                                userMap.put("city", city);
                                userMap.put("createdAt", System.currentTimeMillis());

                                try {
                                    FirebaseFirestore.getInstance().collection("users").document(uid).set(userMap);
                                } catch (Exception ignored) {}

                                repository.registerDonorWithUid(uid, name, email, mobile, group, city);
                                try {
                                    FirebaseAuth.getInstance().signOut();
                                } catch (Exception ignored) {}

                                Toast.makeText(this, "Donor Registered Successfully! Please sign in with your credentials.", Toast.LENGTH_LONG).show();
                if (!password.equals(confirmPassword)) {
                    showRegError(txtError, "Password and Confirm Password do not match.");
                    return;
                }

                if (regBankLat == 0.0 || regBankLng == 0.0) {
