                    return;
                }
                    if (stock > 0 && !groupNearestBank.containsKey(g)) {
                        groupNearestBank.put(g, bank.name + " (" + String.format(Locale.US, "%.1f km", bank.distanceKm) + ")");
                    }
                }
            }
        }

        List<String> lowStockGroups = new ArrayList<>();
        for (String g : allGroups) {
            int total = groupTotalStock.get(g);
            if (total <= LOW_STOCK_THRESHOLD) {
                lowStockGroups.add(g);
            }
