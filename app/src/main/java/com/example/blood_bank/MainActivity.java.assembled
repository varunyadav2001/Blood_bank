        inputSearchBank.setBackgroundResource(R.drawable.bg_input_field);
        inputSearchBank.setTextSize(14f);
        inputSearchBank.setPadding(28, 20, 28, 20);
        LinearLayout.LayoutParams searchLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        searchLp.bottomMargin = 16;
        inputSearchBank.setLayoutParams(searchLp);
        root.addView(inputSearchBank);

        // Scrollable List Container
        android.widget.ScrollView scrollView = new android.widget.ScrollView(this);
        LinearLayout.LayoutParams scrollLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 800);
        scrollView.setLayoutParams(scrollLp);

        LinearLayout listContainer = new LinearLayout(this);
        listContainer.setOrientation(LinearLayout.VERTICAL);
        scrollView.addView(listContainer);
        root.addView(scrollView);

        final List<SmartMapItem> bankList = new ArrayList<>();
        final Runnable[] populateListRef = new Runnable[1];

        Runnable populateList = () -> {
            listContainer.removeAllViews();
            String q = inputSearchBank.getText().toString().toLowerCase(Locale.US).trim();

            List<SmartMapItem> filteredList = new ArrayList<>();
            for (SmartMapItem item : bankList) {
                if (!q.isEmpty()) {
                    boolean matchName = item.name != null && item.name.toLowerCase(Locale.US).contains(q);
                    boolean matchArea = item.area != null && item.area.toLowerCase(Locale.US).contains(q);
                    boolean matchId = item.id != null && item.id.toLowerCase(Locale.US).contains(q);
                    if (!matchName && !matchArea && !matchId) continue;
                }
                filteredList.add(item);
            }

            if (filteredList.isEmpty()) {
                LinearLayout emptyBox = new LinearLayout(this);
                emptyBox.setOrientation(LinearLayout.VERTICAL);
                emptyBox.setGravity(android.view.Gravity.CENTER);
                emptyBox.setPadding(24, 48, 24, 48);

                TextView txtEmptyTitle = new TextView(this);
                txtEmptyTitle.setText(bankList.isEmpty() ? "No Blood Banks Registered" : "No Blood Bank Found");
                txtEmptyTitle.setTextColor(ContextCompat.getColor(this, R.color.white));
                txtEmptyTitle.setTextSize(15f);
                txtEmptyTitle.setTypeface(null, android.graphics.Typeface.BOLD);
                txtEmptyTitle.setGravity(android.view.Gravity.CENTER);
                emptyBox.addView(txtEmptyTitle);

                TextView txtEmptySub = new TextView(this);
                txtEmptySub.setText(bankList.isEmpty() ? "No blood bank facilities found in Firebase database." : "Try searching by another facility name or city.");
                txtEmptySub.setTextColor(ContextCompat.getColor(this, R.color.text_secondary));
                txtEmptySub.setTextSize(12f);
                txtEmptySub.setGravity(android.view.Gravity.CENTER);
                LinearLayout.LayoutParams eSubLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                eSubLp.topMargin = 6;
                txtEmptySub.setLayoutParams(eSubLp);
                emptyBox.addView(txtEmptySub);

                listContainer.addView(emptyBox);
                return;
            }

            for (SmartMapItem item : filteredList) {
                boolean isCurrent = item.id.equalsIgnoreCase(activeBankIdHolder[0]) || (item.name != null && item.name.equalsIgnoreCase(activeBankNameHolder[0]));

                LinearLayout card = new LinearLayout(this);
                card.setOrientation(LinearLayout.VERTICAL);
                card.setBackgroundResource(isCurrent ? R.drawable.bg_card_premium : R.drawable.bg_search_bar);
                card.setPadding(26, 22, 26, 22);
                LinearLayout.LayoutParams rowLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                rowLp.bottomMargin = 12;
                card.setLayoutParams(rowLp);

                // Top row: Name + Current badge
                LinearLayout topRow = new LinearLayout(this);
                topRow.setOrientation(LinearLayout.HORIZONTAL);
                topRow.setGravity(android.view.Gravity.CENTER_VERTICAL);
                topRow.setLayoutParams(new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));

                TextView txtName = new TextView(this);
                txtName.setText("🩸 " + item.name);
                txtName.setTextColor(isCurrent ? 0xFF38BDF8 : ContextCompat.getColor(this, R.color.white));
                txtName.setTextSize(15f);
                txtName.setTypeface(null, android.graphics.Typeface.BOLD);
                txtName.setLayoutParams(new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
                topRow.addView(txtName);

                if (isCurrent) {
                    TextView txtActiveBadge = new TextView(this);
                    txtActiveBadge.setText("✓ Active");
                    txtActiveBadge.setTextColor(0xFF38BDF8);
                    txtActiveBadge.setTextSize(11f);
                    txtActiveBadge.setTypeface(null, android.graphics.Typeface.BOLD);
                    txtActiveBadge.setBackgroundResource(R.drawable.bg_chip_status_pending);
                    txtActiveBadge.setPadding(14, 6, 14, 6);
                    topRow.addView(txtActiveBadge);
                }

                card.addView(topRow);

                // City / Location
                TextView txtCity = new TextView(this);
                txtCity.setText("📍 " + item.area + (item.id != null && !item.id.isEmpty() ? " • ID: " + item.id : ""));
                txtCity.setTextColor(ContextCompat.getColor(this, R.color.text_secondary));
                txtCity.setTextSize(12f);
                LinearLayout.LayoutParams cityLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                cityLp.topMargin = 6;
                txtCity.setLayoutParams(cityLp);
                card.addView(txtCity);

                // Bottom row: Available Stock & Select Button
                LinearLayout bottomRow = new LinearLayout(this);
                bottomRow.setOrientation(LinearLayout.HORIZONTAL);
                bottomRow.setGravity(android.view.Gravity.CENTER_VERTICAL);
                LinearLayout.LayoutParams botLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                botLp.topMargin = 12;
                bottomRow.setLayoutParams(botLp);

                int availableStock = item.totalUnits;
                if (availableStock == 0 && item.stockMap != null) {
                    for (int v : item.stockMap.values()) availableStock += v;
                }

                TextView txtStock = new TextView(this);
                txtStock.setText("Available Stock: " + availableStock + (availableStock == 1 ? " Unit" : " Units"));
                txtStock.setTextColor(availableStock == 0 ? ContextCompat.getColor(this, R.color.status_critical_text) : (availableStock <= LOW_STOCK_THRESHOLD ? 0xFFF59E0B : 0xFF10B981));
                txtStock.setTextSize(12f);
                txtStock.setTypeface(null, android.graphics.Typeface.BOLD);
                txtStock.setLayoutParams(new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
                bottomRow.addView(txtStock);

                TextView btnSelect = new TextView(this);
                btnSelect.setText(isCurrent ? "Selected" : "Select");
                btnSelect.setTextColor(ContextCompat.getColor(this, R.color.white));
                btnSelect.setTextSize(12f);
                btnSelect.setTypeface(null, android.graphics.Typeface.BOLD);
                btnSelect.setBackgroundResource(isCurrent ? R.drawable.bg_button_hospital : R.drawable.bg_chip_hospital);
                btnSelect.setPadding(24, 12, 24, 12);
                bottomRow.addView(btnSelect);

                card.addView(bottomRow);

                View.OnClickListener selectListener = v -> {
                    activeBankIdHolder[0] = item.id;
                    activeBankNameHolder[0] = item.name;
                    selectedBloodBank = item;

                    Log.d("SmartBloodFacility", "================ FACILITY SELECTED ================");
        if (camp.getAvailableSlots() <= 0) {
            Toast.makeText(this, "This donation camp is FULL.", Toast.LENGTH_SHORT).show();
            return;
        }

        UserProfile currentUser = repository.getCurrentUser();
        String currentUid = currentUser != null ? currentUser.getUid() : "USR-DNR-01";
        String donorName = currentUser != null && currentUser.getDisplayName() != null ? currentUser.getDisplayName() : "Donor";
        String donorPhone = currentUser != null ? currentUser.getMobileNumber() : "";
        String donorGroup = currentUser != null ? currentUser.getBloodGroup() : "O+";

        FirebaseFirestore db = FirebaseFirestore.getInstance();

        // Duplicate Check
        db.collection("campRegistrations")
            .whereEqualTo("donorAuthUid", currentUid)
            .whereEqualTo("campId", camp.getCampId())
            .get()
            .addOnCompleteListener(task -> {
                if (task.isSuccessful() && task.getResult() != null && !task.getResult().isEmpty()) {
                    boolean hasActive = false;
                    for (DocumentSnapshot d : task.getResult().getDocuments()) {
                        String st = d.getString("status");
                        if (st != null && !st.equalsIgnoreCase("CANCELLED")) {
                            hasActive = true;
                            break;
                        }
                    }
                    if (hasActive) {
                        Toast.makeText(this, "You are already registered for this camp.", Toast.LENGTH_LONG).show();
                        return;
                    }
                }

                String regId = "REG-" + camp.getCampId() + "-" + System.currentTimeMillis();
                String formattedCreated = new SimpleDateFormat("dd MMM yyyy, hh:mm a", Locale.US).format(new Date());

                Map<String, Object> regMap = new HashMap<>();
                regMap.put("registrationId", regId);
                regMap.put("campId", camp.getCampId());
                regMap.put("campName", camp.getCampName());
                regMap.put("bloodBankId", camp.getBloodBankId());
                regMap.put("bloodBankName", camp.getBloodBankName());
                regMap.put("donorId", currentUid);
                regMap.put("donorAuthUid", currentUid);
                regMap.put("donorName", donorName);
                regMap.put("donorPhone", donorPhone);
                regMap.put("bloodGroup", donorGroup);
                regMap.put("campDate", camp.getDate());
                regMap.put("status", "PENDING");
                regMap.put("createdAt", formattedCreated);
                regMap.put("createdAtTimestamp", System.currentTimeMillis());

                db.collection("campRegistrations").document(regId).set(regMap)
                    .addOnSuccessListener(aVoid -> {
                        // Notify Donor
                        String notifDonorId = "NOTIF-REG-" + System.currentTimeMillis();
                        Map<String, Object> dNotif = new HashMap<>();
                        dNotif.put("notificationId", notifDonorId);
                        dNotif.put("donorId", currentUid);
                        dNotif.put("donorAuthUid", currentUid);
                        for (int v : stockMap.values()) total += v;

                        SmartMapItem item = new SmartMapItem(finalId, name, "BLOOD_BANK", finalLat, finalLng, phone, city, true, total, stockMap);
                        bankList.add(item);

                        // Keep smartMapItemList in memory in sync
                        boolean foundInMap = false;
                        for (SmartMapItem mapItem : smartMapItemList) {
                            if ("BLOOD_BANK".equalsIgnoreCase(mapItem.type) && 
                                (mapItem.id.equalsIgnoreCase(finalId) || (mapItem.name != null && mapItem.name.equalsIgnoreCase(name)))) {
                                mapItem.stockMap = stockMap;
                                mapItem.totalUnits = total;
                                mapItem.area = city;
                                foundInMap = true;
                                break;
                            }
                        }
                        if (!foundInMap) {
                            smartMapItemList.add(item);
                        bbNotif.put("message", "Donor " + donorName + " (" + donorGroup + ") registered for " + camp.getCampName() + ".");
                        bbNotif.put("type", "CAMP_REGISTRATION");
                        bbNotif.put("createdAt", formattedCreated);
                        bbNotif.put("timestamp", System.currentTimeMillis());
                        bbNotif.put("isRead", false);
                        bbNotif.put("read", false);
                        db.collection("notifications").document(notifBankId).set(bbNotif);

                        repository.addAuditLog(currentUid, "DONOR", "CAMP_REGISTER", regId, "10:30 AM", "NEW", "PENDING", "Donor registered for " + camp.getCampName());
                        Toast.makeText(this, "Successfully registered for " + camp.getCampName() + "!", Toast.LENGTH_LONG).show();
                    })
                    .addOnFailureListener(e -> {
                        Toast.makeText(this, "Registration failed: " + e.getMessage(), Toast.LENGTH_SHORT).show();
                    });
            });
    }

    private void cancelCampRegistration(String regId, String campId) {
        FirebaseFirestore db = FirebaseFirestore.getInstance();
        UserProfile currentUser = repository.getCurrentUser();
        String currentUid = currentUser != null ? currentUser.getUid() : "USR-DNR-01";

        db.collection("campRegistrations").document(regId)
            .update("status", "CANCELLED")
            .addOnSuccessListener(aVoid -> {
                // Restore slot if camp document exists
                if (campId != null && !campId.isEmpty()) {
                    db.collection("bloodCamps").document(campId)
                        .update("availableSlots", FieldValue.increment(1));
                }

                String notifId = "NOTIF-REG-CAN-" + System.currentTimeMillis();
                Map<String, Object> dNotif = new HashMap<>();
                dNotif.put("notificationId", notifId);
                dNotif.put("donorId", currentUid);
                dNotif.put("donorAuthUid", currentUid);
                dNotif.put("targetUserId", currentUid);
                dNotif.put("targetRole", "DONOR");
                dNotif.put("title", "Camp Registration Cancelled");
                dNotif.put("message", "Your registration has been cancelled.");
                dNotif.put("type", "CAMP_REGISTRATION_CANCELLED");
                dNotif.put("createdAt", new SimpleDateFormat("dd MMM yyyy, hh:mm a", Locale.US).format(new Date()));
                dNotif.put("timestamp", System.currentTimeMillis());
                dNotif.put("isRead", false);
                dNotif.put("read", false);
                db.collection("notifications").document(notifId).set(dNotif);

                Toast.makeText(this, "Registration cancelled.", Toast.LENGTH_SHORT).show();
            });
    }

