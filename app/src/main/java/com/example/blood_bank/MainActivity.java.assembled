        if (cardOPos != null) cardOPos.setOnClickListener(v -> { highlightTargetBloodGroup = "O+"; loadView(R.layout.view_inventory, this::bindInventoryView); });
        if (cardONeg != null) cardONeg.setOnClickListener(v -> { highlightTargetBloodGroup = "O-"; loadView(R.layout.view_inventory, this::bindInventoryView); });
        if (cardAPos != null) cardAPos.setOnClickListener(v -> { highlightTargetBloodGroup = "A+"; loadView(R.layout.view_inventory, this::bindInventoryView); });
        if (cardANeg != null) cardANeg.setOnClickListener(v -> { highlightTargetBloodGroup = "A-"; loadView(R.layout.view_inventory, this::bindInventoryView); });
        if (cardBPos != null) cardBPos.setOnClickListener(v -> { highlightTargetBloodGroup = "B+"; loadView(R.layout.view_inventory, this::bindInventoryView); });
        if (cardBNeg != null) cardBNeg.setOnClickListener(v -> { highlightTargetBloodGroup = "B-"; loadView(R.layout.view_inventory, this::bindInventoryView); });
        if (cardABPos != null) cardABPos.setOnClickListener(v -> { highlightTargetBloodGroup = "AB+"; loadView(R.layout.view_inventory, this::bindInventoryView); });
                        FirebaseFirestore.getInstance().collection("bloodBanks").document(currentBankId).set(newBankDoc);

                        if (txtName != null) txtName.setText(bankName);
                        if (txtSubtitle != null) txtSubtitle.setText("✓ Verified Reserve Dashboard • ID: " + currentBankId);
                        if (txtLocation != null) txtLocation.setText("📍 " + address);
                        renderStockData.accept(initStock);
                    }
                });

            // Real-time listener for incoming Critical / Emergency requests
            FirebaseFirestore.getInstance().collection("bloodRequests")
                .whereEqualTo("status", "PENDING_VERIFICATION")
                .addSnapshotListener((snaps, err) -> {
                    if (snaps != null && !snaps.isEmpty()) {
                        DocumentSnapshot emergencyDoc = null;
                        for (DocumentSnapshot doc : snaps.getDocuments()) {
                            String urg = doc.getString("urgency");
                            if (urg != null && (urg.equalsIgnoreCase("Emergency") || urg.equalsIgnoreCase("Critical"))) {
                                emergencyDoc = doc;
                                break;
                            }
                        }
                        if (emergencyDoc != null && txtAlertCrit != null) {
                            String hName = emergencyDoc.getString("hospitalName") != null ? emergencyDoc.getString("hospitalName") : "Hospital";
                            String bGrp = emergencyDoc.getString("bloodGroup") != null ? emergencyDoc.getString("bloodGroup") : "Blood";
                            Long qLong = emergencyDoc.getLong("quantity");
                            int q = qLong != null ? qLong.intValue() : 2;
                            txtAlertCrit.setText("🚨 CRITICAL EMERGENCY: " + hName + " requested " + q + "u of " + bGrp + "! Tap to respond.");
                            txtAlertCrit.setOnClickListener(v -> loadView(R.layout.view_requests, this::bindRequestsView));
                        }
                    }
                });
        } catch (Exception e) {
            if (progress != null) progress.setVisibility(View.GONE);
        }
    }

    private void updateBloodGroupStockCard(TextView txtUnits, TextView txtStatus, int units) {
        if (txtUnits == null || txtStatus == null) return;
        txtUnits.setText(String.format(Locale.US, "%d %s", units, units == 1 ? "Unit" : "Units"));
        if (units == 0) {
            txtStatus.setText("🔴 Out of Stock");
            txtStatus.setBackgroundResource(R.drawable.bg_chip_status_pending);
            txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_critical_text));
        } else if (units <= LOW_STOCK_THRESHOLD) {
            txtStatus.setText("🟡 Low Stock");
            txtStatus.setBackgroundResource(R.drawable.bg_chip_status_low);
            txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_low_text));
        } else {
            txtStatus.setText("🟢 Available");
            txtStatus.setBackgroundResource(R.drawable.bg_chip_status_available);
            txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_available_text));
        }
    }

