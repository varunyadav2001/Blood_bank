    private void applyMapFilters(TextView txtBankName, TextView txtBankDistance, TextView txtBankStock, TextView txtBankStatus, ImageView iconVerified) {
        if (activeGoogleMap == null) return;

        SmartMapItem bestMatch = null;
        double minDistance = Double.MAX_VALUE;

        LatLngBounds.Builder boundsBuilder = new LatLngBounds.Builder();
        boundsBuilder.include(new LatLng(userLat, userLng));
        int visibleCount = 0;

        List<SmartMapItem> distanceFiltered = filterBloodBanksByDistance(smartMapItemList, selectedRadiusKm);

        for (SmartMapItem item : smartMapItemList) {
            double dist = item.distanceKm >= 0.0 ? item.distanceKm : calculateDistanceInKm(userLat, userLng, item.lat, item.lng);
            item.distanceKm = dist;

            boolean radiusMatch = (selectedRadiusKm <= 0) || (dist >= 0.0 && dist <= selectedRadiusKm);

            boolean groupMatch = true;
            if ("BLOOD_BANK".equals(item.type)) {
                groupMatch = "ALL".equalsIgnoreCase(selectedGroupFilter) ||
                        (item.stockMap != null && item.stockMap.containsKey(selectedGroupFilter) && item.stockMap.get(selectedGroupFilter) > 0);
            }

            boolean isVisible = radiusMatch && groupMatch;

            // Ensure marker exists on activeGoogleMap
            if (item.marker == null && activeGoogleMap != null) {
                boolean isHosp = "HOSPITAL".equalsIgnoreCase(item.type);
                BitmapDescriptor icon = isHosp ? BitmapDescriptorFactory.defaultMarker(BitmapDescriptorFactory.HUE_CYAN)
                                               : createBloodBankMarkerIcon(false);
                String prefix = isHosp ? "🏥 " : "🩸 ";

                item.marker = activeGoogleMap.addMarker(new MarkerOptions()
                        .position(new LatLng(item.lat, item.lng))
                        .title(prefix + item.name)
                        .snippet("✓ Verified " + (isHosp ? "Healthcare Center" : "Supplier") + " • " + item.area)
                        .zIndex(isHosp ? 6f : 5f)
                        .icon(icon));
            }

            if (item.marker != null) {
                item.marker.setVisible(isVisible);
            }

            if (isVisible) {
                boundsBuilder.include(new LatLng(item.lat, item.lng));
                visibleCount++;

                if (dist < minDistance) {
                    minDistance = dist;
                    bestMatch = item;
                }
            }
        }

        if (visibleCount > 0 && activeGoogleMap != null) {
            try {
                activeGoogleMap.animateCamera(CameraUpdateFactory.newLatLngBounds(boundsBuilder.build(), 100));
            } catch (Exception ignored) {}
        }

        // STEP 6: Preserve selectedBloodBank if still visible in current filter, else default to bestMatch
        boolean selectedStillVisible = false;
        if (selectedBloodBank != null) {
            for (SmartMapItem item : smartMapItemList) {
                if (item.id.equals(selectedBloodBank.id) && item.marker != null && item.marker.isVisible()) {
                    selectedStillVisible = true;
                    break;
                }
            }
        }

        if (selectedStillVisible && selectedBloodBank != null) {
            selectMapItem(selectedBloodBank, false, txtBankName, txtBankDistance, txtBankStock, txtBankStatus, iconVerified);
        } else if (bestMatch != null) {
            selectMapItem(bestMatch, false, txtBankName, txtBankDistance, txtBankStock, txtBankStatus, iconVerified);
        } else {
            selectedBloodBank = null;
            if (activeRoutePolyline != null) {
                activeRoutePolyline.remove();
                activeRoutePolyline = null;
            }
            String radText = selectedRadiusKm > 0 ? (int) selectedRadiusKm + " KM" : "selected area";
            if (txtBankName != null) txtBankName.setText("No blood banks found within " + radText + ".");
            if (txtBankDistance != null) txtBankDistance.setText("Try expanding radius or selecting All Groups.");
            if (txtBankStock != null) txtBankStock.setText("No compatible stock or hospitals nearby.");
            if (txtBankStatus != null) txtBankStatus.setText("NO STOCK");
        }

        // STEP 4 & 12: Update Mobile Debug Verification Panel for Distance Radius Filter
        if (txtFsDebugLoadedCountRef != null) {
            txtFsDebugLoadedCountRef.setText(String.format(java.util.Locale.US, "Selected Radius: %.0f KM • Filtered Blood Banks: %d • Markers Visible: %d", selectedRadiusKm, distanceFiltered.size(), visibleCount));
        }
        if (txtFsDebugSampleListRef != null) {
            StringBuilder sb = new StringBuilder();
            sb.append(String.format(java.util.Locale.US, "Selected Radius: %.0f KM\nFiltered Blood Banks: %d | Markers Visible: %d\n\n", selectedRadiusKm, distanceFiltered.size(), visibleCount));

            if (distanceFiltered.isEmpty()) {
                sb.append("No blood banks found within ").append((int) selectedRadiusKm).append(" KM.");
            } else {
                for (int i = 0; i < distanceFiltered.size(); i++) {
                    SmartMapItem item = distanceFiltered.get(i);
                    sb.append("✓ ").append(item.name).append("\n")
                      .append("  Distance: ").append(String.format(java.util.Locale.US, "%.1f KM", item.distanceKm))
                      .append("\n\n");
                }
            }
            txtFsDebugSampleListRef.setText(sb.toString().trim());
        }
    }

    private void requestLocationPermission() {
        if (ContextCompat.checkSelfPermission(this, Manifest.permission.ACCESS_FINE_LOCATION) == PackageManager.PERMISSION_GRANTED) {
            checkAndUpdateLocationPermissionUI();
        } else {
            ActivityCompat.requestPermissions(this, new String[]{Manifest.permission.ACCESS_FINE_LOCATION, Manifest.permission.ACCESS_COARSE_LOCATION}, 101);
                SmartMapItem targetBank = selectedBloodBank;

                if (targetBank == null || targetBank.lat == 0.0 || targetBank.lng == 0.0) {
                    if (currentBankLat != 0.0 && currentBankLng != 0.0) {
                        for (SmartMapItem item : smartMapItemList) {
                            if (item.lat == currentBankLat && item.lng == currentBankLng) {
                                targetBank = item;
                                break;
                            }
                        }
                    }
                }

                if (targetBank == null || targetBank.lat == 0.0 || targetBank.lng == 0.0) {
                    Toast.makeText(this, "Selected blood bank location is unavailable.", Toast.LENGTH_LONG).show();
                    return;
                }

                Toast.makeText(this, String.format(java.util.Locale.US, "🧭 Navigating to %s...", targetBank.name), Toast.LENGTH_SHORT).show();

                String uriStr = String.format(java.util.Locale.US, "google.navigation:q=%.6f,%.6f&mode=d", targetBank.lat, targetBank.lng);
                Uri gmmIntentUri = Uri.parse(uriStr);
                Intent mapIntent = new Intent(Intent.ACTION_VIEW, gmmIntentUri);
                mapIntent.setPackage("com.google.android.apps.maps");
                try {
                    startActivity(mapIntent);
                } catch (Exception e) {
                    Uri webUri = Uri.parse(String.format(java.util.Locale.US, "https://www.google.com/maps/dir/?api=1&origin=%.6f,%.6f&destination=%.6f,%.6f", userLat, userLng, targetBank.lat, targetBank.lng));
                    Intent webIntent = new Intent(Intent.ACTION_VIEW, webUri);
                    try {
                        startActivity(webIntent);
                    } catch (Exception ignored) {}
                }
            });
        }

        // 📞 Call Phone Action
        if (btnCallBank != null) {
            btnCallBank.setOnClickListener(v -> {
                Intent dialIntent = new Intent(Intent.ACTION_DIAL, Uri.parse("tel:" + currentBankPhone));
                try {
                    startActivity(dialIntent);
                } catch (Exception e) {
                    Toast.makeText(this, "Dialing " + currentBankName + "...", Toast.LENGTH_SHORT).show();
                }
            });
        }

        // My Location FAB Action
        if (btnMyLocation != null) {
            btnMyLocation.setOnClickListener(v -> {
                if (activeGoogleMap != null) {
                    activeGoogleMap.animateCamera(CameraUpdateFactory.newLatLngZoom(new LatLng(userLat, userLng), 14.5f));
                }
                Toast.makeText(this, "Centering map on hospital GPS location...", Toast.LENGTH_SHORT).show();
            });
        }

        if (inputSearch != null) {
            inputSearch.addTextChangedListener(new TextWatcher() {
                @Override public void beforeTextChanged(CharSequence s, int start, int count, int after) {}
                @Override public void onTextChanged(CharSequence s, int start, int before, int count) {}
                @Override
                public void afterTextChanged(Editable s) {
                    String query = s.toString().toLowerCase().trim();
                    if (!query.isEmpty()) {
                        for (SmartMapItem item : smartMapItemList) {
                            if (item.name.toLowerCase().contains(query) || item.area.toLowerCase().contains(query)) {
                                selectMapItem(item, true, txtBankNameRef, txtBankDistanceRef, txtBankStockRef, txtBankStatusRef, iconVerifiedRef);
                                break;
                            }
                        }
                    }
                }
            });
        }
    }

