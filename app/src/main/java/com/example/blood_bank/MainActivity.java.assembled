    private void showEditHospitalProfileDialog() {
        Dialog dialog = new Dialog(this);
        dialog.setContentView(R.layout.dialog_edit_hospital_profile);
        if (dialog.getWindow() != null) {
            dialog.getWindow().setLayout(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        }

        UserProfile currentUser = repository.getCurrentUser();
        EditText editName = dialog.findViewById(R.id.edit_hospital_name);
        EditText editPhone = dialog.findViewById(R.id.edit_hospital_phone);
        EditText editCity = dialog.findViewById(R.id.edit_hospital_city);
        EditText editAddr = dialog.findViewById(R.id.edit_hospital_address);
        View btnSave = dialog.findViewById(R.id.btn_save_hospital_profile);
        View btnClose = dialog.findViewById(R.id.btn_close_edit_profile);

        if (currentUser != null) {
            if (editName != null && currentUser.getDisplayName() != null) editName.setText(currentUser.getDisplayName());
            if (editPhone != null && currentUser.getMobileNumber() != null) editPhone.setText(currentUser.getMobileNumber());
            if (editCity != null && currentUser.getCity() != null) editCity.setText(currentUser.getCity());
            if (editAddr != null && currentUser.getLocationAddress() != null) editAddr.setText(currentUser.getLocationAddress());
        }

        if (btnClose != null) btnClose.setOnClickListener(v -> dialog.dismiss());

        if (btnSave != null) {
            btnSave.setOnClickListener(v -> {
                String name = editName != null ? editName.getText().toString().trim() : "";
                String phone = editPhone != null ? editPhone.getText().toString().trim() : "";
                String city = editCity != null ? editCity.getText().toString().trim() : "";
                String addr = editAddr != null ? editAddr.getText().toString().trim() : "";

                if (TextUtils.isEmpty(name) || TextUtils.isEmpty(phone)) {
                    Toast.makeText(this, "Hospital name and phone number cannot be empty.", Toast.LENGTH_SHORT).show();
                    return;
                }

                if (currentUser != null) {
                    Map<String, Object> updates = new HashMap<>();
                    updates.put("name", name);
                    updates.put("displayName", name);
                    updates.put("phone", phone);
                    updates.put("city", city);
                    updates.put("locationAddress", addr);
                    updates.put("locationUpdatedAt", System.currentTimeMillis());

                    try {
                        FirebaseFirestore.getInstance().collection("users").document(currentUser.getUid()).update(updates);
                    } catch (Exception ignored) {}

                    UserProfile updatedProfile = new UserProfile(currentUser.getUid(), currentUser.getEmail(), phone, name, currentUser.getRole(), currentUser.isEmailVerified(), currentUser.isBiometricEnabled(), name, city);
                    updatedProfile.setLatitude(currentUser.getLatitude());
                    updatedProfile.setLongitude(currentUser.getLongitude());
                    updatedProfile.setLocationAddress(addr);

                    repository.setCurrentUser(updatedProfile);
                    repository.saveUserProfile(updatedProfile);
                    updateRoleUI(updatedProfile);

                    dialog.dismiss();
                    Toast.makeText(this, "✓ Hospital Profile Updated Successfully!", Toast.LENGTH_SHORT).show();
                    loadView(R.layout.view_profile, this::bindProfileView);
                } else {
                    dialog.dismiss();
                }
            });
        }

        dialog.show();
    }

        if (btnToggle != null) {
            btnToggle.setText(isDonorAvailable ? "🟢 Available" : "🔴 Unavailable");
            btnToggle.setOnClickListener(v -> {
                isDonorAvailable = !isDonorAvailable;
                btnToggle.setText(isDonorAvailable ? "🟢 Available" : "🔴 Unavailable");
                repository.addAuditLog("DNR-902", "DONOR", "UPDATE_AVAILABILITY", "DNR-902", "10:20 AM", isDonorAvailable ? "UNAVAILABLE" : "AVAILABLE", isDonorAvailable ? "AVAILABLE" : "UNAVAILABLE", "Donor availability updated.");
                Toast.makeText(this, "Donor availability updated", Toast.LENGTH_SHORT).show();
            });
        }

        View btnRespond = view.findViewById(R.id.btn_donor_respond_emergency);
        if (btnRespond != null) {
            btnRespond.setOnClickListener(v -> {
                repository.addAuditLog("DNR-902", "DONOR", "ACCEPT_EMERGENCY", "REQ-2026-904", "10:22 AM", "SEARCHING", "RESPONDED", "Donor accepted emergency request.");
                        continue;
                    }

                    // 1. Evaluate selected quick filter against real numeric stock using EXACT same method as card
                    boolean passesFilter = true;
                    if ("ALL".equalsIgnoreCase(filter)) {
                        passesFilter = true;
                    } else if ("O_POS".equalsIgnoreCase(filter) || "O+".equalsIgnoreCase(filter) || "O+ Stock".equalsIgnoreCase(filter)) {
                        passesFilter = getNumericStock(item.stockMap, "O+") > 0;
                    } else if ("O_NEG_EMERGENCY".equalsIgnoreCase(filter) || "O-".equalsIgnoreCase(filter) || "O- Emergency".equalsIgnoreCase(filter)) {
                        passesFilter = getNumericStock(item.stockMap, "O-") > 0;
                    } else if ("A_POS".equalsIgnoreCase(filter) || "A+".equalsIgnoreCase(filter) || "A+ Stock".equalsIgnoreCase(filter)) {
                        passesFilter = getNumericStock(item.stockMap, "A+") > 0;
                    } else if ("A_NEG".equalsIgnoreCase(filter) || "A-".equalsIgnoreCase(filter) || "A- Stock".equalsIgnoreCase(filter)) {
                        passesFilter = getNumericStock(item.stockMap, "A-") > 0;
                    } else if ("B_POS".equalsIgnoreCase(filter) || "B+".equalsIgnoreCase(filter) || "B+ Stock".equalsIgnoreCase(filter)) {
                        passesFilter = getNumericStock(item.stockMap, "B+") > 0;
                    } else if ("B_NEG".equalsIgnoreCase(filter) || "B-".equalsIgnoreCase(filter) || "B- Stock".equalsIgnoreCase(filter)) {
                        passesFilter = getNumericStock(item.stockMap, "B-") > 0;
                    } else if ("AB_POS".equalsIgnoreCase(filter) || "AB+".equalsIgnoreCase(filter) || "AB+ Stock".equalsIgnoreCase(filter)) {
                        passesFilter = getNumericStock(item.stockMap, "AB+") > 0;
                    } else if ("AB_NEG".equalsIgnoreCase(filter) || "AB-".equalsIgnoreCase(filter) || "AB- Stock".equalsIgnoreCase(filter)) {
                        passesFilter = getNumericStock(item.stockMap, "AB-") > 0;
                    } else if ("BOMBAY".equalsIgnoreCase(filter) || "Bombay (Oh)".equalsIgnoreCase(filter)) {
                        passesFilter = getNumericStock(item.stockMap, "Bombay") > 0;
                    } else {
                        passesFilter = getNumericStock(item.stockMap, filter) > 0;
                    }

                    if (!passesFilter) continue;

                    // 2. Evaluate search query (Name, City, Area, Address, or Blood Group typed in search)
                    boolean passesSearch = true;
                    if (!query.isEmpty()) {
                        boolean nameMatch = item.name != null && item.name.toLowerCase(Locale.US).contains(query);
                        boolean areaMatch = item.area != null && item.area.toLowerCase(Locale.US).contains(query);
                        boolean groupMatch = false;

                        // Bombay Blood Group keywords
                        if (query.equals("bombay") || query.equals("bombay blood") || query.equals("bombay blood group") ||
                            query.equals("oh") || query.equals("hh") || query.equals("bombay (oh)")) {
                            groupMatch = getNumericStock(item.stockMap, "Bombay") > 0;
                        } else {
                            String queryUpper = query.toUpperCase(Locale.US).replace(" ", "");
                            if (queryUpper.equals("O+") || queryUpper.equals("O-") || queryUpper.equals("A+") ||
                                queryUpper.equals("A-") || queryUpper.equals("B+") || queryUpper.equals("B-") ||
                                queryUpper.equals("AB+") || queryUpper.equals("AB-")) {
                                groupMatch = getNumericStock(item.stockMap, queryUpper) > 0;
                            }
                        }
                        passesSearch = nameMatch || areaMatch || groupMatch;
                    }

                    if (!passesSearch) continue;

                    matches.add(item);
                Toast.makeText(this, "Donor availability updated", Toast.LENGTH_SHORT).show();
            });
        }

        View btnRespond = view.findViewById(R.id.btn_donor_respond_emergency);
        if (btnRespond != null) {
            btnRespond.setOnClickListener(v -> {
                repository.addAuditLog("DNR-902", "DONOR", "ACCEPT_EMERGENCY", "REQ-2026-904", "10:22 AM", "SEARCHING", "RESPONDED", "Donor accepted emergency request.");
                loadView(R.layout.view_emergency_center, this::bindEmergencyCenterView);
            });
        }
    }

    private void bindEmergencyCenterView(View view) {
        TextView txtTimer = view.findViewById(R.id.txt_live_timer);
        if (txtTimer != null) {
            if (emergencyTimer != null) emergencyTimer.cancel();
            emergencyTimer = new CountDownTimer(900000, 1000) {
                @Override
                public void onTick(long millisUntilFinished) {
                    long mins = (millisUntilFinished / 1000) / 60;
                    long secs = (millisUntilFinished / 1000) % 60;
                    txtTimer.setText(String.format("⏱ %02d:%02d remaining", mins, secs));
                }

                @Override
                public void onFinish() {
                    txtTimer.setText("⏱ EXPIRED");
                }
            }.start();
        }

        View btnDispatch = view.findViewById(R.id.btn_dispatch_source_1);
        if (btnDispatch != null) {
            btnDispatch.setOnClickListener(v -> {
                repository.addAuditLog(currentRole.name(), currentRole.name(), "DISPATCH_UNITS", "REQ-2026-904", "10:25 AM", "SEARCHING", "RESERVED", "Dispatched 2 units O- from City Central Blood Bank.");
                Toast.makeText(this, "Dispatched 2 units O- from City Central Blood Bank!", Toast.LENGTH_LONG).show();
                loadView(R.layout.view_map, this::bindMapView);
            });
        }
    }

