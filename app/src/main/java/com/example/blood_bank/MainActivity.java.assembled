    private void bindMapView(View view) {
        initSmartBankData();

        MapView mapView = view.findViewById(R.id.map_view);
        activeMapView = mapView;
        mapNoticeBannerRef = view.findViewById(R.id.map_notice_banner);
        txtNoticeRef = view.findViewById(R.id.txt_map_notice);
        btnNoticeActionRef = view.findViewById(R.id.btn_notice_action);
        EditText inputSearch = view.findViewById(R.id.input_map_search);

        mapPermissionOverlayRef = view.findViewById(R.id.map_permission_overlay);
        txtPermDescRef = view.findViewById(R.id.txt_permission_desc);
        btnAllowPermRef = view.findViewById(R.id.btn_allow_location_access);
        btnOpenSettingsRef = view.findViewById(R.id.btn_open_app_settings);

        txtBankNameRef = view.findViewById(R.id.txt_selected_bank_name);
        txtBankDistanceRef = view.findViewById(R.id.txt_selected_bank_distance);
        txtBankStockRef = view.findViewById(R.id.txt_selected_bank_stock);
        txtBankStatusRef = view.findViewById(R.id.txt_selected_bank_status);
        iconVerifiedRef = view.findViewById(R.id.icon_selected_bank_verified);

        // STEP 2.2: Mobile Debug Verification Panel Views
        txtFsDebugStatusRef = view.findViewById(R.id.txt_firestore_debug_status);
        txtFsDebugLoadedCountRef = view.findViewById(R.id.txt_firestore_debug_loaded_count);
        txtFsDebugSampleListRef = view.findViewById(R.id.txt_firestore_debug_sample_list);
        View btnDebugToggle = view.findViewById(R.id.btn_map_debug_toggle);
        View layoutDebug = view.findViewById(R.id.layout_firestore_debug);
        if (btnDebugToggle != null && layoutDebug != null) {
            btnDebugToggle.setOnClickListener(v -> {
                if (layoutDebug.getVisibility() == View.VISIBLE) {
                    layoutDebug.setVisibility(View.GONE);
                } else {
                    layoutDebug.setVisibility(View.VISIBLE);
                }
            });
        }

        View btnNavigate = view.findViewById(R.id.btn_map_navigate);
        View btnCallBank = view.findViewById(R.id.btn_map_call_bank);
        View btnReserveStock = view.findViewById(R.id.btn_map_reserve_stock);
        View btnMyLocation = view.findViewById(R.id.btn_map_my_location);
        View btnFindNearest = view.findViewById(R.id.btn_map_find_nearest);
        View btnEmergencyReq = view.findViewById(R.id.btn_map_emergency);
        View btnLayersToggle = view.findViewById(R.id.btn_map_layers_toggle);

        // Radius Chips
        TextView chipRad5 = view.findViewById(R.id.chip_radius_5km);
        TextView chipRad1 = view.findViewById(R.id.chip_radius_1km);
        TextView chipRad10 = view.findViewById(R.id.chip_radius_10km);
        TextView chipRad15 = view.findViewById(R.id.chip_radius_15km);
        TextView chipRad20 = view.findViewById(R.id.chip_radius_20km);
        TextView chipRad30 = view.findViewById(R.id.chip_radius_30km);
        TextView chipRad50 = view.findViewById(R.id.chip_radius_50km);

        // Blood Group Chips
        TextView chipGrpAll = view.findViewById(R.id.chip_group_all);
        TextView chipGrpOPos = view.findViewById(R.id.chip_group_o_pos);
        TextView chipGrpONeg = view.findViewById(R.id.chip_group_o_neg);
        TextView chipGrpAPos = view.findViewById(R.id.chip_group_a_pos);
        TextView chipGrpBPos = view.findViewById(R.id.chip_group_b_pos);
        TextView chipGrpABPos = view.findViewById(R.id.chip_group_ab_pos);

        if (fusedLocationClient == null) {
            fusedLocationClient = LocationServices.getFusedLocationProviderClient(this);
        }

        if (btnAllowPermRef != null) {
            btnAllowPermRef.setOnClickListener(v -> requestLocationPermission());
        }

        if (mapView != null) {
            try {
                mapView.onCreate(null);
                mapView.onResume();
                mapView.getMapAsync(googleMap -> {
                    activeGoogleMap = googleMap;
                    googleMap.getUiSettings().setZoomControlsEnabled(true);
                    googleMap.getUiSettings().setCompassEnabled(true);

                    // Add Hospital / Current User Location Marker
                    UserProfile currentUser = repository.getCurrentUser();
                    String hospName = (currentUser != null && currentUser.getDisplayName() != null) ? currentUser.getDisplayName() : "My Hospital";
                    String hospAddr = (currentUser != null && currentUser.getLocationAddress() != null) ? currentUser.getLocationAddress() : "Hospital Location";

                    LatLng userPos = new LatLng(userLat, userLng);
                    userLocationMarker = googleMap.addMarker(new MarkerOptions()
                            .position(userPos)
                            .title("📍 MY HOSPITAL - " + hospName)
                            .snippet("📍 " + hospAddr + " • Official Registered Hospital")
                            .zIndex(10f)
                            .icon(BitmapDescriptorFactory.defaultMarker(BitmapDescriptorFactory.HUE_RED)));

                    // Center camera around hospital saved location with zoom 15.0f
                    googleMap.moveCamera(CameraUpdateFactory.newLatLngZoom(userPos, 15.0f));

                    // STEP 5: Add markers for Hospitals and 🩸 Blood Banks dynamically
                    for (SmartMapItem item : smartMapItemList) {
                        boolean isHosp = "HOSPITAL".equalsIgnoreCase(item.type);
                        BitmapDescriptor icon = isHosp ? BitmapDescriptorFactory.defaultMarker(BitmapDescriptorFactory.HUE_CYAN)
                                                       : createBloodBankMarkerIcon(false);
                        String prefix = isHosp ? "🏥 " : "🩸 ";

                        Marker marker = googleMap.addMarker(new MarkerOptions()
                                .position(new LatLng(item.lat, item.lng))
                                .title(prefix + item.name)
                                .snippet("✓ Verified " + (isHosp ? "Healthcare Center" : "Supplier") + " • " + item.area)
                                .zIndex(isHosp ? 6f : 5f)
                                .icon(icon));
                        item.marker = marker;
                    }

                    // Apply default 5 KM filter
                    applyMapFilters(txtBankNameRef, txtBankDistanceRef, txtBankStockRef, txtBankStatusRef, iconVerifiedRef);

                    googleMap.setOnMarkerClickListener(marker -> {
                        for (SmartMapItem item : smartMapItemList) {
                            if (item.marker != null && item.marker.equals(marker)) {
                                selectMapItem(item, true, txtBankNameRef, txtBankDistanceRef, txtBankStockRef, txtBankStatusRef, iconVerifiedRef);
                                break;
                            }
                        }
                        return true;
                    });

                    // Check Permission & GPS State upon map load
                    checkAndUpdateLocationPermissionUI();
                });
            } catch (Exception e) {
                if (mapNoticeBannerRef != null) mapNoticeBannerRef.setVisibility(View.VISIBLE);
                if (txtNoticeRef != null) txtNoticeRef.setText("SmartBlood locator active. Displaying live stock markers.");
            }
        }

        // Helper runner for radius chips style toggle
        Runnable resetRadiusStyle = () -> {
            TextView[] rChips = new TextView[]{chipRad5, chipRad1, chipRad10, chipRad15, chipRad20, chipRad30, chipRad50};
            double[] rVals = new double[]{5.0, 1.0, 10.0, 15.0, 20.0, 30.0, 50.0};
            for (int i = 0; i < rChips.length; i++) {
                if (rChips[i] == null) continue;
                if (Double.compare(rVals[i], selectedRadiusKm) == 0) {
                    rChips[i].setBackgroundResource(R.drawable.bg_button_primary);
                    rChips[i].setTextColor(ContextCompat.getColor(this, R.color.white));
                } else {
                    rChips[i].setBackgroundResource(R.drawable.bg_card_premium);
                    rChips[i].setTextColor(ContextCompat.getColor(this, R.color.text_secondary));
                }
            }
        };

        // Radius Chip Click Handlers
        if (chipRad5 != null) chipRad5.setOnClickListener(v -> { selectedRadiusKm = 5.0; resetRadiusStyle.run(); applyMapFilters(txtBankNameRef, txtBankDistanceRef, txtBankStockRef, txtBankStatusRef, iconVerifiedRef); });
        if (chipRad1 != null) chipRad1.setOnClickListener(v -> { selectedRadiusKm = 1.0; resetRadiusStyle.run(); applyMapFilters(txtBankNameRef, txtBankDistanceRef, txtBankStockRef, txtBankStatusRef, iconVerifiedRef); });
        if (chipRad10 != null) chipRad10.setOnClickListener(v -> { selectedRadiusKm = 10.0; resetRadiusStyle.run(); applyMapFilters(txtBankNameRef, txtBankDistanceRef, txtBankStockRef, txtBankStatusRef, iconVerifiedRef); });
        if (chipRad15 != null) chipRad15.setOnClickListener(v -> { selectedRadiusKm = 15.0; resetRadiusStyle.run(); applyMapFilters(txtBankNameRef, txtBankDistanceRef, txtBankStockRef, txtBankStatusRef, iconVerifiedRef); });
        if (chipRad20 != null) chipRad20.setOnClickListener(v -> { selectedRadiusKm = 20.0; resetRadiusStyle.run(); applyMapFilters(txtBankNameRef, txtBankDistanceRef, txtBankStockRef, txtBankStatusRef, iconVerifiedRef); });
        if (chipRad30 != null) chipRad30.setOnClickListener(v -> { selectedRadiusKm = 30.0; resetRadiusStyle.run(); applyMapFilters(txtBankNameRef, txtBankDistanceRef, txtBankStockRef, txtBankStatusRef, iconVerifiedRef); });
        if (chipRad50 != null) chipRad50.setOnClickListener(v -> { selectedRadiusKm = 50.0; resetRadiusStyle.run(); applyMapFilters(txtBankNameRef, txtBankDistanceRef, txtBankStockRef, txtBankStatusRef, iconVerifiedRef); });

        // Group Chip Click Handlers
        if (chipGrpAll != null) chipGrpAll.setOnClickListener(v -> { selectedGroupFilter = "ALL"; applyMapFilters(txtBankNameRef, txtBankDistanceRef, txtBankStockRef, txtBankStatusRef, iconVerifiedRef); });
        if (chipGrpOPos != null) chipGrpOPos.setOnClickListener(v -> { selectedGroupFilter = "O+"; applyMapFilters(txtBankNameRef, txtBankDistanceRef, txtBankStockRef, txtBankStatusRef, iconVerifiedRef); });
        if (chipGrpONeg != null) chipGrpONeg.setOnClickListener(v -> { selectedGroupFilter = "O-"; applyMapFilters(txtBankNameRef, txtBankDistanceRef, txtBankStockRef, txtBankStatusRef, iconVerifiedRef); });
        if (chipGrpAPos != null) chipGrpAPos.setOnClickListener(v -> { selectedGroupFilter = "A+"; applyMapFilters(txtBankNameRef, txtBankDistanceRef, txtBankStockRef, txtBankStatusRef, iconVerifiedRef); });
        if (chipGrpBPos != null) chipGrpBPos.setOnClickListener(v -> { selectedGroupFilter = "B+"; applyMapFilters(txtBankNameRef, txtBankDistanceRef, txtBankStockRef, txtBankStatusRef, iconVerifiedRef); });
        if (chipGrpABPos != null) chipGrpABPos.setOnClickListener(v -> { selectedGroupFilter = "AB+"; applyMapFilters(txtBankNameRef, txtBankDistanceRef, txtBankStockRef, txtBankStatusRef, iconVerifiedRef); });

        // Map Layers Toggle
        if (btnLayersToggle != null) {
            btnLayersToggle.setOnClickListener(v -> {
                if (activeGoogleMap != null) {
                    int currentType = activeGoogleMap.getMapType();
                    if (currentType == GoogleMap.MAP_TYPE_NORMAL) {
                        activeGoogleMap.setMapType(GoogleMap.MAP_TYPE_SATELLITE);
                        Toast.makeText(this, "Map Layer: Satellite View", Toast.LENGTH_SHORT).show();
                    } else if (currentType == GoogleMap.MAP_TYPE_SATELLITE) {
                        activeGoogleMap.setMapType(GoogleMap.MAP_TYPE_TERRAIN);
                        Toast.makeText(this, "Map Layer: Terrain View", Toast.LENGTH_SHORT).show();
                    } else {
                        activeGoogleMap.setMapType(GoogleMap.MAP_TYPE_NORMAL);
                        Toast.makeText(this, "Map Layer: Standard Night View", Toast.LENGTH_SHORT).show();
                    }
                }
            });
        }

        // 📍 Find Nearest FAB Action (Dual Nearest Hospital + Blood Bank)
        if (btnFindNearest != null) {
            btnFindNearest.setOnClickListener(v -> {
                if (!isLocationPermissionGranted()) {
                    requestLocationPermission();
                    return;
                }

                SmartMapItem nearestHosp = null;
                SmartMapItem nearestBank = null;
                double minHospDist = Double.MAX_VALUE;
                double minBankDist = Double.MAX_VALUE;

                for (SmartMapItem item : smartMapItemList) {
                    double dist = calculateDistanceKm(userLat, userLng, item.lat, item.lng);
                    if ("HOSPITAL".equalsIgnoreCase(item.type)) {
                        if (dist < minHospDist) {
                            minHospDist = dist;
                            nearestHosp = item;
                        }
                    } else if ("BLOOD_BANK".equalsIgnoreCase(item.type)) {
                        if (dist < minBankDist) {
                            minBankDist = dist;
                            nearestBank = item;
                        }
                    }
                }

                LatLngBounds.Builder boundsBuilder = new LatLngBounds.Builder();
                boundsBuilder.include(new LatLng(userLat, userLng));

                if (nearestHosp != null && nearestHosp.marker != null) {
                    nearestHosp.marker.setVisible(true);
                    nearestHosp.marker.setIcon(BitmapDescriptorFactory.defaultMarker(BitmapDescriptorFactory.HUE_ORANGE));
                    nearestHosp.marker.setTitle("⭐ 🏥 NEAREST HOSPITAL: " + nearestHosp.name);
                    nearestHosp.marker.setZIndex(100f);
                    boundsBuilder.include(new LatLng(nearestHosp.lat, nearestHosp.lng));
                }

                if (nearestBank != null && nearestBank.marker != null) {
                    nearestBank.marker.setVisible(true);
                    nearestBank.marker.setIcon(BitmapDescriptorFactory.defaultMarker(BitmapDescriptorFactory.HUE_YELLOW));
                    nearestBank.marker.setTitle("⭐ 🩸 NEAREST BLOOD BANK: " + nearestBank.name);
                    nearestBank.marker.setZIndex(100f);
                    boundsBuilder.include(new LatLng(nearestBank.lat, nearestBank.lng));
                }

                if (activeGoogleMap != null) {
                    try {
                        activeGoogleMap.animateCamera(CameraUpdateFactory.newLatLngBounds(boundsBuilder.build(), 100));
                    } catch (Exception e) {
                        if (nearestBank != null) activeGoogleMap.animateCamera(CameraUpdateFactory.newLatLngZoom(new LatLng(nearestBank.lat, nearestBank.lng), 14.5f));
                    }
                }

                StringBuilder summary = new StringBuilder("⭐ NEAREST LOCATIONS:\n");
                if (nearestHosp != null) {
                    summary.append(String.format(java.util.Locale.US, "🏥 %s (%.1f km away)\n", nearestHosp.name, minHospDist));
                }
                if (nearestBank != null) {
                    summary.append(String.format(java.util.Locale.US, "🩸 %s (%.1f km away)", nearestBank.name, minBankDist));
                    selectMapItem(nearestBank, true, txtBankNameRef, txtBankDistanceRef, txtBankStockRef, txtBankStatusRef, iconVerifiedRef);
                }
                Toast.makeText(this, summary.toString(), Toast.LENGTH_LONG).show();
            });
        }

        // 🚨 Emergency Request FAB Action
        if (btnEmergencyReq != null) {
            btnEmergencyReq.setOnClickListener(v -> showEmergencyRequestDialog(txtBankNameRef, txtBankDistanceRef, txtBankStockRef, txtBankStatusRef, iconVerifiedRef));
        }

        // 🩸 Reserve Blood Stock Button Action
        if (btnReserveStock != null) {
            btnReserveStock.setOnClickListener(v -> showReserveBloodDialog());
        }

        // My Location FAB Action
        if (btnMyLocation != null) {
            btnMyLocation.setOnClickListener(v -> {
                if (activeGoogleMap != null) {
                    activeGoogleMap.animateCamera(CameraUpdateFactory.newLatLngZoom(new LatLng(userLat, userLng), 14.5f));
                }
                Toast.makeText(this, "Centering map on hospital GPS location...", Toast.LENGTH_SHORT).show();
            });
        }

        // STEP 6: 🧭 Navigation Intent to EXACT Selected Blood Bank
        if (btnNavigate != null) {
            btnNavigate.setOnClickListener(v -> {
                SmartMapItem targetBank = selectedBloodBank;

                if (targetBank == null || targetBank.lat == 0.0 || targetBank.lng == 0.0) {
                    if (currentBankLat != 0.0 && currentBankLng != 0.0) {
                        for (SmartMapItem item : smartMapItemList) {
                            if (item.lat == currentBankLat && item.lng == currentBankLng) {
                                targetBank = item;
                                break;
                            }
                        }
                    }
                }

                if (targetBank == null || targetBank.lat == 0.0 || targetBank.lng == 0.0) {
                    Toast.makeText(this, "Selected blood bank location is unavailable.", Toast.LENGTH_LONG).show();
                    return;
                }

                Toast.makeText(this, String.format(java.util.Locale.US, "🧭 Navigating to %s...", targetBank.name), Toast.LENGTH_SHORT).show();

                String uriStr = String.format(java.util.Locale.US, "google.navigation:q=%.6f,%.6f&mode=d", targetBank.lat, targetBank.lng);
                Uri gmmIntentUri = Uri.parse(uriStr);
                Intent mapIntent = new Intent(Intent.ACTION_VIEW, gmmIntentUri);
                mapIntent.setPackage("com.google.android.apps.maps");
                try {
                    startActivity(mapIntent);
                } catch (Exception e) {
                    Uri webUri = Uri.parse(String.format(java.util.Locale.US, "https://www.google.com/maps/dir/?api=1&origin=%.6f,%.6f&destination=%.6f,%.6f", userLat, userLng, targetBank.lat, targetBank.lng));
                    Intent webIntent = new Intent(Intent.ACTION_VIEW, webUri);
                    try {
                        startActivity(webIntent);
                    } catch (Exception ignored) {}
                }
            });
        }

        // 📞 Call Phone Action
        if (btnCallBank != null) {
            btnCallBank.setOnClickListener(v -> {
                Intent dialIntent = new Intent(Intent.ACTION_DIAL, Uri.parse("tel:" + currentBankPhone));
                try {
                    startActivity(dialIntent);
                } catch (Exception e) {
                    Toast.makeText(this, "Dialing " + currentBankName + "...", Toast.LENGTH_SHORT).show();
                }
            });
        }

        // My Location FAB Action
        if (btnMyLocation != null) {
            btnMyLocation.setOnClickListener(v -> {
                if (activeGoogleMap != null) {
                    activeGoogleMap.animateCamera(CameraUpdateFactory.newLatLngZoom(new LatLng(userLat, userLng), 14.5f));
                }
                Toast.makeText(this, "Centering map on hospital GPS location...", Toast.LENGTH_SHORT).show();
            });
        }

        if (inputSearch != null) {
            inputSearch.addTextChangedListener(new TextWatcher() {
                @Override public void beforeTextChanged(CharSequence s, int start, int count, int after) {}
                @Override public void onTextChanged(CharSequence s, int start, int before, int count) {}
                @Override
                public void afterTextChanged(Editable s) {
                    String query = s.toString().toLowerCase().trim();
                    if (!query.isEmpty()) {
                        for (SmartMapItem item : smartMapItemList) {
                            if (item.name.toLowerCase().contains(query) || item.area.toLowerCase().contains(query)) {
                                selectMapItem(item, true, txtBankNameRef, txtBankDistanceRef, txtBankStockRef, txtBankStatusRef, iconVerifiedRef);
                                break;
                            }
                        }
                    }
                }
            });
        }
    }

    private void showEmergencyRequestDialog(TextView txtBankName, TextView txtBankDistance, TextView txtBankStock, TextView txtBankStatus, ImageView iconVerified) {
        Dialog dialog = new Dialog(this);
        dialog.setContentView(R.layout.dialog_emergency_request);
        if (dialog.getWindow() != null) {
            dialog.getWindow().setLayout(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        }

        EditText inputGroup = dialog.findViewById(R.id.input_emergency_blood_group);
        EditText inputUnits = dialog.findViewById(R.id.input_emergency_units);
        EditText inputRef = dialog.findViewById(R.id.input_emergency_patient_ref);
        View btnSubmit = dialog.findViewById(R.id.btn_submit_emergency_request);
        View btnClose = dialog.findViewById(R.id.btn_close_emergency_dialog);

        if (btnClose != null) btnClose.setOnClickListener(v -> dialog.dismiss());

        if (btnSubmit != null) {
            btnSubmit.setOnClickListener(v -> {
                String inputStr = inputGroup != null ? inputGroup.getText().toString().trim() : "O-";
                String group;
                if (inputStr.equalsIgnoreCase("bombay") || inputStr.equalsIgnoreCase("oh") ||
                    inputStr.equalsIgnoreCase("hh") || inputStr.toLowerCase(Locale.US).contains("bombay")) {
                    group = "Bombay (Oh)";
                } else {
                    group = inputStr.toUpperCase(Locale.US);
                }
                if (TextUtils.isEmpty(group)) group = "O-";
                int units = 4;
                try {
                    if (inputUnits != null) units = Integer.parseInt(inputUnits.getText().toString().trim());
                } catch (Exception ignored) {}
                if (units <= 0) units = 4;

                String patientRef = inputRef != null ? inputRef.getText().toString().trim() : "Trauma Unit 3 (Emergency ICU)";

                UserProfile currentUser = repository.getCurrentUser();
                String hospitalId = currentUser != null ? currentUser.getUid() : "HOS-8842";
                String hospitalName = currentUser != null ? currentUser.getDisplayName() : "St. Jude General Hospital";
                String locationAddr = currentUser != null ? currentUser.getLocationAddress() : "Sangli, Maharashtra, India";

                String reqId = "EMG-" + (System.currentTimeMillis() % 100000);
                String timeStr = new SimpleDateFormat("hh:mm a", Locale.US).format(new Date());

                Map<String, Object> reqMap = new HashMap<>();
                reqMap.put("requestId", reqId);
                reqMap.put("hospitalId", hospitalId);
                reqMap.put("hospitalName", hospitalName);
                reqMap.put("bloodGroup", group);
                reqMap.put("quantity", units);
                reqMap.put("requiredUnits", units);
                reqMap.put("component", "Packed RBC");
                reqMap.put("urgency", "Emergency");
                reqMap.put("status", "PENDING_VERIFICATION");
                reqMap.put("createdAt", timeStr);
                reqMap.put("createdAtTimestamp", System.currentTimeMillis());
                reqMap.put("notes", patientRef);
                reqMap.put("patientRef", patientRef);
                reqMap.put("latitude", userLat);
                reqMap.put("longitude", userLng);
                reqMap.put("locationAddress", locationAddr);
                reqMap.put("assignedSource", "");
                reqMap.put("escalationStage", 1);

                try {
                    FirebaseFirestore.getInstance().collection("bloodRequests").document(reqId).set(reqMap);
                } catch (Exception ignored) {}

                // Save notification
                try {
                    Map<String, Object> notif = new HashMap<>();
                    notif.put("title", "🚨 Emergency Requisition Broadcasted");
                    notif.put("message", "Priority emergency request " + reqId + " for " + units + " units of " + group + " dispatched to network. Status: Pending Verification.");
                    notif.put("type", "EMERGENCY");
                    notif.put("timestamp", timeStr);
                    notif.put("createdAt", System.currentTimeMillis());
                    notif.put("isRead", false);
                    FirebaseFirestore.getInstance().collection("notifications").add(notif);
                } catch (Exception ignored) {}

                BloodRequest newReq = new BloodRequest(reqId, hospitalId, hospitalName, group, "Packed RBC", units, "Emergency", "PENDING_VERIFICATION", timeStr, patientRef, userLat, userLng, locationAddr);
                repository.getRequests().add(0, newReq);
                repository.addAuditLog(hospitalId, "HOSPITAL", "EMERGENCY_DISPATCH", reqId, timeStr, "PENDING_VERIFICATION", "PENDING_VERIFICATION", "Emergency request for " + units + " units " + group + " submitted. Pending Verification.");

                dialog.dismiss();

                selectedGroupFilter = group;
                selectedRadiusKm = -1; // Expand radius for emergency
                if (txtBankName != null && activeGoogleMap != null) {
                    applyMapFilters(txtBankName, txtBankDistance, txtBankStock, txtBankStatus, iconVerified);
                }

                Toast.makeText(this, "🚨 Emergency Request " + reqId + " Dispatched! Status: Pending Verification.", Toast.LENGTH_LONG).show();
            });
        }

        dialog.show();
    }

    private void showReserveBloodDialog() {
        Dialog dialog = new Dialog(this);
        dialog.setContentView(R.layout.dialog_reserve_blood);
        if (dialog.getWindow() != null) {
            dialog.getWindow().setLayout(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        }

        String targetBankName = selectedBloodBank != null ? selectedBloodBank.name : currentBankName;
        String targetBankId = selectedBloodBank != null ? selectedBloodBank.id : "BB-101";

        TextView txtTarget = dialog.findViewById(R.id.txt_reserve_bank_target);
        if (txtTarget != null) txtTarget.setText("Target Supplier: " + targetBankName);

        EditText inputGroup = dialog.findViewById(R.id.input_reserve_blood_group);
        EditText inputUnits = dialog.findViewById(R.id.input_reserve_units);
        EditText inputComp = dialog.findViewById(R.id.input_reserve_component);
        View btnConfirm = dialog.findViewById(R.id.btn_confirm_reservation);
        View btnClose = dialog.findViewById(R.id.btn_close_reserve_dialog);

        if (btnClose != null) btnClose.setOnClickListener(v -> dialog.dismiss());

        if (btnConfirm != null) {
            btnConfirm.setOnClickListener(v -> {
                String inputStr = inputGroup != null ? inputGroup.getText().toString().trim() : "O+";
                String group;
                if (inputStr.equalsIgnoreCase("bombay") || inputStr.equalsIgnoreCase("oh") ||
                    inputStr.equalsIgnoreCase("hh") || inputStr.toLowerCase(Locale.US).contains("bombay")) {
                    group = "Bombay (Oh)";
                } else {
                    group = inputStr.toUpperCase(Locale.US);
                }
                if (TextUtils.isEmpty(group)) group = "O+";

                int units = 2;
                try {
                    if (inputUnits != null) units = Integer.parseInt(inputUnits.getText().toString().trim());
                } catch (Exception ignored) {}
                if (units <= 0) {
                    Toast.makeText(this, "Please enter a valid quantity of units (> 0).", Toast.LENGTH_SHORT).show();
                    return;
                }

                String comp = inputComp != null && !inputComp.getText().toString().trim().isEmpty()
                        ? inputComp.getText().toString().trim() : "Packed RBC";

                UserProfile currentUser = repository.getCurrentUser();
                String hospitalId = currentUser != null ? currentUser.getUid() : "HOS-8842";
                String hospitalName = currentUser != null ? currentUser.getDisplayName() : "St. Jude General Hospital";

                String resId = "RES-2026-" + (System.currentTimeMillis() % 100000);
                String timeStr = new SimpleDateFormat("hh:mm a", Locale.US).format(new Date());
                String timeStr = new SimpleDateFormat("hh:mm a", Locale.US).format(new Date());

                Map<String, Object> resMap = new HashMap<>();
                resMap.put("reservationId", resId);
                resMap.put("hospitalId", hospitalId);
                resMap.put("hospitalName", hospitalName);
                resMap.put("bloodBankId", targetBankId);
                resMap.put("bloodBankName", targetBankName);
                resMap.put("bloodGroup", group);
                resMap.put("component", comp);
                resMap.put("quantity", units);
                resMap.put("status", "Pending");
                resMap.put("createdAt", timeStr);
                resMap.put("createdAtTimestamp", System.currentTimeMillis());

                try {
                    FirebaseFirestore.getInstance().collection("bloodReservations").document(resId).set(resMap);
                } catch (Exception ignored) {}

                // Save notification
                try {
                    Map<String, Object> notif = new HashMap<>();
                    notif.put("hospitalId", hospitalId);
                    notif.put("title", "Stock Reservation Submitted");
                    notif.put("message", "Reservation " + resId + " for " + units + " units of " + group + " submitted at " + targetBankName + ".");
                    notif.put("type", "RESERVATION");
                    notif.put("timestamp", timeStr);
                    notif.put("createdAt", System.currentTimeMillis());
                    notif.put("isRead", false);
                    FirebaseFirestore.getInstance().collection("notifications").add(notif);
                } catch (Exception ignored) {}

                repository.addAuditLog(hospitalId, "HOSPITAL", "RESERVE_STOCK", resId, timeStr, "AVAILABLE", "RESERVED", "Reserved " + units + " units " + group + " at " + targetBankName);

                dialog.dismiss();
                Toast.makeText(this, "✅ Blood Reservation " + resId + " Submitted at " + targetBankName + "!", Toast.LENGTH_LONG).show();
            });
        }

        dialog.show();
    }

    // ROLE-SCOPED REGISTRATION DIALOGS

    private void showRegisterRoleDialog() {
        Dialog dialog = new Dialog(this);
        dialog.setContentView(R.layout.dialog_register_role);
        if (dialog.getWindow() != null) {
            dialog.getWindow().setLayout(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        }

        View roleDonor = dialog.findViewById(R.id.reg_role_donor);
        View roleHospital = dialog.findViewById(R.id.reg_role_hospital);
        View roleBank = dialog.findViewById(R.id.reg_role_bloodbank);
        View btnClose = dialog.findViewById(R.id.btn_close_register_dialog);

        if (roleDonor != null) {
            roleDonor.setOnClickListener(v -> {
                dialog.dismiss();
                showRegisterDonorDialog();
            });
        }

        if (roleHospital != null) {
            roleHospital.setOnClickListener(v -> {
                dialog.dismiss();
                showRegisterHospitalDialog();
            });
        }

        if (roleBank != null) {
            roleBank.setOnClickListener(v -> {
                dialog.dismiss();
                showRegisterBloodBankDialog();
            });
        }

        if (btnClose != null) btnClose.setOnClickListener(v -> dialog.dismiss());
        dialog.show();
    }

    private void showRegisterDonorDialog() {
        Dialog dialog = new Dialog(this);
        dialog.setContentView(R.layout.dialog_register_donor);
        if (dialog.getWindow() != null) {
            dialog.getWindow().setLayout(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        }

        EditText inputName = dialog.findViewById(R.id.reg_donor_name);
        EditText inputEmail = dialog.findViewById(R.id.reg_donor_email);
        EditText inputMobile = dialog.findViewById(R.id.reg_donor_mobile);
        View inputGroupView = dialog.findViewById(R.id.reg_donor_group);
        EditText inputDob = dialog.findViewById(R.id.reg_donor_dob);
        View inputGenderView = dialog.findViewById(R.id.reg_donor_gender);
        EditText inputCity = dialog.findViewById(R.id.reg_donor_city);
        EditText inputPassword = dialog.findViewById(R.id.reg_donor_password);
        EditText inputConfirmPassword = dialog.findViewById(R.id.reg_donor_confirm_password);
        TextView txtError = dialog.findViewById(R.id.reg_donor_error_text);

        View btnSubmit = dialog.findViewById(R.id.btn_submit_reg_donor);
        View btnClose = dialog.findViewById(R.id.btn_close_reg_donor);

        // 📅 Calendar DatePicker setup for Date of Birth
        if (inputDob != null) {
            inputDob.setFocusable(false);
            inputDob.setClickable(true);
            View.OnClickListener datePickerListener = v -> {
                java.util.Calendar cal = java.util.Calendar.getInstance();
                int year = cal.get(java.util.Calendar.YEAR) - 20;
                int month = cal.get(java.util.Calendar.MONTH);
                int day = cal.get(java.util.Calendar.DAY_OF_MONTH);

                android.app.DatePickerDialog datePickerDialog = new android.app.DatePickerDialog(
                    this,
                    (view, selectedYear, selectedMonth, selectedDay) -> {
                        String dateStr = String.format(java.util.Locale.US, "%04d-%02d-%02d", selectedYear, selectedMonth + 1, selectedDay);
                        inputDob.setText(dateStr);
                    },
                    year, month, day
                );
                datePickerDialog.getDatePicker().setMaxDate(System.currentTimeMillis());
        View btnClose = dialog.findViewById(R.id.btn_close_public_search);

        View btnCall = dialog.findViewById(R.id.btn_public_call_1);
        View btnDirections = dialog.findViewById(R.id.btn_public_directions_1);

        if (btnSearch != null) {
            btnSearch.setOnClickListener(v -> {
                String group = inputGroup != null ? inputGroup.getText().toString().trim() : "O+";
                String comp = inputComponent != null ? inputComponent.getText().toString().trim() : "RBC";
                String city = inputCity != null ? inputCity.getText().toString().trim() : "Metro City";

                List<InventoryItem> results = repository.searchPublicEmergencyBlood(group, comp, city);
                if (results.isEmpty()) {
                    Toast.makeText(this, "No matching blood stock found nearby in " + city + ". Try searching another location.", Toast.LENGTH_LONG).show();
                } else {
                    Toast.makeText(this, "Found " + results.size() + " blood bank reserve matches for " + group + "!", Toast.LENGTH_SHORT).show();
                }
            });
        }

        if (btnCall != null) btnCall.setOnClickListener(v -> Toast.makeText(this, "Dialing City Central Blood Bank (+1 555-019-2839)...", Toast.LENGTH_SHORT).show());
        if (btnDirections != null) btnDirections.setOnClickListener(v -> Toast.makeText(this, "Opening GPS Directions to City Central Blood Bank...", Toast.LENGTH_SHORT).show());
        if (btnClose != null) btnClose.setOnClickListener(v -> dialog.dismiss());

        dialog.show();
    }

