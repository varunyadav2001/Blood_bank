    private void showEditHospitalProfileDialog() {
        Dialog dialog = new Dialog(this);
        dialog.setContentView(R.layout.dialog_edit_hospital_profile);
        if (dialog.getWindow() != null) {
            dialog.getWindow().setLayout(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        }

        UserProfile currentUser = repository.getCurrentUser();
        EditText editName = dialog.findViewById(R.id.edit_hospital_name);
        EditText editPhone = dialog.findViewById(R.id.edit_hospital_phone);
        EditText editCity = dialog.findViewById(R.id.edit_hospital_city);
        EditText editAddr = dialog.findViewById(R.id.edit_hospital_address);
        View btnSave = dialog.findViewById(R.id.btn_save_hospital_profile);
        View btnClose = dialog.findViewById(R.id.btn_close_edit_profile);

        if (currentUser != null) {
            if (editName != null && currentUser.getDisplayName() != null) editName.setText(currentUser.getDisplayName());
            if (editPhone != null && currentUser.getMobileNumber() != null) editPhone.setText(currentUser.getMobileNumber());
            if (editCity != null && currentUser.getCity() != null) editCity.setText(currentUser.getCity());
            if (editAddr != null && currentUser.getLocationAddress() != null) editAddr.setText(currentUser.getLocationAddress());
        }

        if (btnClose != null) btnClose.setOnClickListener(v -> dialog.dismiss());

        if (btnSave != null) {
            btnSave.setOnClickListener(v -> {
                String name = editName != null ? editName.getText().toString().trim() : "";
                String phone = editPhone != null ? editPhone.getText().toString().trim() : "";
                String city = editCity != null ? editCity.getText().toString().trim() : "";
                String addr = editAddr != null ? editAddr.getText().toString().trim() : "";

                if (TextUtils.isEmpty(name) || TextUtils.isEmpty(phone)) {
                    Toast.makeText(this, "Name and phone number cannot be empty.", Toast.LENGTH_SHORT).show();
                    return;
                }

                if (currentUser != null) {
                    Map<String, Object> updates = new HashMap<>();
                    updates.put("name", name);
                    updates.put("displayName", name);
                    updates.put("phone", phone);
                    updates.put("city", city);
                    updates.put("locationAddress", addr);
                    updates.put("locationUpdatedAt", System.currentTimeMillis());

                    FirebaseFirestore db = FirebaseFirestore.getInstance();
                    try {
                        db.collection("users").document(currentUser.getUid()).update(updates);
                    } catch (Exception ignored) {}

                    String bankId = currentUser.getBloodBankId() != null ? currentUser.getBloodBankId() : currentUser.getUid();
                    if (currentRole == UserRole.BLOOD_BANK) {
                        Map<String, Object> bankUpdates = new HashMap<>();
                        bankUpdates.put("name", name);
                        bankUpdates.put("phone", phone);
                        bankUpdates.put("city", city);
                        bankUpdates.put("address", addr);
                        bankUpdates.put("locationAddress", addr);
                        bankUpdates.put("updatedAt", System.currentTimeMillis());
                        try {
                            db.collection("bloodBanks").document(bankId).update(bankUpdates);
                        } catch (Exception ignored) {}

                        for (SmartMapItem item : smartMapItemList) {
                            if ("BLOOD_BANK".equalsIgnoreCase(item.type) && 
                                (item.id.equalsIgnoreCase(bankId) || item.id.equalsIgnoreCase(currentUser.getUid()))) {
                                item.name = name;
                                item.phone = phone;
                                item.area = city;
                                break;
                            }
                        }
                    }

                    UserProfile updatedProfile = new UserProfile(currentUser.getUid(), currentUser.getEmail(), phone, name, currentUser.getRole(), currentUser.isEmailVerified(), currentUser.isBiometricEnabled(), name, city);
                    updatedProfile.setLatitude(currentUser.getLatitude());
                    updatedProfile.setLongitude(currentUser.getLongitude());
                    updatedProfile.setLocationAddress(addr);
                    updatedProfile.setBloodBankId(currentUser.getBloodBankId());

                    repository.setCurrentUser(updatedProfile);
                    repository.saveUserProfile(updatedProfile);
                    updateRoleUI(updatedProfile);

                    dialog.dismiss();
                    String roleLabel = (currentRole == UserRole.BLOOD_BANK) ? "Blood Bank" : "Hospital";
                    Toast.makeText(this, "✓ " + roleLabel + " Profile Updated Successfully!", Toast.LENGTH_SHORT).show();
                    loadView(R.layout.view_profile, this::bindProfileView);
                } else {
                    dialog.dismiss();
                }
            });
        }

        dialog.show();
    }

    private void bindDonorDashboardV2(View view) {
        View glowRed = view.findViewById(R.id.bg_glow_donor_dash_red);
        View waveDonor = view.findViewById(R.id.bg_wave_donor_dash);

        if (glowRed != null) {
            android.animation.ObjectAnimator pulseRed = android.animation.ObjectAnimator.ofFloat(glowRed, "alpha", 0.50f, 0.95f, 0.50f);
            pulseRed.setDuration(3800);
            pulseRed.setRepeatCount(android.animation.ValueAnimator.INFINITE);
            pulseRed.start();
        }
        if (waveDonor != null) {
            android.animation.ObjectAnimator waveAnim = android.animation.ObjectAnimator.ofFloat(waveDonor, "translationY", -10f, 10f, -10f);
            waveAnim.setDuration(7600);
            waveAnim.setRepeatCount(android.animation.ValueAnimator.INFINITE);
            waveAnim.start();
        }
        TextView btnToggle = view.findViewById(R.id.btn_donor_toggle_availability);
        if (btnToggle != null) {
            btnToggle.setText(isDonorAvailable ? "🟢 Available" : "🔴 Unavailable");
            btnToggle.setOnClickListener(v -> {
                isDonorAvailable = !isDonorAvailable;
                btnToggle.setText(isDonorAvailable ? "🟢 Available" : "🔴 Unavailable");
                repository.addAuditLog("DNR-902", "DONOR", "UPDATE_AVAILABILITY", "DNR-902", "10:20 AM", isDonorAvailable ? "UNAVAILABLE" : "AVAILABLE", isDonorAvailable ? "AVAILABLE" : "UNAVAILABLE", "Donor availability updated.");
                Toast.makeText(this, "Donor availability updated", Toast.LENGTH_SHORT).show();
            });
        }

        View btnRespond = view.findViewById(R.id.btn_donor_respond_emergency);
        if (btnRespond != null) {
            btnRespond.setOnClickListener(v -> {
                repository.addAuditLog("DNR-902", "DONOR", "ACCEPT_EMERGENCY", "REQ-2026-904", "10:22 AM", "SEARCHING", "RESPONDED", "Donor accepted emergency request.");
                loadView(R.layout.view_emergency_center, this::bindEmergencyCenterView);
            });
        }
    }

    private void bindEmergencyCenterView(View view) {
        TextView txtTimer = view.findViewById(R.id.txt_live_timer);
        if (txtTimer != null) {
            if (emergencyTimer != null) emergencyTimer.cancel();
            emergencyTimer = new CountDownTimer(900000, 1000) {
                @Override
                        // Bombay Blood Group keywords
                        if (query.equals("bombay") || query.equals("bombay blood") || query.equals("bombay blood group") ||
                            query.equals("oh") || query.equals("hh") || query.equals("bombay (oh)")) {
                            groupMatch = getNumericStock(item.stockMap, "Bombay") > 0;
                        } else {
                            String queryUpper = query.toUpperCase(Locale.US).replace(" ", "");
                            if (queryUpper.equals("O+") || queryUpper.equals("O-") || queryUpper.equals("A+") ||
                                queryUpper.equals("A-") || queryUpper.equals("B+") || queryUpper.equals("B-") ||
                                queryUpper.equals("AB+") || queryUpper.equals("AB-")) {
                                groupMatch = getNumericStock(item.stockMap, queryUpper) > 0;
                            }
                        }
                        passesSearch = nameMatch || areaMatch || groupMatch;
                    }

                    if (!passesSearch) continue;

                    matches.add(item);
                }

                // Log for development and verification
                android.util.Log.d("BloodFilter", "Selected Filter: " + filter + " | Total Banks: " + smartMapItemList.size() + " | Matching: " + matches.size());

                // 3. Sort by distance ascending (nearest to farthest: e.g. 0.3 KM, 0.8 KM, 1.1 KM ... 40.5 KM)
                java.util.Collections.sort(matches, (a, b) -> Double.compare(a.distanceKm, b.distanceKm));

                // 4. Update dynamic result count label
                TextView txtCount = view.findViewById(R.id.txt_inventory_count);
                if (txtCount != null) {
                    if ("ALL".equalsIgnoreCase(filter)) {
                        txtCount.setText(matches.size() + " Blood Banks within 50 KM");
                    } else if ("O_POS".equalsIgnoreCase(filter) || "O+".equalsIgnoreCase(filter)) {
                        txtCount.setText(matches.size() + " Blood Banks with O+ Stock (within 50 KM)");
                    } else if ("O_NEG_EMERGENCY".equalsIgnoreCase(filter) || "O-".equalsIgnoreCase(filter)) {
                        txtCount.setText(matches.size() + " Blood Banks with O- Emergency Stock (within 50 KM)");
                    } else if ("A_POS".equalsIgnoreCase(filter) || "A+".equalsIgnoreCase(filter)) {
                        txtCount.setText(matches.size() + " Blood Banks with A+ Stock (within 50 KM)");
                    } else if ("A_NEG".equalsIgnoreCase(filter) || "A-".equalsIgnoreCase(filter)) {
                        txtCount.setText(matches.size() + " Blood Banks with A- Stock (within 50 KM)");
                    repository.setCurrentUser(currentUser);
                    repository.saveUserProfile(currentUser);
                    updateRoleUI(currentUser);

                    dialog.dismiss();
                    Toast.makeText(this, "Profile updated successfully.", Toast.LENGTH_SHORT).show();
                    loadView(R.layout.view_profile, this::bindProfileView);
                } else {
                    dialog.dismiss();
                }
            });
        }

        dialog.show();
    }

    private double donorBookingFilterRadius = 50.0;

    private void ensureSmartMapBloodBanks() {
        boolean hasBank = false;
        for (SmartMapItem item : smartMapItemList) {
            if ("BLOOD_BANK".equalsIgnoreCase(item.type)) {
                hasBank = true;
                break;
            }
        }
        if (!hasBank) {
            List<RawBank> rawList = getMasterBloodBankList();
            for (RawBank b : rawList) {
                Map<String, Integer> stock = defaultStockForBank(b.name);
                int total = 0;
                for (int v : stock.values()) total += v;
                SmartMapItem item = new SmartMapItem(b.id, b.name, "BLOOD_BANK", b.lat, b.lng, b.phone, b.city, true, total, stock);
                smartMapItemList.add(item);
            }
        }
    }

    private void showDonorBloodBankPickerDialog(List<SmartMapItem> bankList, SmartMapItem[] selectedHolder, Runnable onSelectCallback) {
        if (bankList == null || bankList.isEmpty()) {
