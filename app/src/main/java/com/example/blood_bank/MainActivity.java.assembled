                // Determine actual UserRole
                UserRole actualRole = UserRole.DONOR;
                String roleLower = rawRole.toLowerCase().trim();
                if (roleLower.contains("admin")) {
            stock.put("Bombay", 0);
        }
        return stock;
    }

    private void handleSuccessfulAuthLogin(String uid, String email, UserRole expectedRole, TextView txtError, TextView btnSubmit) {
        FirebaseFirestore db = FirebaseFirestore.getInstance();
        UserProfile cached = repository.getUserProfileByEmail(email);

        db.collection("users").document(uid).get()
            .addOnCompleteListener(roleTask -> {
                String rawRole = cached != null ? cached.getRole() : "DONOR";
                String displayName = cached != null ? cached.getDisplayName() : "User";
                String bloodBankId = cached != null && cached.getBloodBankId() != null ? cached.getBloodBankId() : ("BB-" + uid.substring(0, Math.min(8, uid.length())));
                String city = cached != null && cached.getCity() != null ? cached.getCity() : "Sangli";
                String address = city + ", Maharashtra";
                String phone = cached != null ? cached.getMobileNumber() : "";

                if (roleTask.isSuccessful() && roleTask.getResult() != null && roleTask.getResult().exists()) {
                    DocumentSnapshot doc = roleTask.getResult();
                    if (cached == null) {
                        if (doc.getString("role") != null) rawRole = doc.getString("role");
                        if (doc.getString("name") != null) displayName = doc.getString("name");
                        else if (doc.getString("displayName") != null) displayName = doc.getString("displayName");
                        else if (doc.getString("bloodBankName") != null) displayName = doc.getString("bloodBankName");
            stock.put("A+", 14);
            stock.put("A-", 2);
            stock.put("B+", 8);
            stock.put("B-", 2);
            stock.put("AB+", 5);
            stock.put("AB-", 1);
            stock.put("Bombay (Oh)", 0);
            stock.put("Bombay", 0);
        } else if (nLower.contains("civil") || nLower.contains("government")) {
            stock.put("O+", 25);
            stock.put("O-", 6);
            stock.put("A+", 20);
            stock.put("A-", 5);
            stock.put("B+", 15);
            stock.put("B-", 4);
            stock.put("AB+", 8);
            stock.put("AB-", 2);
            stock.put("Bombay (Oh)", 2);
            stock.put("Bombay", 2);
        } else {
            stock.put("O+", 15);
            stock.put("O-", 4);
            stock.put("A+", 12);
            stock.put("A-", 3);
            stock.put("B+", 10);
            stock.put("B-", 2);
            stock.put("AB+", 6);
            stock.put("AB-", 1);
            stock.put("Bombay (Oh)", 0);
            stock.put("Bombay", 0);
        }
        return stock;
    }

    private void handleSuccessfulAuthLogin(String uid, String email, UserRole expectedRole, TextView txtError, TextView btnSubmit) {
        FirebaseFirestore db = FirebaseFirestore.getInstance();
        UserProfile cached = repository.getUserProfileByEmail(email);

        db.collection("users").document(uid).get()
            .addOnCompleteListener(roleTask -> {
                String rawRole = cached != null ? cached.getRole() : "DONOR";
                String displayName = cached != null ? cached.getDisplayName() : "User";
                String bloodBankId = cached != null && cached.getBloodBankId() != null ? cached.getBloodBankId() : ("BB-" + uid.substring(0, Math.min(8, uid.length())));
                String city = cached != null && cached.getCity() != null ? cached.getCity() : "Sangli";
                String address = city + ", Maharashtra";
                String phone = cached != null ? cached.getMobileNumber() : "";

                if (roleTask.isSuccessful() && roleTask.getResult() != null && roleTask.getResult().exists()) {
                    DocumentSnapshot doc = roleTask.getResult();
                    if (cached == null) {
                        if (doc.getString("role") != null) rawRole = doc.getString("role");
                        if (doc.getString("name") != null) displayName = doc.getString("name");
                        else if (doc.getString("displayName") != null) displayName = doc.getString("displayName");
                        else if (doc.getString("bloodBankName") != null) displayName = doc.getString("bloodBankName");
                        if (doc.getString("bloodBankId") != null) bloodBankId = doc.getString("bloodBankId");
                        if (doc.getString("city") != null) city = doc.getString("city");
                        if (doc.getString("locationAddress") != null) address = doc.getString("locationAddress");
                        else if (doc.getString("address") != null) address = doc.getString("address");
                        if (doc.getString("phone") != null) phone = doc.getString("phone");
                    }
                } else if (cached == null && expectedRole == UserRole.BLOOD_BANK) {
                    showLoginError(txtError, btnSubmit, "Blood Bank profile not found for this account.");
                    try {
                        FirebaseAuth.getInstance().signOut();
                    } catch (Exception ignored) {}
                    return;
                }

                // Synchronize users document in Firestore
                Map<String, Object> uMap = new HashMap<>();
                uMap.put("uid", uid);
                uMap.put("email", email);
                uMap.put("role", expectedRole.name());
                uMap.put("name", displayName);
                uMap.put("displayName", displayName);
                uMap.put("bloodBankName", displayName);
                uMap.put("bloodBankId", bloodBankId);
                uMap.put("city", city);
                uMap.put("phone", phone);
                uMap.put("locationAddress", address);
                uMap.put("updatedAt", System.currentTimeMillis());
                db.collection("users").document(uid).set(uMap, com.google.firebase.firestore.SetOptions.merge());

                // Determine actual UserRole
                UserRole actualRole = UserRole.DONOR;
                String roleLower = rawRole.toLowerCase().trim();
                if (roleLower.contains("admin")) {
                    actualRole = UserRole.ADMIN;
                } else if (roleLower.contains("bank")) {
                    actualRole = UserRole.BLOOD_BANK;
                } else if (roleLower.contains("hospital")) {
                    actualRole = UserRole.HOSPITAL;
                } else {
                    actualRole = UserRole.DONOR;
                }

                // ROLE AUTHORIZATION VALIDATION
                if (actualRole != expectedRole) {
                    try {
                        FirebaseAuth.getInstance().signOut();
                    } catch (Exception ignored) {}

                    if (btnSubmit != null) {
                        btnSubmit.setEnabled(true);
                        btnSubmit.setText("Sign In");
                    }

                    String mismatchMsg = "You are not authorized to access this portal.";
                    if (expectedRole == UserRole.BLOOD_BANK) {
                        mismatchMsg = "You are not authorized to access the Blood Bank Portal.";
                    } else if (expectedRole == UserRole.HOSPITAL) {
                        mismatchMsg = "You are not authorized to access the Hospital Portal.";
                    } else if (expectedRole == UserRole.DONOR) {
                        mismatchMsg = "You are not authorized to access the Donor Portal.";
                    }

                    if (txtError != null) {
                        txtError.setText(mismatchMsg);
                        txtError.setVisibility(View.VISIBLE);
                    } else {
                        Toast.makeText(this, mismatchMsg, Toast.LENGTH_LONG).show();
                    }
                    return;
                }

                final String finalDisplayName = displayName;
                final String finalCity = city;
                final String finalAddress = address;
                final String finalPhone = phone;
                final String finalBbId = bloodBankId;

                UserProfile userProfile = new UserProfile(uid, email, phone, displayName, actualRole.name(), true, true, displayName, city);
                userProfile.setBloodBankId(finalBbId);
                userProfile.setLocationAddress(address);
                repository.setCurrentUser(userProfile);
                repository.saveUserProfile(userProfile);

                android.util.Log.d("SmartBloodAuth", "================ LOGIN USER ================");
                android.util.Log.d("SmartBloodAuth", "LOGIN USER: " + email + " (UID: " + uid + ")");
                android.util.Log.d("SmartBloodAuth", "ROLE: " + actualRole.name());
                android.util.Log.d("SmartBloodAuth", "BLOOD BANK ID: " + finalBbId);
                android.util.Log.d("SmartBloodAuth", "NAME: " + finalDisplayName);

                // Ensure blood bank document exists in Firestore without overwriting existing stock
                if (actualRole == UserRole.BLOOD_BANK) {
                    db.collection("bloodBanks").document(finalBbId).get().addOnSuccessListener(bankDocSnap -> {
                        if (bankDocSnap != null && bankDocSnap.exists() && bankDocSnap.contains("bloodStock")) {
                            Map<String, Integer> loadedStock = extractStockMapFromDoc(bankDocSnap);
                            int loadedTotal = 0;
                            for (int v : loadedStock.values()) loadedTotal += v;
                            android.util.Log.d("SmartBloodAuth", "ON LOGIN: LOADED FIREBASE VALUE: " + loadedStock);
                            android.util.Log.d("SmartBloodAuth", "TOTAL UNITS FROM FIREBASE: " + loadedTotal);

                            // Update in-memory cache with persisted Firebase stock
                            for (SmartMapItem item : smartMapItemList) {
                                if ("BLOOD_BANK".equalsIgnoreCase(item.type) && 
                                    (item.id.equalsIgnoreCase(finalBbId) || (item.name != null && item.name.equalsIgnoreCase(finalDisplayName)))) {
                                    item.stockMap = loadedStock;
                                    item.totalUnits = loadedTotal;
                                    break;
                                }
                            }

                            // Update facility profile metadata without touching stock
                            Map<String, Object> metaUpdates = new HashMap<>();
                            metaUpdates.put("bloodBankId", finalBbId);
                            metaUpdates.put("userId", uid);
                            metaUpdates.put("name", finalDisplayName);
                            metaUpdates.put("city", finalCity);
                            metaUpdates.put("address", finalAddress);
                            metaUpdates.put("phone", finalPhone);
                            metaUpdates.put("verified", true);
                            db.collection("bloodBanks").document(finalBbId).set(metaUpdates, com.google.firebase.firestore.SetOptions.merge());
                        } else {
                            // Document does not exist in Firestore - create initial record once
                            Map<String, Object> bDoc = new HashMap<>();
        return rawList;
    }

