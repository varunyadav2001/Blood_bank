                        ("O_NEG_EMERGENCY".equalsIgnoreCase(current) && "O-".equalsIgnoreCase(k)) ||
                        ("A_POS".equalsIgnoreCase(current) && "A+".equalsIgnoreCase(k)) ||
                        ("B_POS".equalsIgnoreCase(current) && "B+".equalsIgnoreCase(k));
                    if (isSelected) {
                        ch.setBackgroundResource(R.drawable.bg_button_primary);
                        ch.setTextColor(ContextCompat.getColor(this, R.color.white));
                    } else {
                        ch.setBackgroundResource(R.drawable.bg_chip_status_pending);
                        ch.setTextColor(ContextCompat.getColor(this, R.color.text_secondary));
                    }
                }
            };

            Runnable refreshBankList = () -> {
                if (container == null) return;
                container.removeAllViews();

                String query = inputSearch != null ? inputSearch.getText().toString().toLowerCase(Locale.US).trim() : "";
                String filter = selectedBloodFilter[0];

                double hospLat = (userLat != 0.0 && !Double.isNaN(userLat)) ? userLat : 16.8524;
                double hospLng = (userLng != 0.0 && !Double.isNaN(userLng)) ? userLng : 74.5815;
                UserProfile currentUser = repository.getCurrentUser();
                if (currentUser != null && currentUser.getLatitude() != 0.0 && currentUser.getLongitude() != 0.0) {
                    hospLat = currentUser.getLatitude();
                    hospLng = currentUser.getLongitude();
                }

                List<SmartMapItem> matches = new ArrayList<>();
                for (SmartMapItem item : smartMapItemList) {
                    if (!"BLOOD_BANK".equalsIgnoreCase(item.type)) continue;

                    // Calculate distance in KM from current hospital location
                    double dist = calculateDistanceInKm(hospLat, hospLng, item.lat, item.lng);
                    item.distanceKm = dist;

                    // Keep EVERY valid blood bank where distanceKm <= 50.0 KM (no artificial limit)
                    if (dist < 0.0 || dist > 50.0) {
                        continue;
                    }

                    // 1. Evaluate selected quick filter against real numeric stock using EXACT same method as card
                    boolean passesFilter = true;
                    if ("ALL".equalsIgnoreCase(filter)) {
                        passesFilter = true;
                    } else if ("O_POS".equalsIgnoreCase(filter) || "O+".equalsIgnoreCase(filter) || "O+ Stock".equalsIgnoreCase(filter)) {
                        passesFilter = getNumericStock(item.stockMap, "O+") > 0;
                    } else if ("O_NEG_EMERGENCY".equalsIgnoreCase(filter) || "O-".equalsIgnoreCase(filter) || "O- Emergency".equalsIgnoreCase(filter)) {
                        passesFilter = getNumericStock(item.stockMap, "O-") > 0;
                    } else if ("A_POS".equalsIgnoreCase(filter) || "A+".equalsIgnoreCase(filter) || "A+ Stock".equalsIgnoreCase(filter)) {
                        passesFilter = getNumericStock(item.stockMap, "A+") > 0;
                    } else if ("A_NEG".equalsIgnoreCase(filter) || "A-".equalsIgnoreCase(filter) || "A- Stock".equalsIgnoreCase(filter)) {
                        passesFilter = getNumericStock(item.stockMap, "A-") > 0;
                    } else if ("B_POS".equalsIgnoreCase(filter) || "B+".equalsIgnoreCase(filter) || "B+ Stock".equalsIgnoreCase(filter)) {
                        passesFilter = getNumericStock(item.stockMap, "B+") > 0;
                    } else if ("B_NEG".equalsIgnoreCase(filter) || "B-".equalsIgnoreCase(filter) || "B- Stock".equalsIgnoreCase(filter)) {
                        passesFilter = getNumericStock(item.stockMap, "B-") > 0;
                    } else if ("AB_POS".equalsIgnoreCase(filter) || "AB+".equalsIgnoreCase(filter) || "AB+ Stock".equalsIgnoreCase(filter)) {
                        passesFilter = getNumericStock(item.stockMap, "AB+") > 0;
                    } else if ("AB_NEG".equalsIgnoreCase(filter) || "AB-".equalsIgnoreCase(filter) || "AB- Stock".equalsIgnoreCase(filter)) {
                        passesFilter = getNumericStock(item.stockMap, "AB-") > 0;
                    } else if ("BOMBAY".equalsIgnoreCase(filter) || "Bombay (Oh)".equalsIgnoreCase(filter)) {
                        passesFilter = getNumericStock(item.stockMap, "Bombay") > 0;
                    } else {
                        passesFilter = getNumericStock(item.stockMap, filter) > 0;
                updateChipStyles.run();
                refreshBankList.run();
            });
            if (chipONeg != null) chipONeg.setOnClickListener(v -> {
