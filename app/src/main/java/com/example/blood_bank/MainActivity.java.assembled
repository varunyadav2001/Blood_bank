    private View createInventoryStatTile(String label, String value, int valueColor, int bgRes) {
        LinearLayout tile = new LinearLayout(this);
        tile.setOrientation(LinearLayout.VERTICAL);
        tile.setBackgroundResource(bgRes);
        tile.setPadding(14, 14, 14, 14);
        tile.setGravity(android.view.Gravity.CENTER);
        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f);
        lp.setMargins(4, 0, 4, 0);
        tile.setLayoutParams(lp);

        TextView txtVal = new TextView(this);
        txtVal.setText(value);
        txtVal.setTextColor(valueColor);
        txtVal.setTextSize(16f);
        txtVal.setTypeface(null, android.graphics.Typeface.BOLD);
        txtVal.setGravity(android.view.Gravity.CENTER);
        tile.addView(txtVal);

        TextView txtLbl = new TextView(this);
        txtLbl.setText(label);
        txtLbl.setTextColor(ContextCompat.getColor(this, R.color.text_secondary));
        txtLbl.setTextSize(10f);
        txtLbl.setGravity(android.view.Gravity.CENTER);
        LinearLayout.LayoutParams lblLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        lblLp.topMargin = 4;
        txtLbl.setLayoutParams(lblLp);
        tile.addView(txtLbl);

        return tile;
    }

    private void showUpdateStockDialog(String targetBankId, String targetBankName, String bloodGroup, int currentUnits, Map<String, Integer>[] liveStockHolder, Runnable refreshCallback) {
        Dialog dialog = new Dialog(this);
        dialog.setContentView(R.layout.dialog_update_inventory_stock);
        if (dialog.getWindow() != null) {
            dialog.getWindow().setLayout(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        }

        TextView txtTitle = dialog.findViewById(R.id.txt_stock_dialog_title);
        TextView txtSub = dialog.findViewById(R.id.txt_stock_dialog_subtitle);
        TextView txtCurGroup = dialog.findViewById(R.id.txt_dialog_current_group);
        TextView txtCurUnits = dialog.findViewById(R.id.txt_dialog_current_units);
        TextView btnModeAdd = dialog.findViewById(R.id.btn_mode_add);
        TextView btnModeDeduct = dialog.findViewById(R.id.btn_mode_deduct);
        TextView btnModeSet = dialog.findViewById(R.id.btn_mode_set);
        TextView txtLabelInput = dialog.findViewById(R.id.txt_label_units_input);
        EditText inputUnits = dialog.findViewById(R.id.input_stock_dialog_units);
        TextView txtPreview = dialog.findViewById(R.id.txt_dialog_new_preview);
        TextView txtError = dialog.findViewById(R.id.txt_dialog_stock_error);
        TextView btnSave = dialog.findViewById(R.id.btn_save_stock_dialog);
        View btnClose = dialog.findViewById(R.id.btn_close_update_stock);

        if (btnClose != null) btnClose.setOnClickListener(v -> dialog.dismiss());

        if (txtTitle != null) txtTitle.setText("🩸 Update " + bloodGroup + " Stock");
        if (txtSub != null) txtSub.setText(targetBankName + " • ID: " + targetBankId);
        if (txtCurGroup != null) txtCurGroup.setText("Blood Group: " + bloodGroup);
        if (txtCurUnits != null) txtCurUnits.setText("Current Stock: " + currentUnits + " Units");

        final int[] selectedMode = new int[]{0}; // 0 = ADD, 1 = DEDUCT, 2 = SET_EXACT

        Runnable updateModeUI = () -> {
            if (btnModeAdd != null) {
                btnModeAdd.setBackgroundResource(selectedMode[0] == 0 ? R.drawable.bg_button_hospital : R.drawable.bg_chip_status_pending);
                btnModeAdd.setTextColor(selectedMode[0] == 0 ? ContextCompat.getColor(this, R.color.white) : ContextCompat.getColor(this, R.color.text_secondary));
            }
            if (btnModeDeduct != null) {
                btnModeDeduct.setBackgroundResource(selectedMode[0] == 1 ? R.drawable.bg_button_hospital : R.drawable.bg_chip_status_pending);
                btnModeDeduct.setTextColor(selectedMode[0] == 1 ? ContextCompat.getColor(this, R.color.white) : ContextCompat.getColor(this, R.color.text_secondary));
            }
            if (btnModeSet != null) {
                btnModeSet.setBackgroundResource(selectedMode[0] == 2 ? R.drawable.bg_button_hospital : R.drawable.bg_chip_status_pending);
                btnModeSet.setTextColor(selectedMode[0] == 2 ? ContextCompat.getColor(this, R.color.white) : ContextCompat.getColor(this, R.color.text_secondary));
            }
            if (txtLabelInput != null) {
                if (selectedMode[0] == 0) txtLabelInput.setText("Units to Add *");
                else if (selectedMode[0] == 1) txtLabelInput.setText("Units to Remove *");
                else txtLabelInput.setText("Set Exact Units *");
            }
            if (btnSave != null) {
                if (selectedMode[0] == 0) btnSave.setText("✓ Add Stock");
                else if (selectedMode[0] == 1) btnSave.setText("✓ Deduct Stock");
                else btnSave.setText("✓ Save");
            }
        };

        java.util.function.IntSupplier calculateResultingStock = () -> {
            String text = inputUnits != null ? inputUnits.getText().toString().trim() : "";
            int val = 0;
            try {
                val = Integer.parseInt(text);
            } catch (Exception ignored) {}
            if (selectedMode[0] == 0) return currentUnits + val;
            else if (selectedMode[0] == 1) return currentUnits - val;
            else return val;
        };

        Runnable updatePreview = () -> {
            int resulting = calculateResultingStock.getAsInt();
            if (txtPreview != null) {
                txtPreview.setText("New Resulting Stock: " + resulting + (resulting == 1 ? " Unit" : " Units"));
                if (resulting < 0) {
                    txtPreview.setTextColor(ContextCompat.getColor(this, R.color.status_critical_text));
                } else {
                    txtPreview.setTextColor(0xFF38BDF8);
                }
            }
            if (txtError != null) {
                if (resulting < 0) {
                    txtError.setText("Insufficient stock. Resulting units cannot be negative.");
                    txtError.setVisibility(View.VISIBLE);
                } else {
                    txtError.setVisibility(View.GONE);
                }
            }
        };

        if (btnModeAdd != null) btnModeAdd.setOnClickListener(v -> {
            selectedMode[0] = 0;
            updateModeUI.run();
            updatePreview.run();
        });
        if (btnModeDeduct != null) btnModeDeduct.setOnClickListener(v -> {
            selectedMode[0] = 1;
            updateModeUI.run();
            updatePreview.run();
        });
        if (btnModeSet != null) btnModeSet.setOnClickListener(v -> {
            selectedMode[0] = 2;
            updateModeUI.run();
            updatePreview.run();
        });

        if (inputUnits != null) {
            inputUnits.addTextChangedListener(new TextWatcher() {
                @Override public void beforeTextChanged(CharSequence s, int start, int count, int after) {}
                @Override public void onTextChanged(CharSequence s, int start, int before, int count) {}
                @Override public void afterTextChanged(Editable s) { updatePreview.run(); }
            });
        }

        updateModeUI.run();
        updatePreview.run();

        if (btnSave != null) {
            btnSave.setOnClickListener(v -> {
                String text = inputUnits != null ? inputUnits.getText().toString().trim() : "";
                if (TextUtils.isEmpty(text)) {
                    if (txtError != null) {
            ProgressBar progress = view.findViewById(R.id.loading_requests_progress);
            LinearLayout container = view.findViewById(R.id.layout_requests_container);
            View emptyState = view.findViewById(R.id.layout_requests_empty_state);
            View btnEmptyCreate = view.findViewById(R.id.btn_empty_create_request);
            if (btnEmptyCreate != null) btnEmptyCreate.setVisibility(View.GONE);

            if (progress != null) progress.setVisibility(View.VISIBLE);

            UserProfile currentUser = repository.getCurrentUser();
            String defaultBankName = currentUser != null && currentUser.getDisplayName() != null ? currentUser.getDisplayName() : "MSI Blood Bank Sangli";
            String bankUid = currentUser != null ? currentUser.getUid() : "BB-MSI";
            String defaultBankId = currentUser != null && currentUser.getBloodBankId() != null ? currentUser.getBloodBankId() : bankUid;

            String bankName = selectedBloodBank != null ? selectedBloodBank.name : defaultBankName;
            String currentBankId = selectedBloodBank != null ? selectedBloodBank.id : defaultBankId;

            try {
                if (bloodBankRequestsListener != null) {
                    bloodBankRequestsListener.remove();
                    bloodBankRequestsListener = null;
                }
                bloodBankRequestsListener = FirebaseFirestore.getInstance().collection("bloodRequests")
                    .addSnapshotListener((queryDocumentSnapshots, e) -> {
                        if (progress != null) progress.setVisibility(View.GONE);
                        if (container == null) return;
                        container.removeAllViews();

                        if (e != null || queryDocumentSnapshots == null || queryDocumentSnapshots.isEmpty()) {
                            if (emptyState != null) emptyState.setVisibility(View.VISIBLE);
                            return;
                        }

                        List<DocumentSnapshot> validDocs = new ArrayList<>();
                        for (QueryDocumentSnapshot doc : queryDocumentSnapshots) {
                            String assigned = doc.getString("assignedSource") != null ? doc.getString("assignedSource") : "";
                            String targetBankId = doc.getString("targetBloodBankId") != null ? doc.getString("targetBloodBankId") : (doc.getString("bloodBankId") != null ? doc.getString("bloodBankId") : "");
                            String bBankName = doc.getString("bloodBankName") != null ? doc.getString("bloodBankName") : "";

                            boolean matchesId = !targetBankId.isEmpty() && (targetBankId.equalsIgnoreCase(currentBankId) || targetBankId.equalsIgnoreCase(bankUid));
                            boolean matchesName = (!bBankName.isEmpty() && bBankName.equalsIgnoreCase(bankName)) ||
                                                  (!assigned.isEmpty() && assigned.equalsIgnoreCase(bankName));

                            if (!matchesId && !matchesName) {
                                String bNameLower = bankName.toLowerCase(Locale.US);
                                String tNameLower = bBankName.toLowerCase(Locale.US);
                                String aNameLower = assigned.toLowerCase(Locale.US);
                                String tIdLower = targetBankId.toLowerCase(Locale.US);

                                if (bNameLower.contains("msi") && (tNameLower.contains("msi") || aNameLower.contains("msi") || tIdLower.contains("msi") || tIdLower.contains("bb-msi"))) {

        String targetIdLower = targetBankId != null ? targetBankId.toLowerCase(Locale.US) : "";
        String targetNameLower = targetBankName != null ? targetBankName.toLowerCase(Locale.US) : "";

        if (userBbId != null && userBbId.equalsIgnoreCase(targetBankId)) return true;
        if (userUid.equalsIgnoreCase(targetBankId)) return true;

        if (userEmail.contains("msi") || userDisplayName.contains("msi")) {
            return targetIdLower.contains("msi") || targetNameLower.contains("msi");
        }
        if (userEmail.contains("bombay") || userDisplayName.contains("bombay")) {
            return targetIdLower.contains("bombay") || targetNameLower.contains("bombay");
        }
        if (userEmail.contains("shashwat") || userDisplayName.contains("shashwat")) {
            return targetIdLower.contains("shashwat") || targetNameLower.contains("shashwat");
        }
        if (userEmail.contains("sangli") || userDisplayName.contains("civil") || userDisplayName.contains("sangli civil")) {
            return targetIdLower.contains("sangli-civil") || targetIdLower.contains("civil") || targetNameLower.contains("civil") || targetNameLower.contains("sangli civil");
        }

        return false;
    }

    private void performUpdateBloodBankStock(String targetBankId, String targetBankName, String bloodGroup, int oldUnits, int newUnits, Dialog dialog, Map<String, Integer>[] liveStockHolder, Runnable refreshCallback) {
        if (newUnits < 0) {
            Toast.makeText(this, "Insufficient stock. Units cannot be negative.", Toast.LENGTH_SHORT).show();
            return;
        }

        if (!isAuthorizedForBloodBank(targetBankId, targetBankName)) {
            Toast.makeText(this, "Permission Denied: You do not have permission to modify stock for " + targetBankName + ".", Toast.LENGTH_LONG).show();
            return;
        }

        UserProfile currentUser = repository.getCurrentUser();
        String loggedInUid = currentUser != null ? currentUser.getUid() : "BB-MSI";
        String loggedInBankId = currentUser != null && currentUser.getBloodBankId() != null ? currentUser.getBloodBankId() : loggedInUid;
        String loggedInBankName = currentUser != null && currentUser.getDisplayName() != null ? currentUser.getDisplayName() : "MSI Blood Bank Sangli";
        int addQuantity = newUnits - oldUnits;

        Log.d("SmartBloodInventory", "================ INVENTORY UPDATE OPERATION ================");
        Log.d("SmartBloodInventory", "LOGIN USER: " + (currentUser != null ? currentUser.getEmail() : "user") + " (UID: " + loggedInUid + ")");
        Log.d("SmartBloodInventory", "BLOOD BANK ID: " + targetBankId);
        Log.d("SmartBloodInventory", "BLOOD BANK NAME: " + targetBankName);
        Log.d("SmartBloodInventory", "OPERATION: " + (addQuantity > 0 ? "ADD" : (addQuantity < 0 ? "DEDUCT" : "UPDATE")));
        Log.d("SmartBloodInventory", "BLOOD GROUP: " + bloodGroup);
        Log.d("SmartBloodInventory", "OLD VALUE: " + oldUnits);
        Log.d("SmartBloodInventory", "NEW VALUE: " + newUnits);

        FirebaseFirestore db = FirebaseFirestore.getInstance();

        db.collection("bloodBanks").get().addOnSuccessListener(snapshots -> {
            DocumentReference targetRef = null;
            DocumentSnapshot targetDoc = null;

            if (snapshots != null) {
                // PASS 1: Strict ID Matching (Document ID, bloodBankId field, or userId field)
                for (DocumentSnapshot doc : snapshots) {
                    String docId = doc.getId();
                    String uid = doc.getString("userId");
                    String bId = doc.getString("bloodBankId");

                    if (docId.equalsIgnoreCase(targetBankId) || 
                        (bId != null && bId.equalsIgnoreCase(targetBankId)) || 
                        (uid != null && uid.equalsIgnoreCase(targetBankId))) {
                        targetRef = doc.getReference();
                        targetDoc = doc;
                        break;
                    }
                }

                // PASS 2: Exact Name Matching (ONLY if no document matched the target ID)
                if (targetDoc == null) {
                    for (DocumentSnapshot doc : snapshots) {
                        String n = doc.getString("name");
                        if (n != null && n.trim().equalsIgnoreCase(targetBankName.trim())) {
                            targetRef = doc.getReference();
                            targetDoc = doc;
                            break;
                        }
                    }
                }

                // PASS 3: Partial Name Matching (Fallback)
                if (targetDoc == null) {
                    String bNameLower = targetBankName.toLowerCase(Locale.US);
                    for (DocumentSnapshot doc : snapshots) {
                        String docId = doc.getId().toLowerCase(Locale.US);
                        String n = doc.getString("name") != null ? doc.getString("name").toLowerCase(Locale.US) : "";
                        if ((bNameLower.contains("msi") && (docId.contains("msi") || n.contains("msi"))) ||
                            (bNameLower.contains("bombay") && (docId.contains("bombay") || n.contains("bombay"))) ||
                            (bNameLower.contains("shashwat") && (docId.contains("shashwat") || n.contains("shashwat"))) ||
                            (bNameLower.contains("civil") && (docId.contains("civil") || n.contains("civil")))) {
                            targetRef = doc.getReference();
                            targetDoc = doc;
                            break;
                        }
                    }
                }
            }

                            topRow.setLayoutParams(new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));

                            TextView txtHosp = new TextView(this);
