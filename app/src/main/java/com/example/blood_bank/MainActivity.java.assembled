    private void bindBloodBankDashboardV2(View view) {
        View glowPurple = view.findViewById(R.id.bg_glow_bank_dash_purple);
        View nodesBank = view.findViewById(R.id.bg_nodes_bank_dash);

        if (glowPurple != null) {
            android.animation.ObjectAnimator pulsePurple = android.animation.ObjectAnimator.ofFloat(glowPurple, "alpha", 0.50f, 0.95f, 0.50f);
            pulsePurple.setDuration(4000);
            pulsePurple.setRepeatCount(android.animation.ValueAnimator.INFINITE);
            pulsePurple.start();
                this, android.R.layout.simple_dropdown_item_1line, bloodGroups
            );
            actvGroup.setAdapter(groupAdapter);
            actvGroup.setOnClickListener(v -> actvGroup.showDropDown());
        }

        if (btnSubmit != null) {
            btnSubmit.setOnClickListener(v -> {
                String name = inputName != null ? inputName.getText().toString().trim() : "";
                String email = inputEmail != null ? inputEmail.getText().toString().trim() : "";
                String mobile = inputMobile != null ? inputMobile.getText().toString().trim() : "";
                String group = inputGroupView instanceof android.widget.TextView ? ((android.widget.TextView) inputGroupView).getText().toString().trim() : "";
                String dob = inputDob != null ? inputDob.getText().toString().trim() : "";
                String gender = inputGenderView instanceof android.widget.TextView ? ((android.widget.TextView) inputGenderView).getText().toString().trim() : "";
                String city = inputCity != null ? inputCity.getText().toString().trim() : "";
                String password = inputPassword != null ? inputPassword.getText().toString().trim() : "";
                String confirmPassword = inputConfirmPassword != null ? inputConfirmPassword.getText().toString().trim() : "";

                if (TextUtils.isEmpty(name) || TextUtils.isEmpty(email) || TextUtils.isEmpty(dob) ||
                    TextUtils.isEmpty(gender) || TextUtils.isEmpty(group) || TextUtils.isEmpty(password) || TextUtils.isEmpty(confirmPassword)) {
                    showRegError(txtError, "Please complete all required fields (Name, Email, Date of Birth, Gender, Blood Group, Password, Confirm Password).");
                    return;
                }

                if (!android.util.Patterns.EMAIL_ADDRESS.matcher(email).matches()) {
                    showRegError(txtError, "Please enter a valid email address.");
                    return;
                }

                if (!password.equals(confirmPassword)) {
                    showRegError(txtError, "Password and Confirm Password do not match.");
                    return;
                }

                if (txtError != null) txtError.setVisibility(View.GONE);
                btnSubmit.setEnabled(false);

                try {
