                txtStepIcon.setText("○");
                txtStepIcon.setTextColor(ContextCompat.getColor(this, R.color.text_tertiary));
                txtStepText.setText("Step " + stepNumber + " " + stepLabels[i]);
                txtStepText.setTextColor(ContextCompat.getColor(this, R.color.text_tertiary));
            }

            stepRow.addView(txtStepIcon);
            stepRow.addView(txtStepText);
            stepsContainer.addView(stepRow);
        }

        timelineLayout.addView(stepsContainer);
        return timelineLayout;
    }

    private int activeBloodBankRequestTab = 0; // 0: Hospital Requests, 1: Donor Appointments

    private void bindRequestsView(View view) {
        attachRoleBackgroundAnimators(view);

        TextView txtTitle = view.findViewById(R.id.txt_requests_page_title);
        TextView txtSubtitle = view.findViewById(R.id.txt_requests_subtitle);
        TextView btnCreate = view.findViewById(R.id.btn_requests_page_create);
        ProgressBar progress = view.findViewById(R.id.loading_requests_progress);
        LinearLayout container = view.findViewById(R.id.layout_requests_container);
        View emptyState = view.findViewById(R.id.layout_requests_empty_state);
        TextView txtEmptyTitle = view.findViewById(R.id.txt_empty_requests_title);
        TextView txtEmptyDesc = view.findViewById(R.id.txt_empty_requests_desc);
        View btnEmptyCreate = view.findViewById(R.id.btn_empty_create_request);

        View layoutBankTabs = view.findViewById(R.id.layout_bank_request_tabs);
        TextView tabHospital = view.findViewById(R.id.tab_bank_hospital_requests);
        TextView tabDonor = view.findViewById(R.id.tab_bank_donor_appointments);

        UserProfile currentUser = repository.getCurrentUser();
        String currentUid = currentUser != null ? currentUser.getUid() : "USR-8842";
        String currentDisplayName = currentUser != null && currentUser.getDisplayName() != null ? currentUser.getDisplayName() : "User";

        if (currentRole == UserRole.DONOR) {
            if (layoutBankTabs != null) layoutBankTabs.setVisibility(View.GONE);
            if (txtTitle != null) txtTitle.setText("My Donation Appointments");
            if (txtSubtitle != null) txtSubtitle.setText("Live appointment status with regional blood banks");
            if (btnCreate != null) {
                btnCreate.setVisibility(View.VISIBLE);
                btnCreate.setText("+ Book Donation");
                btnCreate.setBackgroundResource(R.drawable.bg_button_donor);
                btnCreate.setOnClickListener(v -> showBookBloodDonationDialog(null));
            }
            if (txtEmptyTitle != null) txtEmptyTitle.setText("No Donation Appointments");
            if (txtEmptyDesc != null) txtEmptyDesc.setText("You haven't scheduled any blood donation appointments yet. Book an appointment to help save lives!");
            if (btnEmptyCreate != null) {
                btnEmptyCreate.setVisibility(View.VISIBLE);
                btnEmptyCreate.setBackgroundResource(R.drawable.bg_button_donor);
                btnEmptyCreate.setOnClickListener(v -> showBookBloodDonationDialog(null));
            }

            if (progress != null) progress.setVisibility(View.VISIBLE);

            try {
                if (donorAppointmentsListener != null) {
                    donorAppointmentsListener.remove();
                    donorAppointmentsListener = null;
                }

                donorAppointmentsListener = FirebaseFirestore.getInstance().collection("donorAppointments")
                    .whereEqualTo("donorAuthUid", currentUid)
                    .addSnapshotListener((queryDocumentSnapshots, e) -> {
                        if (progress != null) progress.setVisibility(View.GONE);
                        if (container == null) return;
                        container.removeAllViews();

                        if (e != null || queryDocumentSnapshots == null || queryDocumentSnapshots.isEmpty()) {
                            if (emptyState != null) emptyState.setVisibility(View.VISIBLE);
                            return;
                        }

                        List<DocumentSnapshot> apptDocs = new ArrayList<>(queryDocumentSnapshots.getDocuments());
                        if (apptDocs.isEmpty()) {
                            if (emptyState != null) emptyState.setVisibility(View.VISIBLE);
                            return;
                        }

                        if (emptyState != null) emptyState.setVisibility(View.GONE);

                        Collections.sort(apptDocs, (d1, d2) -> {
                            Long t1 = d1.getLong("createdAtTimestamp");
                            Long t2 = d2.getLong("createdAtTimestamp");
                            if (t1 == null) t1 = 0L;
                            if (t2 == null) t2 = 0L;
                            return Long.compare(t2, t1);
                        });

                        for (DocumentSnapshot doc : apptDocs) {
                            String apptId = doc.getString("appointmentId") != null ? doc.getString("appointmentId") : doc.getId();
                            String bBankName = doc.getString("bloodBankName") != null ? doc.getString("bloodBankName") : "Regional Blood Bank";
                            String bGroup = doc.getString("bloodGroup") != null ? doc.getString("bloodGroup") : "O+";
                            String date = doc.getString("date") != null ? doc.getString("date") : "Upcoming";
                            String time = doc.getString("time") != null ? doc.getString("time") : "10:00 AM";
            String bankUid = currentUser != null ? currentUser.getUid() : "BB-MSI";
            String defaultBankId = currentUser != null && currentUser.getBloodBankId() != null ? currentUser.getBloodBankId() : bankUid;

            String bankName = selectedBloodBank != null ? selectedBloodBank.name : defaultBankName;
            String currentBankId = selectedBloodBank != null ? selectedBloodBank.id : defaultBankId;

            try {
                if (bloodBankRequestsListener != null) {
                    bloodBankRequestsListener.remove();
                    bloodBankRequestsListener = null;
                }
                bloodBankRequestsListener = FirebaseFirestore.getInstance().collection("bloodRequests")
                    .addSnapshotListener((queryDocumentSnapshots, e) -> {
                        if (progress != null) progress.setVisibility(View.GONE);
                        if (container == null) return;
                        container.removeAllViews();

                        if (e != null || queryDocumentSnapshots == null || queryDocumentSnapshots.isEmpty()) {
                            if (emptyState != null) emptyState.setVisibility(View.VISIBLE);
                            return;
                        }

                        List<DocumentSnapshot> validDocs = new ArrayList<>();
                        for (QueryDocumentSnapshot doc : queryDocumentSnapshots) {
                            String assigned = doc.getString("assignedSource") != null ? doc.getString("assignedSource") : "";
                            String targetBankId = doc.getString("targetBloodBankId") != null ? doc.getString("targetBloodBankId") : (doc.getString("bloodBankId") != null ? doc.getString("bloodBankId") : "");
                            String bBankName = doc.getString("bloodBankName") != null ? doc.getString("bloodBankName") : "";

                            boolean matchesId = !targetBankId.isEmpty() && (targetBankId.equalsIgnoreCase(currentBankId) || targetBankId.equalsIgnoreCase(bankUid));
                            boolean matchesName = (!bBankName.isEmpty() && bBankName.equalsIgnoreCase(bankName)) ||
                                                  (!assigned.isEmpty() && assigned.equalsIgnoreCase(bankName));

                            if (!matchesId && !matchesName) {
                                String bNameLower = bankName.toLowerCase(Locale.US);
                                String tNameLower = bBankName.toLowerCase(Locale.US);
                                String aNameLower = assigned.toLowerCase(Locale.US);
                                String tIdLower = targetBankId.toLowerCase(Locale.US);

                                if (bNameLower.contains("msi") && (tNameLower.contains("msi") || aNameLower.contains("msi") || tIdLower.contains("msi") || tIdLower.contains("bb-msi"))) {
                                    matchesName = true;
                                } else if (bNameLower.contains("bombay") && (tNameLower.contains("bombay") || aNameLower.contains("bombay") || tIdLower.contains("bombay") || tIdLower.contains("bb-bombay"))) {
                                    matchesName = true;
                                } else if (bNameLower.contains("shashwat") && (tNameLower.contains("shashwat") || aNameLower.contains("shashwat") || tIdLower.contains("shashwat") || tIdLower.contains("bb-shashwat"))) {
                                    matchesName = true;
                                } else if (bNameLower.contains("civil") && (tNameLower.contains("civil") || aNameLower.contains("civil") || tIdLower.contains("civil") || tIdLower.contains("bb-sangli-civil"))) {
                                    matchesName = true;
                                }
                            }

                            if (!matchesId && !matchesName) {
                                continue;
                            }
                            validDocs.add(doc);
                        }

                        if (validDocs.isEmpty()) {
                            if (emptyState != null) emptyState.setVisibility(View.VISIBLE);
                            return;
                        }

                        if (emptyState != null) emptyState.setVisibility(View.GONE);

                        Collections.sort(validDocs, (d1, d2) -> {
                            String s1 = d1.getString("status");
                            String s2 = d2.getString("status");
                            String u1 = d1.getString("urgency");
                            String u2 = d2.getString("urgency");
                            
                            boolean e1 = u1 != null && (u1.equalsIgnoreCase("Emergency") || u1.equalsIgnoreCase("Critical"));
                            boolean e2 = u2 != null && (u2.equalsIgnoreCase("Emergency") || u2.equalsIgnoreCase("Critical"));
                            
                            boolean active1 = s1 != null && !s1.contains("FULFIL") && !s1.contains("REJECT") && !s1.contains("CANCEL");
                            boolean active2 = s2 != null && !s2.contains("FULFIL") && !s2.contains("REJECT") && !s2.contains("CANCEL");

                            if (e1 && active1 && !(e2 && active2)) return -1;
                            if (!(e1 && active1) && (e2 && active2)) return 1;

                            if (active1 && !active2) return -1;
                            if (!active1 && active2) return 1;

                            Long t1 = d1.getLong("createdAtTimestamp");
                            Long t2 = d2.getLong("createdAtTimestamp");
                            if (t1 == null) t1 = 0L;
                            if (t2 == null) t2 = 0L;
                            return Long.compare(t2, t1);
                        });

                        for (DocumentSnapshot doc : validDocs) {
                            String reqId = doc.getString("requestId") != null ? doc.getString("requestId") : doc.getId();
                            String hospId = doc.getString("hospitalId") != null ? doc.getString("hospitalId") : "";
                            String hospName = doc.getString("hospitalName") != null ? doc.getString("hospitalName") : "Healthcare Facility";
                            String bGroup = doc.getString("bloodGroup") != null ? doc.getString("bloodGroup") : "O+";
                            String comp = doc.getString("component") != null ? doc.getString("component") : "Whole Blood";
                            Long qtyLong = doc.getLong("quantity");
                            if (qtyLong == null) qtyLong = doc.getLong("requiredUnits");
                            int qty = qtyLong != null ? qtyLong.intValue() : 2;
                            String urgency = doc.getString("urgency") != null ? doc.getString("urgency") : "Normal";
                            String status = doc.getString("status") != null ? doc.getString("status") : "PENDING";
                            String createdAt = doc.getString("createdAt") != null ? doc.getString("createdAt") : "Today";
                            String notes = doc.getString("notes") != null ? doc.getString("notes") : "";
                            if (notes.isEmpty() && doc.getString("reason") != null) notes = doc.getString("reason");
                            if (notes.isEmpty() && doc.getString("message") != null) notes = doc.getString("message");
                            String location = doc.getString("locationAddress") != null ? doc.getString("locationAddress") : "";

                            BloodRequest req = new BloodRequest(reqId, hospId, hospName, bGroup, comp, qty, urgency, status, createdAt, notes, 0, 0, location);
                            boolean isEmergencyReq = urgency.equalsIgnoreCase("Emergency") || urgency.equalsIgnoreCase("Critical");

                            boolean isTargetFocused = highlightTargetRequestId != null && reqId.equalsIgnoreCase(highlightTargetRequestId);

                            // Build Blood Bank Requisition Card
                            LinearLayout card = new LinearLayout(this);
                            card.setOrientation(LinearLayout.VERTICAL);
                            if (isTargetFocused) {
                                card.setBackgroundResource(R.drawable.bg_card_hero_crimson);
                            } else if (isEmergencyReq && !status.contains("FULFIL") && !status.contains("REJECT") && !status.contains("CANCEL")) {
                                card.setBackgroundResource(R.drawable.bg_card_emergency);
                            } else {
                                card.setBackgroundResource(R.drawable.bg_card_hospital);
                            }
                            card.setPadding(32, 28, 32, 28);
                            LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                            lp.setMargins(0, 0, 0, 24);
                            card.setLayoutParams(lp);

                            if (isTargetFocused) {
                                TextView txtFocused = new TextView(this);
                                txtFocused.setText("🎯 Focused Notification Request • " + reqId);
                                txtFocused.setTextColor(0xFF38BDF8);
                                txtFocused.setTextSize(11f);
                                txtFocused.setTypeface(null, android.graphics.Typeface.BOLD);
                                txtFocused.setBackgroundResource(R.drawable.bg_chip_status_pending);
                                txtFocused.setPadding(16, 6, 16, 6);
                                LinearLayout.LayoutParams fLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                                fLp.bottomMargin = 10;
                                txtFocused.setLayoutParams(fLp);
                                card.addView(txtFocused);
                            }

                            // Top row: Hospital Name + Status Badge
                            RelativeLayout topRow = new RelativeLayout(this);
                            topRow.setLayoutParams(new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));

                            TextView txtHosp = new TextView(this);
                            txtHosp.setText((isEmergencyReq ? "🚨 " : "🏥 ") + hospName);
                            txtHosp.setTextColor(ContextCompat.getColor(this, R.color.white));
                            txtHosp.setTextSize(16f);
                            txtHosp.setTypeface(null, android.graphics.Typeface.BOLD);

                            TextView txtStatus = new TextView(this);
                            String statusUpper = status.toUpperCase(Locale.US);
                            txtStatus.setTextSize(11f);
                            txtStatus.setTypeface(null, android.graphics.Typeface.BOLD);
                            txtStatus.setPadding(18, 6, 18, 6);

                            if (statusUpper.contains("PENDING") || statusUpper.contains("SEARCHING")) {
                                txtStatus.setText(isEmergencyReq ? "🚨 EMERGENCY PENDING" : "PENDING");
                                txtStatus.setBackgroundResource(isEmergencyReq ? R.drawable.bg_chip_status_critical : R.drawable.bg_chip_status_pending);
                                txtStatus.setTextColor(ContextCompat.getColor(this, isEmergencyReq ? R.color.status_critical_text : R.color.status_low_text));
                            } else if (statusUpper.equals("VERIFIED") || statusUpper.equals("ACCEPTED")) {
                                txtStatus.setText("VERIFIED");
                                txtStatus.setBackgroundResource(R.drawable.bg_chip_status_reserved);
                                txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_reserved_text));
                            } else if (statusUpper.equals("ALLOCATED")) {
                                txtStatus.setText("ALLOCATED");
                                txtStatus.setBackgroundResource(R.drawable.bg_chip_status_reserved);
                                txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_reserved_text));
                            } else if (statusUpper.equals("DISPATCHED")) {
                                txtStatus.setText("DISPATCHED");
                                txtStatus.setBackgroundResource(R.drawable.bg_chip_status_reserved);
                                txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_reserved_text));
                            } else if (statusUpper.contains("TRANSIT") || statusUpper.equals("IN_TRANSIT")) {
                                txtStatus.setText("IN TRANSIT");
                                txtStatus.setBackgroundResource(R.drawable.bg_chip_status_reserved);
                                txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_reserved_text));
                            } else if (statusUpper.contains("FULFIL") || statusUpper.contains("COMPLET")) {
                                txtStatus.setText("FULFILLED");
                                txtStatus.setBackgroundResource(R.drawable.bg_chip_status_available);
                                txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_available_text));
                            } else if (statusUpper.contains("REJECT")) {
                                txtStatus.setText("REJECTED");
                                txtStatus.setBackgroundResource(R.drawable.bg_chip_status_critical);
                                txtStatus.setTextColor(ContextCompat.getColor(this, R.color.status_critical_text));
                            } else {
                                txtStatus.setText("CANCELLED");
                                txtStatus.setBackgroundResource(R.drawable.bg_chip_status_pending);
                                txtStatus.setTextColor(ContextCompat.getColor(this, R.color.text_tertiary));
                            }

                            RelativeLayout.LayoutParams statusLp = new RelativeLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                            statusLp.addRule(RelativeLayout.ALIGN_PARENT_END);
                            statusLp.addRule(RelativeLayout.CENTER_VERTICAL);
                            txtStatus.setLayoutParams(statusLp);

                            topRow.addView(txtHosp);
                            topRow.addView(txtStatus);
                            card.addView(topRow);

                            // Blood details & Urgency chip
                            LinearLayout detailsRow = new LinearLayout(this);
                            detailsRow.setOrientation(LinearLayout.HORIZONTAL);
                            detailsRow.setGravity(android.view.Gravity.CENTER_VERTICAL);
                            LinearLayout.LayoutParams dtLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                            dtLp.topMargin = 10;
                            detailsRow.setLayoutParams(dtLp);

                            TextView txtBlood = new TextView(this);
                            txtBlood.setText(String.format(Locale.US, "%s • %d Units %s", bGroup, qty, comp));
                            txtBlood.setTextColor(0xFF38BDF8);
                            txtBlood.setTextSize(16f);
                            txtBlood.setTypeface(null, android.graphics.Typeface.BOLD);

                            TextView txtUrgency = new TextView(this);
                            txtUrgency.setText(isEmergencyReq ? "🚨 HIGH PRIORITY" : urgency.toUpperCase(Locale.US));
                            txtUrgency.setTextSize(10f);
                            txtUrgency.setTypeface(null, android.graphics.Typeface.BOLD);
                            txtUrgency.setPadding(14, 4, 14, 4);

                            if (isEmergencyReq) {
                                txtUrgency.setBackgroundResource(R.drawable.bg_chip_status_critical);
                                txtUrgency.setTextColor(ContextCompat.getColor(this, R.color.status_critical_text));
                            } else {
                                txtUrgency.setBackgroundResource(R.drawable.bg_chip_status_available);
                                txtUrgency.setTextColor(ContextCompat.getColor(this, R.color.status_available_text));
                            }
                            LinearLayout.LayoutParams urgLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                            urgLp.leftMargin = 14;
                            txtUrgency.setLayoutParams(urgLp);

                            detailsRow.addView(txtBlood);
                            detailsRow.addView(txtUrgency);
                            card.addView(detailsRow);

                            // Subtitle with ID, Time, Location & Notes / Reason
                            TextView txtInfo = new TextView(this);
                            String noteStr = !notes.isEmpty() ? " • " + notes : "";
                            String locStr = !location.isEmpty() ? " • " + location : "";
                            txtInfo.setText("Req ID: " + reqId + " • " + createdAt + locStr + noteStr);
                            txtInfo.setTextColor(ContextCompat.getColor(this, R.color.text_secondary));
                            txtInfo.setTextSize(12f);
                            LinearLayout.LayoutParams infoLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
                            infoLp.topMargin = 6;
                            txtInfo.setLayoutParams(infoLp);
                            card.addView(txtInfo);

                            // Request Lifecycle Timeline
                            card.addView(buildRequestTimelineView(status));

                            // Blood Bank Actions
                            if (statusUpper.contains("PENDING") || statusUpper.contains("SEARCHING")) {
                                LinearLayout actRow = new LinearLayout(this);
                                actRow.setOrientation(LinearLayout.HORIZONTAL);
                                LinearLayout.LayoutParams actLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 84);
                                actLp.topMargin = 16;
                                actRow.setLayoutParams(actLp);

                                TextView btnVerify = new TextView(this);
                                btnVerify.setText("✓ Verify");
                                btnVerify.setTextColor(ContextCompat.getColor(this, R.color.white));
                                btnVerify.setTextSize(12f);
                                btnVerify.setTypeface(null, android.graphics.Typeface.BOLD);
                                btnVerify.setGravity(android.view.Gravity.CENTER);
                                btnVerify.setBackgroundResource(R.drawable.bg_button_hospital);
                                LinearLayout.LayoutParams verLp = new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.MATCH_PARENT, 1.2f);
                                verLp.rightMargin = 8;
                                btnVerify.setLayoutParams(verLp);
                                btnVerify.setOnClickListener(v -> {
                                    if (!isAuthorizedForBloodBank(currentBankId, bankName)) {
                                        Toast.makeText(this, "Permission Denied: You cannot manage requisitions for " + bankName + ".", Toast.LENGTH_LONG).show();
                                        return;
                                    }

                                    String timeStr = new SimpleDateFormat("hh:mm a", Locale.US).format(new Date());
                                    Map<String, Object> upd = new HashMap<>();
                                    upd.put("status", "VERIFIED");
                                    upd.put("verifiedAt", timeStr);
                                    upd.put("verifiedTimestamp", System.currentTimeMillis());
                                    upd.put("verifiedBy", bankUid);
                                    upd.put("bloodBankId", currentBankId);
                                    upd.put("bloodBankName", bankName);
                                    upd.put("assignedSource", bankName);
                                    upd.put("escalationStage", 2);
                                    upd.put("updatedAt", System.currentTimeMillis());

                                    FirebaseFirestore.getInstance().collection("bloodRequests").document(reqId).update(upd)
                                        .addOnSuccessListener(unused -> {
                                            // Notification for Hospital
                                            Map<String, Object> notif = new HashMap<>();
                                            notif.put("hospitalId", hospId);
                                            notif.put("title", "Requisition Verified");
                                            notif.put("message", "Your " + bGroup + " (" + qty + " Units) requisition " + reqId + " has been verified by " + bankName + ".");
                                            notif.put("type", "VERIFIED");
                                            notif.put("timestamp", timeStr);
                                            notif.put("createdAt", System.currentTimeMillis());
                                            notif.put("isRead", false);
                                            FirebaseFirestore.getInstance().collection("notifications").add(notif);

                                            repository.addAuditLog(bankUid, "BLOOD_BANK", "VERIFY_REQUEST", reqId, timeStr, "PENDING", "VERIFIED", "Verified request for " + qty + " units " + bGroup + " from " + hospName);
                                            Toast.makeText(this, "✓ Request " + reqId + " Verified!", Toast.LENGTH_SHORT).show();
                                        }).addOnFailureListener(err -> {
                                            Toast.makeText(this, "Verification failed: " + err.getMessage(), Toast.LENGTH_SHORT).show();
                renderTransfers.run();
            });
        }

        if (progress != null) progress.setVisibility(View.VISIBLE);

        try {
            if (bloodBankTransfersListener != null) {
                bloodBankTransfersListener.remove();
                bloodBankTransfersListener = null;
            }

            bloodBankTransfersListener = FirebaseFirestore.getInstance().collection("transfers")
                .addSnapshotListener((queryDocumentSnapshots, e) -> {
                    if (progress != null) progress.setVisibility(View.GONE);
                    allTransferDocs.clear();

                    if (e != null || queryDocumentSnapshots == null || queryDocumentSnapshots.isEmpty()) {
                        if (emptyState != null) emptyState.setVisibility(View.VISIBLE);
                        return;
                    }

                    allTransferDocs.addAll(queryDocumentSnapshots.getDocuments());
                    renderTransfers.run();
                });
        } catch (Exception e) {
            if (progress != null) progress.setVisibility(View.GONE);
            if (emptyState != null) emptyState.setVisibility(View.VISIBLE);
        }
    }

        }
        if (chipPending != null) {
            chipPending.setOnClickListener(v -> {
                currentTransfersFilter = "PENDING";
                updateChips.run();
                renderTransfers.run();
            });
        }
        if (chipCompleted != null) {
            chipCompleted.setOnClickListener(v -> {
                currentTransfersFilter = "COMPLETED";
                updateChips.run();
                renderTransfers.run();
            });
        }

        if (progress != null) progress.setVisibility(View.VISIBLE);

        try {
            if (bloodBankTransfersListener != null) {
                bloodBankTransfersListener.remove();
                bloodBankTransfersListener = null;
            }

            bloodBankTransfersListener = FirebaseFirestore.getInstance().collection("transfers")
                .addSnapshotListener((queryDocumentSnapshots, e) -> {
                    if (progress != null) progress.setVisibility(View.GONE);
                    allTransferDocs.clear();

                    if (e != null || queryDocumentSnapshots == null || queryDocumentSnapshots.isEmpty()) {
                        if (emptyState != null) emptyState.setVisibility(View.VISIBLE);
                        return;
                    }

                    allTransferDocs.addAll(queryDocumentSnapshots.getDocuments());
                    renderTransfers.run();
                });
        } catch (Exception e) {
            if (progress != null) progress.setVisibility(View.GONE);
            if (emptyState != null) emptyState.setVisibility(View.VISIBLE);
        }
    }

    private void generateTransferRecommendations(String myBankUid, String myBankName, LinearLayout container, TextView emptyText) {
        if (container == null) return;
        container.removeAllViews();

        UserProfile curUser = repository.getCurrentUser();
        String currentBankId = curUser != null ? curUser.getBloodBankId() : myBankUid;

        FirebaseFirestore.getInstance().collection("bloodBanks").get().addOnSuccessListener(bankSnapshots -> {
            if (bankSnapshots == null || bankSnapshots.isEmpty()) {
                if (emptyText != null) emptyText.setVisibility(View.VISIBLE);
                return;
            }

            DocumentSnapshot myBankDoc = null;
            List<DocumentSnapshot> otherBankDocs = new ArrayList<>();

                int sourceUnits = getNumericStock(myStock, group);
                // If source has ample stock (> 6 units)
                if (sourceUnits > 6) {
                    for (DocumentSnapshot targetDoc : otherBankDocs) {
                        Map<String, Integer> targetStock = extractStockMapFromDoc(targetDoc);
                        int targetUnits = getNumericStock(targetStock, group);

                        // If target has low stock (<= 4 units)
                        if (targetUnits <= 4) {
                                });
                                card.addView(btnTransit);
                            } else if (statusUpper.contains("TRANSIT") || statusUpper.equals("IN_TRANSIT")) {
                                TextView btnTransitInfo = new TextView(this);
                                btnTransitInfo.setText("🚚 In Transit to " + hospName);
                                btnTransitInfo.setTextColor(ContextCompat.getColor(this, R.color.status_reserved_text));
                                btnTransitInfo.setTextSize(12f);
                                btnTransitInfo.setTypeface(null, android.graphics.Typeface.BOLD);
                                btnTransitInfo.setGravity(android.view.Gravity.CENTER);
                                btnTransitInfo.setBackgroundResource(R.drawable.bg_chip_status_reserved);
                                LinearLayout.LayoutParams trkLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 76);
                                trkLp.topMargin = 16;
                                btnTransitInfo.setLayoutParams(trkLp);
                                btnTransitInfo.setOnClickListener(v -> {
                                    Toast.makeText(this, "Requisition " + reqId + " is currently in transit to " + hospName + ".", Toast.LENGTH_SHORT).show();
                                });
                                card.addView(btnTransitInfo);
                            } else if (statusUpper.contains("FULFIL") || statusUpper.contains("COMPLET")) {
                                TextView btnFulfilledInfo = new TextView(this);
                                btnFulfilledInfo.setText("✓ Delivered & Fulfilled");
                                btnFulfilledInfo.setTextColor(ContextCompat.getColor(this, R.color.status_available_text));
                                btnFulfilledInfo.setTextSize(12f);
                                btnFulfilledInfo.setTypeface(null, android.graphics.Typeface.BOLD);
                                btnFulfilledInfo.setGravity(android.view.Gravity.CENTER);
                                btnFulfilledInfo.setBackgroundResource(R.drawable.bg_chip_status_available);
                                LinearLayout.LayoutParams fulInfoLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 76);
                                fulInfoLp.topMargin = 16;
                                btnFulfilledInfo.setLayoutParams(fulInfoLp);
                                btnFulfilledInfo.setOnClickListener(v -> {
                                    Toast.makeText(this, "Requisition " + reqId + " has been completed & fulfilled.", Toast.LENGTH_SHORT).show();
                                });
                                card.addView(btnFulfilledInfo);
                            } else if (statusUpper.contains("REJECT")) {
                                TextView btnRejectedInfo = new TextView(this);
                                btnRejectedInfo.setText("✕ Requisition Rejected");
                                btnRejectedInfo.setTextColor(ContextCompat.getColor(this, R.color.status_critical_text));
                                btnRejectedInfo.setTextSize(12f);
                                btnRejectedInfo.setTypeface(null, android.graphics.Typeface.BOLD);
                                btnRejectedInfo.setGravity(android.view.Gravity.CENTER);
                                btnRejectedInfo.setBackgroundResource(R.drawable.bg_chip_status_critical);
                                card.addView(btnFulfilledInfo);
                            } else if (statusUpper.contains("REJECT")) {
                                TextView btnRejectedInfo = new TextView(this);
                                btnRejectedInfo.setText("✕ Requisition Rejected");
                                btnRejectedInfo.setTextColor(ContextCompat.getColor(this, R.color.status_critical_text));
                                btnRejectedInfo.setTextSize(12f);
                                btnRejectedInfo.setTypeface(null, android.graphics.Typeface.BOLD);
                                btnRejectedInfo.setGravity(android.view.Gravity.CENTER);
                                btnRejectedInfo.setBackgroundResource(R.drawable.bg_chip_status_critical);
                                LinearLayout.LayoutParams rejInfoLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 76);
                                rejInfoLp.topMargin = 16;
                                btnRejectedInfo.setLayoutParams(rejInfoLp);
                                card.addView(btnRejectedInfo);
                            }

                            container.addView(card);
                        }
                    });
            } catch (Exception e) {
                if (progress != null) progress.setVisibility(View.GONE);
                if (emptyState != null) emptyState.setVisibility(View.VISIBLE);
            }
        }
    }

    private void performBloodAllocation(String reqId, String hospId, String hospName, String bGroup, int qty, String bankUid, String bankName) {
        FirebaseFirestore db = FirebaseFirestore.getInstance();
        UserProfile curUser = repository.getCurrentUser();
        String defaultBankId = curUser != null && curUser.getBloodBankId() != null ? curUser.getBloodBankId() : bankUid;
        String defaultBankName = curUser != null && curUser.getDisplayName() != null ? curUser.getDisplayName() : bankName;

        String currentBankId = selectedBloodBank != null ? selectedBloodBank.id : defaultBankId;
        String finalBankName = selectedBloodBank != null ? selectedBloodBank.name : defaultBankName;

        if (!isAuthorizedForBloodBank(currentBankId, finalBankName)) {
            Toast.makeText(this, "Permission Denied: You cannot manage stock for " + finalBankName + ".", Toast.LENGTH_LONG).show();
                    String name = doc.getString("name");
                    String docBbId = doc.getString("bloodBankId");
                    if (docId.equalsIgnoreCase(currentBankId) || docId.equalsIgnoreCase(bankUid) || 
                        (userId != null && userId.equalsIgnoreCase(bankUid)) || 
                        (docBbId != null && docBbId.equalsIgnoreCase(currentBankId)) || 
                        (name != null && name.equalsIgnoreCase(finalBankName))) {
                        targetBankDoc = doc;
                        break;
                    }
                }
                if (targetBankDoc == null) {
                    String bLower = finalBankName.toLowerCase(Locale.US);
                    for (DocumentSnapshot doc : bankSnapshots) {
                        String docId = doc.getId().toLowerCase(Locale.US);
                        String name = doc.getString("name") != null ? doc.getString("name").toLowerCase(Locale.US) : "";
                        if ((bLower.contains("msi") && (docId.contains("msi") || name.contains("msi"))) ||
                            (bLower.contains("bombay") && (docId.contains("bombay") || name.contains("bombay"))) ||
                            (bLower.contains("shashwat") && (docId.contains("shashwat") || name.contains("shashwat"))) ||
                            (bLower.contains("civil") && (docId.contains("civil") || name.contains("civil")))) {
                            targetBankDoc = doc;
                            break;
                        }
                    }
                }
            }

            if (targetBankDoc == null) {
                Toast.makeText(this, "Blood bank facility record not found for " + finalBankName + ".", Toast.LENGTH_SHORT).show();
                return;
            }

            DocumentReference bankDocRef = targetBankDoc.getReference();
            DocumentReference reqDocRef = db.collection("bloodRequests").document(reqId);
            String finalDocId = targetBankDoc.getId();

            db.runTransaction(transaction -> {
                DocumentSnapshot currentBankSnap = transaction.get(bankDocRef);
                DocumentSnapshot currentReqSnap = transaction.get(reqDocRef);

                if (!currentReqSnap.exists()) {
                    throw new FirebaseFirestoreException("Requisition not found in system", FirebaseFirestoreException.Code.NOT_FOUND);
                }

                String currentReqStatus = currentReqSnap.getString("status");
                if (currentReqStatus != null && (currentReqStatus.toUpperCase(Locale.US).contains("ALLOCAT") || 
                                                 currentReqStatus.toUpperCase(Locale.US).contains("DISPATCH") || 
                                                 currentReqStatus.toUpperCase(Locale.US).contains("TRANSIT") || 
                                                 currentReqStatus.toUpperCase(Locale.US).contains("FULFIL") || 
                                                 currentReqStatus.toUpperCase(Locale.US).contains("COMPLET"))) {
                    throw new FirebaseFirestoreException("ALREADY_ALLOCATED", FirebaseFirestoreException.Code.ABORTED);
                }

                Map<String, Integer> stockMap = extractStockMapFromDoc(currentBankSnap);
                String canonicalGroup = getCanonicalBloodGroup(bGroup);
                if (canonicalGroup.isEmpty()) canonicalGroup = bGroup;
                int availableUnits = getNumericStock(stockMap, canonicalGroup);

                if (availableUnits < qty) {
                    throw new FirebaseFirestoreException("INSUFFICIENT_STOCK", FirebaseFirestoreException.Code.ABORTED);
                }

                int newStock = availableUnits - qty;
                stockMap.put(canonicalGroup, newStock);

                int totalUnits = 0;
                for (int v : stockMap.values()) totalUnits += v;

                // Update Blood Bank Stock in Firestore
                transaction.update(bankDocRef, "bloodStock", stockMap);
                transaction.update(bankDocRef, "totalUnits", totalUnits);
                transaction.update(bankDocRef, "updatedAt", System.currentTimeMillis());

                // Update Request Status in Firestore
                String timeStr = new SimpleDateFormat("hh:mm a", Locale.US).format(new Date());
                String allocatedComp = currentReqSnap.getString("component") != null ? currentReqSnap.getString("component") : "Whole Blood";
                transaction.update(reqDocRef, "status", "ALLOCATED");
                transaction.update(reqDocRef, "allocatedQuantity", qty);
                transaction.update(reqDocRef, "allocatedBloodGroup", bGroup);
                transaction.update(reqDocRef, "allocatedComponent", allocatedComp);
                transaction.update(reqDocRef, "allocatedAt", timeStr);
                transaction.update(reqDocRef, "allocatedTimestamp", System.currentTimeMillis());
                transaction.update(reqDocRef, "allocatedBy", bankUid);
                transaction.update(reqDocRef, "sourceBloodBankId", currentBankId);
                transaction.update(reqDocRef, "bloodBankId", currentBankId);
                transaction.update(reqDocRef, "bloodBankName", finalBankName);
                transaction.update(reqDocRef, "assignedSource", finalBankName);
                transaction.update(reqDocRef, "escalationStage", 3);
                transaction.update(reqDocRef, "updatedAt", System.currentTimeMillis());

                return new Pair<>(stockMap, newStock);
            }).addOnSuccessListener(result -> {
                Map<String, Integer> updatedStock = result.first;
                int newStock = result.second;
                String timeStr = new SimpleDateFormat("hh:mm a", Locale.US).format(new Date());

                // Update in-memory cache
                String canonicalGroup = getCanonicalBloodGroup(bGroup);
                if (canonicalGroup.isEmpty()) canonicalGroup = bGroup;
                for (SmartMapItem item : smartMapItemList) {
                    if ("BLOOD_BANK".equalsIgnoreCase(item.type) && 
                        (item.id.equalsIgnoreCase(finalDocId) || item.id.equalsIgnoreCase(bankUid) || item.id.equalsIgnoreCase(currentBankId) || (item.name != null && item.name.equalsIgnoreCase(finalBankName)))) {
                        item.stockMap = updatedStock;
                        item.totalUnits = 0;
                        for (int v : updatedStock.values()) item.totalUnits += v;
                        break;
                    }
                }
                if (selectedBloodBank != null && 
                    (selectedBloodBank.id.equalsIgnoreCase(finalDocId) || selectedBloodBank.id.equalsIgnoreCase(bankUid) || selectedBloodBank.id.equalsIgnoreCase(currentBankId) || (selectedBloodBank.name != null && selectedBloodBank.name.equalsIgnoreCase(finalBankName)))) {
                    selectedBloodBank.stockMap = updatedStock;
                    selectedBloodBank.totalUnits = 0;
                    for (int v : updatedStock.values()) selectedBloodBank.totalUnits += v;
                }

                // Notification for Hospital
                String allocNotifId = reqId + "_ALLOCATED";
                Map<String, Object> notif = new HashMap<>();
                notif.put("notificationId", allocNotifId);
                notif.put("recipientBloodBankId", hospId);
                notif.put("hospitalId", hospId);
                notif.put("title", "Blood Units Allocated & Reserved");
                notif.put("message", finalBankName + " has allocated & reserved " + qty + " units of " + bGroup + " for requisition " + reqId + ".");
                notif.put("type", "ALLOCATED");
                notif.put("relatedRequestId", reqId);
                notif.put("relatedBloodGroup", bGroup);
                notif.put("timestamp", timeStr);
                notif.put("createdAt", System.currentTimeMillis());
                notif.put("isRead", false);
                db.collection("notifications").document(allocNotifId).set(notif, com.google.firebase.firestore.SetOptions.merge());

                checkAndTriggerStockAlerts(finalDocId, finalBankName, updatedStock);

                repository.addAuditLog(bankUid, "BLOOD_BANK", "ALLOCATE_STOCK", reqId, timeStr, "VERIFIED", "ALLOCATED", "Allocated " + qty + " units " + bGroup + " from " + finalBankName + " for " + hospName + ". Remaining " + bGroup + " stock: " + newStock + "u");
                Toast.makeText(this, "✓ " + qty + " units of " + bGroup + " allocated for " + reqId + "!\nRemaining stock: " + newStock + " Units", Toast.LENGTH_LONG).show();
            }).addOnFailureListener(err -> {
                String msg = err.getMessage() != null ? err.getMessage() : "";
                if (msg.contains("ALREADY_ALLOCATED")) {
                    Toast.makeText(this, "Requisition is already allocated.", Toast.LENGTH_SHORT).show();
                } else if (msg.contains("INSUFFICIENT_STOCK")) {
                    Toast.makeText(this, "Insufficient " + bGroup + " stock.", Toast.LENGTH_LONG).show();
                } else {
                    Toast.makeText(this, "Allocation failed: " + msg, Toast.LENGTH_SHORT).show();
                }
            });
        }).addOnFailureListener(err -> {
            Toast.makeText(this, "Error accessing blood bank stock: " + err.getMessage(), Toast.LENGTH_SHORT).show();
        });
    }

    private void performBloodDispatch(String reqId, String hospId, String hospName, String bGroup, int qty, String bankUid, String bankName) {
        FirebaseFirestore db = FirebaseFirestore.getInstance();
        DocumentReference reqRef = db.collection("bloodRequests").document(reqId);
        UserProfile curUser = repository.getCurrentUser();
        String defaultBankId = curUser != null && curUser.getBloodBankId() != null ? curUser.getBloodBankId() : bankUid;
        String defaultBankName = curUser != null && curUser.getDisplayName() != null ? curUser.getDisplayName() : bankName;

        String currentBankId = selectedBloodBank != null ? selectedBloodBank.id : defaultBankId;
        String finalBankName = selectedBloodBank != null ? selectedBloodBank.name : defaultBankName;

        if (!isAuthorizedForBloodBank(currentBankId, finalBankName)) {
            Toast.makeText(this, "Permission Denied: You cannot dispatch requisitions for " + finalBankName + ".", Toast.LENGTH_LONG).show();
            return;
        }

        db.runTransaction(transaction -> {
            DocumentSnapshot snap = transaction.get(reqRef);
            if (!snap.exists()) {
                throw new FirebaseFirestoreException("Request not found", FirebaseFirestoreException.Code.NOT_FOUND);
            }
            String curStatus = snap.getString("status");
            if (curStatus != null && (curStatus.toUpperCase(Locale.US).contains("DISPATCH") || 
                                      curStatus.toUpperCase(Locale.US).contains("TRANSIT") || 
                                      curStatus.toUpperCase(Locale.US).contains("FULFIL") || 
                                      curStatus.toUpperCase(Locale.US).contains("COMPLET"))) {
                throw new FirebaseFirestoreException("ALREADY_DISPATCHED", FirebaseFirestoreException.Code.ABORTED);
            }

            String timeStr = new SimpleDateFormat("hh:mm a", Locale.US).format(new Date());
            transaction.update(reqRef, "status", "DISPATCHED");
            transaction.update(reqRef, "dispatchedAt", timeStr);
            transaction.update(reqRef, "dispatchedTimestamp", System.currentTimeMillis());
            transaction.update(reqRef, "dispatchedBy", bankUid);
            transaction.update(reqRef, "sourceBloodBankId", currentBankId);
            transaction.update(reqRef, "bloodBankId", currentBankId);
            transaction.update(reqRef, "bloodBankName", finalBankName);
            transaction.update(reqRef, "assignedSource", finalBankName);
            transaction.update(reqRef, "escalationStage", 4);
            transaction.update(reqRef, "updatedAt", System.currentTimeMillis());
            return timeStr;
        }).addOnSuccessListener(timeStr -> {
            // Notification for Hospital
            Map<String, Object> notif = new HashMap<>();
            notif.put("hospitalId", hospId);
            notif.put("recipientBloodBankId", hospId);
            notif.put("title", "Blood Courier Dispatched");
            notif.put("message", "Your " + bGroup + " (" + qty + " Units) requisition " + reqId + " has been dispatched by " + finalBankName + ".");
            notif.put("type", "DISPATCHED");
            notif.put("relatedRequestId", reqId);
            notif.put("relatedBloodGroup", bGroup);
            notif.put("timestamp", (String) timeStr);
            notif.put("createdAt", System.currentTimeMillis());
            notif.put("isRead", false);
            db.collection("notifications").add(notif);

            repository.addAuditLog(bankUid, "BLOOD_BANK", "DISPATCH_REQUEST", reqId, (String) timeStr, "ALLOCATED", "DISPATCHED", "Dispatched " + qty + " units " + bGroup + " to " + hospName);
            Toast.makeText(this, "✓ Requisition " + reqId + " Dispatched!", Toast.LENGTH_SHORT).show();
        }).addOnFailureListener(err -> {
            String msg = err.getMessage() != null ? err.getMessage() : "";
            if (msg.contains("ALREADY_DISPATCHED")) {
                Toast.makeText(this, "Requisition is already dispatched.", Toast.LENGTH_SHORT).show();
            } else if (msg.contains("ALREADY_FULFILLED")) {
                Toast.makeText(this, "Requisition is already fulfilled.", Toast.LENGTH_SHORT).show();
            } else {
                Toast.makeText(this, "Dispatch failed: " + msg, Toast.LENGTH_SHORT).show();
            }
        });
    }

