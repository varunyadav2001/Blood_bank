                    txtGroup.setText(group);
                    txtGroup.setTextColor(ContextCompat.getColor(this, R.color.primary));
                    txtGroup.setTextSize(20f);
                    txtGroup.setTypeface(null, android.graphics.Typeface.BOLD);

                    TextView txtBadge = new TextView(this);
                    txtBadge.setText("🟡 LOW STOCK");
                    txtBadge.setTextColor(ContextCompat.getColor(this, R.color.status_low_text));
                    txtBadge.setTextSize(11f);
                    txtBadge.setTypeface(null, android.graphics.Typeface.BOLD);
                    txtBadge.setBackgroundResource(R.drawable.bg_chip_status_low);
                    txtBadge.setPadding(20, 8, 20, 8);
