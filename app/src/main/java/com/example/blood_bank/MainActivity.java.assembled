                });
            } catch (Exception e) {
                if (mapNoticeBannerRef != null) mapNoticeBannerRef.setVisibility(View.VISIBLE);
                if (txtNoticeRef != null) txtNoticeRef.setText("SmartBlood locator active. Displaying live stock markers.");
            }
