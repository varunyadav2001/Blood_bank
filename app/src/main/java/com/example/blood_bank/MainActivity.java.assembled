    // Helper method to create, verify, and seed all verified blood bank records into Firestore "bloodBanks" collection
    private void seedAndSyncFirestoreBloodBanks() {
        List<RawBank> rawList = getMasterBloodBankList();

        try {
            FirebaseFirestore db = FirebaseFirestore.getInstance();
            db.collection("bloodBanks").get().addOnSuccessListener(snapshot -> {
                Set<String> existingKeys = new HashSet<>();
                if (snapshot != null && !snapshot.isEmpty()) {
                    for (com.google.firebase.firestore.QueryDocumentSnapshot doc : snapshot) {
                        existingKeys.add(doc.getId().toLowerCase(java.util.Locale.US).trim());
                        String bId = doc.getString("bloodBankId");
                        if (bId != null) existingKeys.add(bId.toLowerCase(java.util.Locale.US).trim());
                        String n = doc.getString("name");
                        if (n != null) existingKeys.add(n.toLowerCase(java.util.Locale.US).trim());
                    }
                }

                for (RawBank b : rawList) {
                    if (!existingKeys.contains(b.id.toLowerCase(java.util.Locale.US).trim()) && 
                        !existingKeys.contains(b.name.toLowerCase(java.util.Locale.US).trim())) {
                        Map<String, Object> data = new HashMap<>();
                        data.put("bloodBankId", b.id);
                        data.put("name", b.name);
                        data.put("city", b.city);
                        data.put("address", b.address);
                        data.put("latitude", b.lat);
                        data.put("longitude", b.lng);
                        data.put("phone", b.phone);
                        data.put("availableBloodGroups", Arrays.asList("O+", "O-", "A+", "A-", "B+", "B-", "AB+", "AB-", "Bombay (Oh)"));
                        
                        Map<String, Integer> stock = defaultStockForBank(b.name);
                        data.put("bloodStock", stock);
                        int total = 0;
                        for (String g : new String[]{"O+", "O-", "A+", "A-", "B+", "B-", "AB+", "AB-", "Bombay (Oh)"}) {
                            total += getNumericStock(stock, g);
                        }
                        data.put("totalUnits", total);
                        data.put("status", "Available");
                        data.put("verified", true);
                        data.put("updatedAt", System.currentTimeMillis());

                        db.collection("bloodBanks").document(b.id).set(data, com.google.firebase.firestore.SetOptions.merge());
                    }
                }
            });
        } catch (Exception ignored) {}
    }

    // STEP 5: Create custom 🩸 blood bank marker icon using Canvas bitmap rendering
    private BitmapDescriptor createBloodBankMarkerIcon(boolean isSelected) {
        int width = 96;
        int height = 96;
        Bitmap bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888);
        Canvas canvas = new Canvas(bitmap);

        Paint bgPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
        bgPaint.setColor(isSelected ? 0xFFFF1744 : 0xFFD50000); // Bright Crimson Red

        // Draw pin background circle
        canvas.drawCircle(width / 2f, height / 2f - 4, 38f, bgPaint);

        // Draw border: Gold if selected, White if normal
        Paint borderPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
        borderPaint.setColor(isSelected ? 0xFFFFD700 : 0xFFFFFFFF);
        borderPaint.setStyle(Paint.Style.STROKE);
        borderPaint.setStrokeWidth(isSelected ? 6f : 4f);
        canvas.drawCircle(width / 2f, height / 2f - 4, 38f, borderPaint);

        // Draw 🩸 emoji text centered inside
        TextPaint textPaint = new TextPaint(Paint.ANTI_ALIAS_FLAG);
        textPaint.setTextSize(40f);
        textPaint.setTextAlign(Paint.Align.CENTER);
        canvas.drawText("🩸", width / 2f, height / 2f + 10, textPaint);

        return BitmapDescriptorFactory.fromBitmap(bitmap);
    }
                int count = 0;
                for (Map.Entry<String, Integer> entry : item.stockMap.entrySet()) {
                    if (count > 0) sb.append(" • ");
                    sb.append(entry.getKey()).append(": ").append(entry.getValue()).append(" units");
                    count++;
                }
                txtBankStock.setText(sb.toString());
            } else {
                txtBankStock.setText("Stock data being updated...");
            }
        }

        // STEP 5: Update selected marker styling across blood bank markers
        for (SmartMapItem itemInList : smartMapItemList) {
            if ("BLOOD_BANK".equalsIgnoreCase(itemInList.type) && itemInList.marker != null) {
                boolean isSelected = itemInList.id.equals(item.id);
                itemInList.marker.setIcon(createBloodBankMarkerIcon(isSelected));
                itemInList.marker.setZIndex(isSelected ? 9f : 5f);
            }
        }

        // STEP 6: Draw accurate road route to EXACT selected blood bank
        drawDeliveryRoute(item, updateCamera);
    }

    private void bindMapView(View view) {
    private String getCanonicalBloodGroup(String raw) {
        if (raw == null) return "";
        String s = raw.toUpperCase(Locale.US).trim();
        if (s.equals("O+") || s.equals("O_POS") || s.equals("OPOS") || s.equals("O_POSITIVE") || s.equals("O POSITIVE") || s.equals("O +") || s.equals("O+ STOCK") || s.equals("O_POS_STOCK")) return "O+";
        if (s.equals("O-") || s.equals("O_NEG") || s.equals("ONEG") || s.equals("O_NEGATIVE") || s.equals("O NEGATIVE") || s.equals("O -") || s.equals("O_NEG_EMERGENCY") || s.equals("O- EMERGENCY") || s.equals("O- STOCK")) return "O-";
        if (s.equals("A+") || s.equals("A_POS") || s.equals("APOS") || s.equals("A_POSITIVE") || s.equals("A POSITIVE") || s.equals("A +") || s.equals("A+ STOCK") || s.equals("A_POS_STOCK")) return "A+";
        if (s.equals("A-") || s.equals("A_NEG") || s.equals("ANEG") || s.equals("A_NEGATIVE") || s.equals("A NEGATIVE") || s.equals("A -") || s.equals("A- STOCK")) return "A-";
        if (s.equals("B+") || s.equals("B_POS") || s.equals("BPOS") || s.equals("B_POSITIVE") || s.equals("B POSITIVE") || s.equals("B +") || s.equals("B+ STOCK") || s.equals("B_POS_STOCK")) return "B+";
        if (s.equals("B-") || s.equals("B_NEG") || s.equals("BNEG") || s.equals("B_NEGATIVE") || s.equals("B NEGATIVE") || s.equals("B -") || s.equals("B- STOCK")) return "B-";
        if (s.equals("AB+") || s.equals("AB_POS") || s.equals("ABPOS") || s.equals("AB_POSITIVE") || s.equals("AB POSITIVE") || s.equals("AB +") || s.equals("AB+ STOCK") || s.equals("AB_POS_STOCK")) return "AB+";
        if (s.equals("AB-") || s.equals("AB_NEG") || s.equals("ABNEG") || s.equals("AB_NEGATIVE") || s.equals("AB NEGATIVE") || s.equals("AB -") || s.equals("AB- STOCK")) return "AB-";
        if (s.contains("BOMBAY") || s.equals("OH") || s.equals("HH") || s.equals("BOMBAY (OH)") || s.equals("BOMBAY BLOOD")) return "Bombay";
        return s;
    }

    private int getNumericStock(Map<String, Integer> stockMap, String bloodGroup) {
        if (stockMap == null || bloodGroup == null) return 0;

        // 1. Direct canonical lookup
        String canonical = getCanonicalBloodGroup(bloodGroup);
        Integer val = stockMap.get(canonical);
        if (val != null && val > 0) return val;

        // 2. Direct lookup with raw key
        val = stockMap.get(bloodGroup);
        if (val != null && val > 0) return val;

        // 3. Uppercase lookup
        val = stockMap.get(bloodGroup.toUpperCase(Locale.US).trim());
        if (val != null && val > 0) return val;

        // 4. Clean key lookup
        String clean = bloodGroup.toUpperCase(Locale.US).replace(" ", "").replace("_", "").replace("-", "");
        val = stockMap.get(clean);
        }

        View btnNavigate = view.findViewById(R.id.btn_map_navigate);
        View btnCallBank = view.findViewById(R.id.btn_map_call_bank);
        View btnReserveStock = view.findViewById(R.id.btn_map_reserve_stock);
        View btnMyLocation = view.findViewById(R.id.btn_map_my_location);
        View btnFindNearest = view.findViewById(R.id.btn_map_find_nearest);
        View btnEmergencyReq = view.findViewById(R.id.btn_map_emergency);
        View btnLayersToggle = view.findViewById(R.id.btn_map_layers_toggle);

        // Radius Chips
        TextView chipRad5 = view.findViewById(R.id.chip_radius_5km);
        TextView chipRad1 = view.findViewById(R.id.chip_radius_1km);
        TextView chipRad10 = view.findViewById(R.id.chip_radius_10km);
        TextView chipRad15 = view.findViewById(R.id.chip_radius_15km);
        TextView chipRad20 = view.findViewById(R.id.chip_radius_20km);
        TextView chipRad30 = view.findViewById(R.id.chip_radius_30km);
        TextView chipRad50 = view.findViewById(R.id.chip_radius_50km);

        // Blood Group Chips
        TextView chipGrpAll = view.findViewById(R.id.chip_group_all);
        TextView chipGrpOPos = view.findViewById(R.id.chip_group_o_pos);
        TextView chipGrpONeg = view.findViewById(R.id.chip_group_o_neg);
        TextView chipGrpAPos = view.findViewById(R.id.chip_group_a_pos);
        TextView chipGrpBPos = view.findViewById(R.id.chip_group_b_pos);
        TextView chipGrpABPos = view.findViewById(R.id.chip_group_ab_pos);

        if (fusedLocationClient == null) {
            fusedLocationClient = LocationServices.getFusedLocationProviderClient(this);
        }

        if (btnAllowPermRef != null) {
            btnAllowPermRef.setOnClickListener(v -> requestLocationPermission());
        }

        if (mapView != null) {
            try {
                mapView.onCreate(null);
                mapView.onResume();
                mapView.getMapAsync(googleMap -> {
                    activeGoogleMap = googleMap;
                    googleMap.getUiSettings().setZoomControlsEnabled(true);
                    googleMap.getUiSettings().setCompassEnabled(true);

                    // Add Hospital / Current User Location Marker
                    UserProfile currentUser = repository.getCurrentUser();
                    String hospName = (currentUser != null && currentUser.getDisplayName() != null) ? currentUser.getDisplayName() : "My Hospital";
                    String hospAddr = (currentUser != null && currentUser.getLocationAddress() != null) ? currentUser.getLocationAddress() : "Hospital Location";

                    LatLng userPos = new LatLng(userLat, userLng);
                    userLocationMarker = googleMap.addMarker(new MarkerOptions()
                            .position(userPos)
                            .title("📍 MY HOSPITAL - " + hospName)
                            .snippet("📍 " + hospAddr + " • Official Registered Hospital")
                            .zIndex(10f)
                            .icon(BitmapDescriptorFactory.defaultMarker(BitmapDescriptorFactory.HUE_RED)));

                    // Center camera around hospital saved location with zoom 15.0f
                    googleMap.moveCamera(CameraUpdateFactory.newLatLngZoom(userPos, 15.0f));

                    // STEP 5: Add markers for Hospitals and 🩸 Blood Banks dynamically
                    for (SmartMapItem item : smartMapItemList) {
                        boolean isHosp = "HOSPITAL".equalsIgnoreCase(item.type);
                        BitmapDescriptor icon = isHosp ? BitmapDescriptorFactory.defaultMarker(BitmapDescriptorFactory.HUE_CYAN)
