        RelativeLayout.LayoutParams closeLp = new RelativeLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        closeLp.addRule(RelativeLayout.ALIGN_PARENT_END);
